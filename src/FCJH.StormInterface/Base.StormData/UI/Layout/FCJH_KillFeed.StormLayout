<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Kill feed, top-right (layout.toml element.kill_feed).

	     Blizzard's KillLogPanel (gameui.stormlayout) holds the kill rows; the engine adds
	     them, each 600 units wide and anchored to the panel's top-left, sliding down as new
	     ones arrive. A row draws its portraits at the LEFT of those 600 units (killer from 27,
	     victim ending at 210, each further victim to the right: a pentakill's fifth ends at
	     356), so we place the panel's left edge 356 short of kill_feed's right: a pentakill's
	     portraits end on that edge, inside the screen's padding (tools/gen.py KILL_ROW_FIVE).
	     Rows still read killer -> victim, left to right. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="ConsolePanel" name="ConsolePanel">
				<Frame type="Frame" name="KillLogPanel">
					<Anchor side="Top"    relative="$GameUI" pos="Min" offset="#FCJH_KILL_FEED_T"/>
					<Anchor side="Left"   relative="$GameUI" pos="Min" offset="#FCJH_KILL_FEED_ROW_L"/>
					<Anchor side="Right"  relative="$this"   pos="Min" offset="0"/>
					<!-- Blizzard's own bottom (the screen's): rows stack downward past the box -->
					<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
					<Unclipped val="true"/>
				</Frame>
			</Frame>
		</Frame>
	</Frame>
</Desc>
