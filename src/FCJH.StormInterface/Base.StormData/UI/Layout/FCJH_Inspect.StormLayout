				<Frame type="Image" name="FCJH_DiagAlly">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="51"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="14"/>
					<Height val="14"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="255,80,240,240"/>
					<RenderPriority val="700"/>
					<Alpha val="40"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_DiagEnemy">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="69"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="14"/>
					<Height val="14"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="255,255,160,40"/>
					<RenderPriority val="700"/>
					<Alpha val="40"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_DiagOwner">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="87"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="14"/>
					<Height val="14"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="255,255,255,255"/>
					<RenderPriority val="700"/>
					<Alpha val="40"/>
					<AcceptsMouse val="false"/>
				</Frame>

				<!-- 2. name (in the title band, user 2026-10-05), player, level -->
				<Frame type="UnitStatusName" name="FCJH_HeroName" template="UnitStatus/UnitStatusUnitNameTemplate">
					<!-- centred on the card: the template's own size (220 x 30) beat the
					     anchors and held it off centre (2026-10-05), so the size is given -->
					<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="30"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="273"/>
					<Height val="30"/>
					<UseNameTypeVisibilityRules val="false"/>
					<Frame type="Label" name="Label"><Anchor relative="$parent"/><Style val="FCJH_InspectName"/></Frame>
				</Frame>
				<!-- the player's name comes with the player pack (Blizzard's player-name widget read
				     "Player 5" for every hero in round 4) -->
				<Frame type="UnitStatusLevel" name="FCJH_Level" template="UnitStatus/UnitStatusLevelTemplate">
					<!-- its right edge on the margin, as the player's name's left (the template's 25 x 20 beat
					     the anchors before and left it short of the edge, 2026-10-05) -->
					<Anchor side="Top"    relative="$parent" pos="Min" offset="157"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="258"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="60"/>
					<Height val="30"/>
					<!-- no truncation: "13" read "..." in round 7 -->
					<Frame type="Label" name="Label"><Anchor relative="$parent"/><Style val="FCJH_InspectLevel"/><Options val="NoWrapping | ScaleToPreventTruncation"/></Frame>
				</Frame>

				<!-- 3. fountain: the first buff, in Blizzard's own buff slot art (user, 2026-10-05): Blizzard's
				     "ready" art, dimmed while on cooldown, with the seconds left over it -->
				<!-- the plates' sensor, on the slot: Blizzard's fountain behaviour icon, present only while
				     the fountain is on cooldown. Its own pictures are off; it lends the slot its countdown
				     (the game fills a CooldownLabel in a behaviour icon, as in Blizzard's hero console) -->
				<Frame type="UnitStatusBehaviorIcon" name="FCJH_FountainSensor">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="247"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="15"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="58"/>
					<Height val="34"/>
					<Behavior val="HealingFountainCooldown"/>
					<RenderPriority val="680"/>
					<AcceptsMouse val="false"/>
					<!-- its tooltip, Blizzard's own, while the fountain cools down (off while the sensor
					     covered the whole card) -->
					<Frame type="BehaviorIcon" name="BehaviorIcon" template="BehaviorBar/BehaviorIconTemplate">
						<Anchor relative="$parent"/>
						<AcceptsMouse val="false"/>
						<Frame type="Frame" name="ImageMaskContainer"><Visible val="false"/><Alpha val="0"/></Frame>
						<Frame type="Image" name="IconImageBg"><Visible val="false"/><Alpha val="0"/></Frame>
						<Frame type="Label" name="StackLabel"><Visible val="false"/><Alpha val="0"/></Frame>
						<Frame type="ProgressBar" name="QuestProgressBar"><Visible val="false"/><Alpha val="0"/></Frame>
						<Frame type="ProgressBar" name="CooldownBar"><Visible val="false"/><Alpha val="0"/></Frame>
						<Frame type="Image" name="BGFlashImage"><Visible val="false"/><Alpha val="0"/></Frame>
						<Frame type="Label" name="CooldownLabel">
							<Anchor side="Top"    relative="$parent" pos="Min" offset="2"/>
							<Anchor side="Left"   relative="$parent" pos="Min" offset="9"/>
							<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
							<Anchor side="Right"  relative="$parent" pos="Max" offset="-6"/>
							<Style val="FCJH_HeroicCooldown"/>
							<Options val="NoWrapping | ScaleToPreventTruncation"/>
							<RenderPriority val="700"/>
						</Frame>
					</Frame>
				</Frame>
				<Frame type="Frame" name="FCJH_FountainReady">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="247"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="15"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="58"/>
					<Height val="34"/>
					<RenderPriority val="670"/>
					<AcceptsMouse val="false"/>
					<!-- ready: Blizzard's hero console tooltip for it -->
					<Tooltip val="@UI/HealingFountainDescription"/>
					<TooltipAnchorPosition val="TopRight"/>
					<!-- BehaviorIconTemplate's pieces: the icon in the slanted buff mask, then the slot's frame -->
					<Frame type="Frame" name="ImageMaskContainer">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="-2"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="9"/>
						<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
						<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
						<Width val="40"/>
						<Height val="40"/>
						<AlphaMaskTexture val="@UI/Storm_UI_InGame_Buff_IconMask"/>
						<Frame type="Image" name="IconImage">
							<Anchor side="Top"    relative="$parent" pos="Mid" offset="0"/>
							<Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
							<Anchor side="Left"   relative="$parent" pos="Mid" offset="0"/>
							<Anchor side="Right"  relative="$parent" pos="Mid" offset="0"/>
							<Width val="45"/>
							<Height val="45"/>
							<Texture val="@UI/Storm_UI_Ingame_HealingWell_Active"/>
							<!-- the middle of the art only: its own frame's edges drew as stray lines in the slanted
							     mask (user, 2026-10-05) -->
							<TextureCoords top="0.2" left="0.2" bottom="0.8" right="0.8"/>
							<RenderPriority val="671"/>
							<AcceptsMouse val="false"/>
						</Frame>
					</Frame>
					<Frame type="Image" name="IconImageBg">
						<Anchor relative="$parent"/>
						<Texture val="@UI/Storm_UI_InGame_Buff_Background"/>
						<RenderPriority val="672"/>
						<AcceptsMouse val="false"/>
					</Frame>
					<StateGroup name="FCJH_Fountain">
						<DefaultState val="Ready"/>
						<State name="Cooldown">
							<When type="Property" frame="$parent/FCJH_FountainSensor" Visible="true"/>
							<Action type="SetProperty" frame="$this" Alpha="60"/>
							<Action type="SetProperty" frame="$this" AcceptsMouseTooltip="false"/>
						</State>
						<State name="Ready">
							<Action type="SetProperty" frame="$this" Alpha="255"/>
							<Action type="SetProperty" frame="$this" AcceptsMouseTooltip="true"/>
						</State>
					</StateGroup>
				</Frame>

				<!-- 4. buffs then debuffs, one row after the fountain: Blizzard's buff bars inside the
				     selection panel (as Spazzo does). One row is all a hero needs (user, 2026-10-05) -->
				<Frame type="BehaviorBar" name="FCJH_Buffs" template="BehaviorBar/BuffBehaviorBarTemplate">
					<Anchor side="Top"  relative="$parent" pos="Min" offset="247"/>
					<Anchor side="Left" relative="$parent/FCJH_FountainReady" pos="Max" offset="-19"/>
					<RenderPriority val="670"/>
				</Frame>
				<Frame type="BehaviorBar" name="FCJH_Debuffs" template="BehaviorBar/DebuffBehaviorBarTemplate">
					<Anchor side="Top"  relative="$parent/FCJH_Buffs" pos="Min" offset="0"/>
					<Anchor side="Left" relative="$parent/FCJH_Buffs" pos="Max" offset="0"/>
					<RenderPriority val="670"/>
				</Frame>

				<!-- 5. talents (round 5). Blizzard's talent strip is keyed to a PLAYER and a selection
				     only gives a unit: rounds 3-4 drew blank, then team-coloured, squares. So the card
				     carries all ten of the talent pane's rows (PlayerFrame0-9, the same source the talent
				     pop-ups read), and shows the one whose plate holds the selected hero - see
				     FCJH_IsPlayerN below. Each pack also brings that player's name. -->
