					<StateGroup name="FCJH_AbilRPresent">
						<DefaultState val="Yes"/>
						<State name="NoIcon"><When type="Property" frame="$parent/FCJH_AbilR" Visible="false"/><Action type="SetProperty" frame="$this" Alpha="0"/></State>
						<State name="NoAbil"><When type="Property" frame="$parent/FCJH_AbilR/AbilIcon" Visible="false"/><Action type="SetProperty" frame="$this" Alpha="0"/></State>
						<State name="Yes"><Action type="SetProperty" frame="$this" Alpha="255"/></State>
					</StateGroup>
					</Frame>
					<Frame type="UnitStatusAbilIcon" name="FCJH_AbilZ">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="425"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="229"/>
						<Anchor side="Bottom" relative="$parent" pos="Min" offset="461"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="265"/>
						<Unclipped val="true"/>
						<AbilityLink val="Mount"/>
						<Frame type="AbilIcon" name="AbilIcon">
							<Anchor relative="$parent"/>
							<Frame type="Image" name="IconImage"><Anchor relative="$parent"/><Unclipped val="true"/></Frame>
							<Frame type="Label" name="CooldownLabel">
								<Anchor relative="$parent"/>
								<Style val="FCJH_HeroicCooldown"/>
								<RenderPriority val="700"/>
								<Animation name="FCJH_Dim">
									<Event event="OnShown" action="DirectionForward,Play"/>
									<Event event="OnHidden" action="DirectionReverse,Play"/>
									<Controller type="Color" end="Pause" frame="$parent/IconImage">
										<Key type="Curve" time="0" value="255,255,255" inout="Step"/>
										<Key type="Curve" time="0.01" value="70,70,70" inout="Step"/>
									</Controller>
								</Animation>
							</Frame>
							<Frame type="ProgressBar" name="CooldownBar"><Anchor relative="$parent"/><Alpha val="0"/></Frame>
						</Frame>
					</Frame>
					<Frame type="Label" name="FCJH_AbilZKey">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="447"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="231"/>
						<Anchor side="Bottom" relative="$parent" pos="Min" offset="461"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="245"/>
						<Style val="FCJH_InspectKey"/>
						<Text val="Z"/>
						<Options val="NoWrapping | ScaleToPreventTruncation"/>
						<AcceptsMouse val="false"/>
					<StateGroup name="FCJH_AbilZPresent">
						<DefaultState val="Yes"/>
						<State name="NoIcon"><When type="Property" frame="$parent/FCJH_AbilZ" Visible="false"/><Action type="SetProperty" frame="$this" Alpha="0"/></State>
						<State name="NoAbil"><When type="Property" frame="$parent/FCJH_AbilZ/AbilIcon" Visible="false"/><Action type="SetProperty" frame="$this" Alpha="0"/></State>
						<State name="Yes"><Action type="SetProperty" frame="$this" Alpha="255"/></State>
					</StateGroup>
					</Frame>
				<StateGroup name="FCJH_Abilities">
					<DefaultState val="Other"/>
						<State name="HeroBarbarian">
							<When type="Property" Unit="HeroBarbarian"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilD" AbilityLink="BarbarianShotofFury"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilQ" AbilityLink="BarbarianAncientSpear"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilW" AbilityLink="BarbarianSeismicSlam"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilE" AbilityLink="BarbarianWhirlwind"/>
						</State>
						<State name="HeroCrusader">
							<When type="Property" Unit="HeroCrusader"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilD" AbilityLink="CrusaderIronSkin"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilQ" AbilityLink="CrusaderPunish"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilW" AbilityLink="CrusaderCondemn"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilE" AbilityLink="CrusaderShieldGlare"/>
						</State>
						<State name="HeroAuriel">
							<When type="Property" Unit="HeroAuriel"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilD" AbilityLink="AurielBestowHope"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilQ" AbilityLink="AurielSacredSweep"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilW" AbilityLink="AurielRayOfHeaven"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilE" AbilityLink="AurielDetainmentStrike"/>
						</State>
					<State name="Other"/>
				</StateGroup>
			</Frame>
		</Frame>
	</Frame>
</Desc>
