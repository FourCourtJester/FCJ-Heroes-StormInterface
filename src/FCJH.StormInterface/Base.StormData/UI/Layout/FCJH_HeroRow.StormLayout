					<Frame type="UnitStatusFrame" name="TrackedUnitStatusFrame1">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="78"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="121"/>
						<Unclipped val="true"/>
						<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
							<Anchor side="Top"    relative="$parent/$parent/$parent" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$parent/$parent/$parent" pos="Max" offset="0"/>
							<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
							<Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm"/>
							<Tiled val="true"/>
							<Unclipped val="true"/>
						</Frame>
						<Frame type="UnitTargetFrame" name="FCJH_Target">
							<Anchor relative="$parent"/>
							<AllowTargeting val="false"/>
							<AllowSelection val="true"/>
							<AllowCameraCentering val="true"/>
							<AllowSmartCommand val="false"/>
							<Unclipped val="true"/>
							<RenderPriority val="610"/>
						</Frame>
					</Frame>
					<Frame type="UnitStatusFrame" name="TrackedUnitStatusFrame2">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="123"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="166"/>
						<Unclipped val="true"/>
						<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
							<Anchor side="Top"    relative="$parent/$parent/$parent" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$parent/$parent/$parent" pos="Max" offset="0"/>
							<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
							<Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm"/>
