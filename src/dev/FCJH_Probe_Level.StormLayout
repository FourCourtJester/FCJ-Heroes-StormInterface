<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): the talent-tier lead, rebuilt from the observer's level labels.

	     Round 1 showed StateGroups read label text but compare it as TEXT ("10" < "9").
	     So: stage 1 maps each team's level text to a one-digit TIER (1-3 -> 0, 4-6 -> 1,
	     7-9 -> 2, 10-12 -> 3, 13-15 -> 4, 16-19 -> 5, 20+ -> 6) and writes it into a label;
	     stage 2 compares the tier digits, where text order and number order agree:
	     blue leads iff for some k, blue tier >= k and red tier < k.
	     On screen, info-pane area: "BLUE TIER / RED TIER" readouts (should follow the
	     levels), and exactly one of BLUE LEADS / RED LEADS / EVEN. -->

	<Frame type="Frame" name="FCJH_ProbeMarker">
		<Frame type="Image" name="Fill">
			<Anchor relative="$parent"/>
			<Texture val="@UI/PauseScreenDimImage"/>
			<ColorAdjustMode val="Fill"/>
			<AdjustmentColor val="200,255,0,255"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Frame type="Label" name="Text">
			<Anchor side="Top"   relative="$parent" pos="Min" offset="12"/>
			<Anchor side="Left"  relative="$parent" pos="Min" offset="12"/>
			<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
			<Style val="WaitingForPlayersDialogChat"/>
			<Options val="ScaleToPreventTruncation"/>
			<AcceptsMouse val="false"/>
		</Frame>
	</Frame>

	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="FCJH_ProbeLevel">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
			<Anchor side="Right"  relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
			<AcceptsMouse val="false"/>
			<Frame type="Label" name="BlueTierCaption">
				<Anchor side="Top"  relative="$parent" pos="Min" offset="10"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
				<Style val="WaitingForPlayersDialogChat"/>
				<Text val="BLUE TIER:"/>
				<Options val="NoWrapping"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="BlueTier">
				<Anchor side="Top"  relative="$parent" pos="Min" offset="10"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="220"/>
				<Style val="WaitingForPlayersDialogChat"/>
				<Text val="?"/>
				<Options val="NoWrapping"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="RedTierCaption">
				<Anchor side="Top"  relative="$parent" pos="Min" offset="60"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
				<Style val="WaitingForPlayersDialogChat"/>
				<Text val="RED TIER:"/>
				<Options val="NoWrapping"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="RedTier">
				<Anchor side="Top"  relative="$parent" pos="Min" offset="60"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="220"/>
				<Style val="WaitingForPlayersDialogChat"/>
				<Text val="?"/>
				<Options val="NoWrapping"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Frame" name="BlueLeads" template="FCJH_Probe_Level/FCJH_ProbeMarker">
				<Anchor side="Top"   relative="$parent" pos="Min" offset="130"/>
				<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
				<Height val="150"/>
				<Visible val="false"/>
				<Frame type="Label" name="Text"><Text val="BLUE LEADS (flame on blue)"/></Frame>
			</Frame>
			<Frame type="Frame" name="RedLeads" template="FCJH_Probe_Level/FCJH_ProbeMarker">
				<Anchor side="Top"   relative="$parent" pos="Min" offset="130"/>
				<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
				<Height val="150"/>
				<Visible val="false"/>
				<Frame type="Label" name="Text"><Text val="RED LEADS (flame on red)"/></Frame>
			</Frame>
			<Frame type="Frame" name="Even" template="FCJH_Probe_Level/FCJH_ProbeMarker">
				<Anchor side="Top"   relative="$parent" pos="Min" offset="130"/>
				<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
				<Height val="150"/>
				<Visible val="false"/>
				<Frame type="Label" name="Text"><Text val="EVEN (no flame)"/></Frame>
			</Frame>
			<StateGroup name="BlueTierMap">
				<DefaultState val="L1"/>
				<State name="L1">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="1"/>
					<Action type="SetProperty" frame="BlueTier" Text="0"/>
				</State>
				<State name="L2">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="2"/>
					<Action type="SetProperty" frame="BlueTier" Text="0"/>
				</State>
				<State name="L3">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="3"/>
					<Action type="SetProperty" frame="BlueTier" Text="0"/>
				</State>
				<State name="L4">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="4"/>
					<Action type="SetProperty" frame="BlueTier" Text="1"/>
				</State>
				<State name="L5">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="5"/>
					<Action type="SetProperty" frame="BlueTier" Text="1"/>
				</State>
				<State name="L6">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="6"/>
					<Action type="SetProperty" frame="BlueTier" Text="1"/>
				</State>
				<State name="L7">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="7"/>
					<Action type="SetProperty" frame="BlueTier" Text="2"/>
				</State>
				<State name="L8">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="8"/>
					<Action type="SetProperty" frame="BlueTier" Text="2"/>
				</State>
				<State name="L9">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="9"/>
					<Action type="SetProperty" frame="BlueTier" Text="2"/>
				</State>
				<State name="L10">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="10"/>
					<Action type="SetProperty" frame="BlueTier" Text="3"/>
				</State>
				<State name="L11">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="11"/>
