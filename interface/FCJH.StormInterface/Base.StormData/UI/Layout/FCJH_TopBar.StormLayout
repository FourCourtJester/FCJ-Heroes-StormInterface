<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Top bar, first pass: strip Blizzard's observer top bar down to what we keep, and move
	     the per-team pieces that now belong with the hero rows at the bottom.

	     Blizzard's backplate is ONE image (TopBarBacking, @UI/obs_bar_middle_bg: the wings,
	     level plates and the towers/kills tray under the clock). The hexagon is a separate
	     overlay on top of it (TopBarLogoOverlay, @UI/obs_bar_middle_logo). So:
	       - backplate hidden with Alpha 0, NOT parked: the level labels, XP bars, core frames,
	         and both hero containers all anchor to it - parking it drags them off-screen
	       - hexagon and clock left as they are, now floating on their own
	       - team levels moved up to the top edge (blue_level, red_level) on our backplate
	         (FCJH_TopBackplate, one texture: chrome-rimmed wings with the team colours
	         strongest at their outer ends, and a plate round the hexagon - layout.toml
	         [top_backplate]); the division and game tabs' places are under them, drawn by OBS
	         and nothing without it (layout.toml [top_bar])
	       - towers / kills counters parked (the icons beside them were backplate art)
	       - team XP: Blizzard's own bars and art, in the bottom of the wings under the levels
	         (blue_wing_xp, red_wing_xp; 2026-11-11), gold while a team is a talent tier ahead
	       - core health on each hero row's top edge at its inner end (blue_core, red_core:
	         placed by tools/gen.py from [team_core]; the rows' XP strip went 2026-11-12). Cut to
	         the plates' slant: our parallelogram texture for the track; the fill is plain
	         colour cut by a mask (FCJH_CoreMask), because the engine stretches a fill to its
	         value and a slanted fill texture squashes as the bar drains (FCJH_CORE_*).
	         Blizzard's frame art around it is hidden. The core bar keeps Blizzard's size and
	         its show-when-needed logic. -->
	<!-- Alterac Pass's keep shield on our core bars (Team1/2CoreUnitStatus below): Blizzard's
	     BossHealthBarShieldTemplate (alteracmechanics.stormlayout), its art, centred on the
	     bar's height, a little smaller ([team_core] av_shield); the inside takes the core's team colour as Blizzard's. Hidden until
	     FCJH_AVKeeps shows it. -->
	<Frame type="Frame" name="FCJH_AVShieldTemplate">
		<Anchor side="Top" relative="$parent/HealthBar" pos="Mid" offset="0"/>
		<Anchor side="Bottom" relative="$parent/HealthBar" pos="Mid" offset="0"/>
		<Width val="#FCJH_AV_SHIELD"/>
		<Height val="#FCJH_AV_SHIELD"/>
		<Unclipped val="true"/>
		<RenderPriority val="600"/>  <!-- over the bar's chrome (520) -->
		<AcceptsMouse val="false"/>
		<Visible val="false"/>
		<Frame type="Image" name="ShieldBG">
			<Anchor relative="$parent"/>
			<Texture val="@UI/Storm_UI_HUD_WCAV_HealthBarShield"/>
			<SubpixelRendering val="true"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Frame type="Image" name="ShieldInside">
			<Anchor side="Top" relative="$parent/ShieldBG" pos="Mid" offset="0"/>
			<Anchor side="Bottom" relative="$parent/ShieldBG" pos="Mid" offset="0"/>
			<Anchor side="Left" relative="$parent/ShieldBG" pos="Mid" offset="0"/>
			<Anchor side="Right" relative="$parent/ShieldBG" pos="Mid" offset="0"/>
			<Width val="#FCJH_AV_SHIELD_INSIDE"/>
			<Height val="#FCJH_AV_SHIELD_INSIDE"/>
			<Texture val="@UI/Storm_UI_HUD_WCAV_HealthBarShieldInside"/>
			<SubpixelRendering val="true"/>
			<ColorAdjustMode val="Colorize"/>
			<LightAdjustColor val="{$parent/$parent/FCJH_TeamColourLight/@Color}"/>
			<DarkAdjustColor val="{$parent/$parent/FCJH_TeamColour/@Color}"/>
			<AcceptsMouse val="false"/>
		</Frame>
	</Frame>
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverHeroOverviewPanel">
					<Frame type="Frame" name="ObserverTopPanel">
						<Frame type="Image" name="TopBarBacking"><Alpha val="0"/></Frame>

						<!-- Team levels: on the top edge, on our backplate. The texture is drawn 1:1 at
						     1080p and centred on Blizzard's hexagon, which sits on top of it (600). -->
						<Frame type="Image" name="FCJH_TopBackplate">
							<Anchor side="Top" relative="$GameUI" pos="Min" offset="#FCJH_TOP_BACKPLATE_T"/>
							<Anchor side="Left" relative="$GameUI" pos="Mid" offset="#FCJH_TOP_BACKPLATE_L"/>
							<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="#FCJH_TOP_BACKPLATE_B"/>
							<Anchor side="Right" relative="$GameUI" pos="Mid" offset="#FCJH_TOP_BACKPLATE_R"/>
							<Texture val="#FCJH_TOP_BACKPLATE"/>
							<RenderPriority val="490"/>
							<Unclipped val="true"/>
							<AcceptsMouse val="false"/>
							<StateGroup name="FCJH_ColourBlind">  <!-- the game's colour-blind option: layout.toml [colour_blind] -->
								<DefaultState val="Off"/>
								<State name="On">
									<When type="Option" colorblind="True"/>
									<Action type="SetProperty" Texture="#FCJH_TOP_BACKPLATE_CB"/>
								</State>
								<State name="Off">
									<Action type="SetProperty" Texture="#FCJH_TOP_BACKPLATE"/>
								</State>
							</StateGroup>
						</Frame>
						<!-- ...and its chrome rim, a layer of its own over what sits in the wings (the XP
						     bars run on under it, so it hides their edges; user, 2026-11-12). Under the
						     level digits (500) and Blizzard's hexagon (600). Neutral, so no colour-blind swap. -->
						<Frame type="Image" name="FCJH_TopRim">
							<Anchor side="Top" relative="$parent/FCJH_TopBackplate" pos="Min" offset="0"/>
							<Anchor side="Left" relative="$parent/FCJH_TopBackplate" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$parent/FCJH_TopBackplate" pos="Max" offset="0"/>
							<Anchor side="Right" relative="$parent/FCJH_TopBackplate" pos="Max" offset="0"/>
							<Texture val="#FCJH_TOP_RIM"/>
							<RenderPriority val="498"/>
							<Unclipped val="true"/>
							<AcceptsMouse val="false"/>
						</Frame>
						<!-- The talent-advantage flame (2026-09-29). The observer bar never
						     had one; Blizzard's player top bar does (PartyFrame TeamLevelInfo), and the
						     engine shows it there while a team is a talent tier ahead. That party frame
						     exists (hidden) for observers too, so ours copies its flame and shows it
						     (by Alpha, like the fountain marker) whenever theirs is showing. -->
						<Frame type="Frame" name="FCJH_BlueAdvantage" template="PartyFrame/TeamLevelInfoTemplate/TeamTalentAdvantageFrame">
							<Anchor side="Bottom" relative="$parent/Team1LevelLabel" pos="Max" offset="0"/>
							<Anchor side="Left"   relative="$parent/Team1LevelLabel" pos="Mid" offset="-2"/>
							<Anchor side="Right"  relative="$parent/Team1LevelLabel" pos="Mid" offset="-2"/>
							<Visible val="true"/>
							<Alpha val="0"/>
							<RenderPriority val="495"/>
							<AcceptsMouse val="false"/>
							<StateGroup name="FCJH_Ahead">
								<DefaultState val="No"/>
								<State name="Yes">
									<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1LevelInfo/TeamTalentAdvantageFrame" Visible="true"/>
									<Action type="SetProperty" frame="$this" Alpha="255"/>
									<Action type="SendEvent" frame="$this" event="SetBlue"/>
									<!-- and the wing's XP bar goes gold (Blizzard's golds, layout.toml [wing_xp]) -->
									<Action type="SetProperty" frame="$parent/Team1XPUnitStatusFrame/XPBar" ColorAdjustMode="Colorize"/>
									<Action type="SetProperty" frame="$parent/Team1XPUnitStatusFrame/XPBar" LightAdjustColor="#FCJH_WING_XP_LEAD_LIGHT"/>
									<Action type="SetProperty" frame="$parent/Team1XPUnitStatusFrame/XPBar" DarkAdjustColor="#FCJH_WING_XP_LEAD_DARK"/>
									<Action type="SendEvent" frame="$parent/Team1XPUnitStatusFrame/XPBar" event="FCJH_ShimmerOn"/>  <!-- and it glints (FCJH_Shimmer) -->
								</State>
								<State name="No">
									<Action type="SetProperty" frame="$this" Alpha="0"/>
									<Action type="SetProperty" frame="$parent/Team1XPUnitStatusFrame/XPBar" ColorAdjustMode="None"/>
									<Action type="SendEvent" frame="$parent/Team1XPUnitStatusFrame/XPBar" event="FCJH_ShimmerOff"/>
								</State>
							</StateGroup>
						</Frame>
						<Frame type="Label" name="Team1LevelLabel">
							<RenderPriority val="500"/>
							<Anchor side="Top" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_LEVEL_T"/>
							<Anchor side="Left" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_LEVEL_L"/>
							<Anchor side="Bottom" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_LEVEL_B"/>
							<Anchor side="Right" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_LEVEL_R"/>
							<Width val="0"/>
							<Unclipped val="true"/>
						</Frame>
						<!-- The talent-advantage flame (2026-09-29). The observer bar never
						     had one; Blizzard's player top bar does (PartyFrame TeamLevelInfo), and the
						     engine shows it there while a team is a talent tier ahead. That party frame
						     exists (hidden) for observers too, so ours copies its flame and shows it
						     (by Alpha, like the fountain marker) whenever theirs is showing. -->
						<Frame type="Frame" name="FCJH_RedAdvantage" template="PartyFrame/TeamLevelInfoTemplate_R/TeamTalentAdvantageFrame">
							<Anchor side="Bottom" relative="$parent/Team2LevelLabel" pos="Max" offset="0"/>
							<Anchor side="Left"   relative="$parent/Team2LevelLabel" pos="Mid" offset="-2"/>
							<Anchor side="Right"  relative="$parent/Team2LevelLabel" pos="Mid" offset="-2"/>
							<Visible val="true"/>
							<Alpha val="0"/>
							<RenderPriority val="495"/>
							<AcceptsMouse val="false"/>
							<StateGroup name="FCJH_Ahead">
								<DefaultState val="No"/>
								<State name="Yes">
									<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2LevelInfo/TeamTalentAdvantageFrame" Visible="true"/>
									<Action type="SetProperty" frame="$this" Alpha="255"/>
									<Action type="SendEvent" frame="$this" event="SetRed"/>
									<!-- and the wing's XP bar goes gold (Blizzard's golds, layout.toml [wing_xp]) -->
									<Action type="SetProperty" frame="$parent/Team2XPUnitStatusFrame/XPBar" ColorAdjustMode="Colorize"/>
									<Action type="SetProperty" frame="$parent/Team2XPUnitStatusFrame/XPBar" LightAdjustColor="#FCJH_WING_XP_LEAD_LIGHT"/>
									<Action type="SetProperty" frame="$parent/Team2XPUnitStatusFrame/XPBar" DarkAdjustColor="#FCJH_WING_XP_LEAD_DARK"/>
									<Action type="SendEvent" frame="$parent/Team2XPUnitStatusFrame/XPBar" event="FCJH_ShimmerOn"/>  <!-- and it glints (FCJH_Shimmer) -->
								</State>
								<State name="No">
									<Action type="SetProperty" frame="$this" Alpha="0"/>
									<Action type="SetProperty" frame="$parent/Team2XPUnitStatusFrame/XPBar" ColorAdjustMode="None"/>
									<Action type="SendEvent" frame="$parent/Team2XPUnitStatusFrame/XPBar" event="FCJH_ShimmerOff"/>
								</State>
							</StateGroup>
						</Frame>
						<Frame type="Label" name="Team2LevelLabel">
							<RenderPriority val="500"/>
							<Anchor side="Top" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_LEVEL_T"/>
							<Anchor side="Left" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_LEVEL_L"/>
							<Anchor side="Bottom" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_LEVEL_B"/>
							<Anchor side="Right" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_LEVEL_R"/>
							<Width val="0"/>
							<Unclipped val="true"/>
						</Frame>

						<!-- Team XP: Blizzard's observer XP bars, its art and its height, squared into the
						     bottom of the wings under the level plates (blue_wing_xp, red_wing_xp; user,
						     2026-11-11). They fill inward out as Blizzard's do (Expansion Left / Right), and
						     go gold while their team is a talent tier ahead (FCJH_Ahead above). Blizzard's
						     backing art under each, our width (as Ahli 0.75 does). -->
						<Frame type="Image" name="Team1XPUnitStatusFrameBgImage">
							<Alpha val="0"/>  <!-- loads hidden; FCJH_BlueXpWatch (FCJH_Toggles) fades it in with the plates -->
							<Width val="#FCJH_BLUE_WING_XP_W"/>
							<Height val="#FCJH_BLUE_WING_XP_H"/>  <!-- the frame's, set (Blizzard leaves it to the art) -->
							<Texture val="#FCJH_WING_XP_BACKING"/>  <!-- Blizzard's backing without its slanted ends (layout.toml [wing_xp] backing) -->
							<ImageMaskTexture val="#FCJH_WING_XP_MASK_BLUE"/>  <!-- cut to the wing's slants, as the bar -->
							<TextureCoords top="0.0" left="0.0" bottom="1.0" right="1.0"/>  <!-- Blizzard flips blue's; unflipped so the mask can't be mirrored -->
							<RenderPriority val="496"/>
						</Frame>
						<Frame type="Image" name="Team2XPUnitStatusFrameBgImage">
							<Alpha val="0"/>  <!-- loads hidden; FCJH_RedXpWatch (FCJH_Toggles) fades it in with the plates -->
							<Width val="#FCJH_RED_WING_XP_W"/>
							<Height val="#FCJH_RED_WING_XP_H"/>  <!-- the frame's, set (Blizzard leaves it to the art) -->
							<Texture val="#FCJH_WING_XP_BACKING"/>  <!-- Blizzard's backing without its slanted ends (layout.toml [wing_xp] backing) -->
							<ImageMaskTexture val="#FCJH_WING_XP_MASK_RED"/>  <!-- cut to the wing's slants, as the bar -->
							<RenderPriority val="496"/>
						</Frame>
						<!-- The row frames live in Team1/Team2HeroOverview (below), over the plates -->
						<Frame type="TeamVeterancyUnitStatusFrame" name="Team1XPUnitStatusFrame">
							<Alpha val="0"/>  <!-- loads hidden; FCJH_BlueXpWatch (FCJH_Toggles) fades it in with the plates -->
							<Anchor side="Top"    relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_WING_XP_T"/>
							<Anchor side="Left"   relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_WING_XP_L"/>
							<Anchor side="Bottom" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_WING_XP_B"/>
							<Anchor side="Right"  relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_BLUE_WING_XP_R"/>
							<Width val="0"/>   <!-- 0: anchored on all four sides, a size ADDS to the span (it drew 2x, 2026-11-12) -->
							<Height val="0"/>
							<RenderPriority val="497"/>  <!-- over the backplate (490) and the flame (495), under the level (500) -->
							<Unclipped val="true"/>
							<Frame type="UnitStatusVeterancyBar" name="XPBar">
								<RenderPriority val="497"/>
								<Texture val="#FCJH_WING_XP_FILL"/>  <!-- Blizzard's fill without its soft ends (they stretched into a fuzz ahead of the fill; layout.toml [wing_xp] fill) -->
								<AlphaMaskTexture val="#FCJH_WING_XP_MASK_BLUE"/>  <!-- the box is square; this cuts it to the wing's outer slant and the hexagon's side (gen.py wing_xp_mask) -->
								<Tiled val="false" index="0"/>  <!-- stretched to the frame: tiled, Blizzard's 156-wide art spilled past it (2026-11-12) -->
								<!-- The gold's glint (user, 2026-11-12): a flip-book of this bar's own fill with a bright
								     streak stepping out from the hexagon (gen.py wing_xp_shimmer, layout.toml [wing_xp]
								     shimmer_*). It is the fill texture itself, so the engine cuts it to the XP as it does
								     the plain one. One sweep in 1.5 s, then the plain fill to 6 s - ten a minute (user, 2026-11-12), looping while FCJH_Ahead
								     holds; the sweep plays at once when the lead starts. -->
								<Animation name="FCJH_Shimmer">
									<Event event="FCJH_ShimmerOn" action="Restart,Play"/>
									<Event event="FCJH_ShimmerOff" action="Stop"/>
									<Controller type="Texture" end="Loop">
										<Key type="Image" time="0.0000" image="#FCJH_WING_XP_SHIMMER_BLUE_1"/>
										<Key type="Image" time="0.0625" image="#FCJH_WING_XP_SHIMMER_BLUE_2"/>
										<Key type="Image" time="0.1250" image="#FCJH_WING_XP_SHIMMER_BLUE_3"/>
										<Key type="Image" time="0.1875" image="#FCJH_WING_XP_SHIMMER_BLUE_4"/>
										<Key type="Image" time="0.2500" image="#FCJH_WING_XP_SHIMMER_BLUE_5"/>
										<Key type="Image" time="0.3125" image="#FCJH_WING_XP_SHIMMER_BLUE_6"/>
										<Key type="Image" time="0.3750" image="#FCJH_WING_XP_SHIMMER_BLUE_7"/>
										<Key type="Image" time="0.4375" image="#FCJH_WING_XP_SHIMMER_BLUE_8"/>
										<Key type="Image" time="0.5000" image="#FCJH_WING_XP_SHIMMER_BLUE_9"/>
										<Key type="Image" time="0.5625" image="#FCJH_WING_XP_SHIMMER_BLUE_10"/>
										<Key type="Image" time="0.6250" image="#FCJH_WING_XP_SHIMMER_BLUE_11"/>
										<Key type="Image" time="0.6875" image="#FCJH_WING_XP_SHIMMER_BLUE_12"/>
										<Key type="Image" time="0.7500" image="#FCJH_WING_XP_SHIMMER_BLUE_13"/>
										<Key type="Image" time="0.8125" image="#FCJH_WING_XP_SHIMMER_BLUE_14"/>
										<Key type="Image" time="0.8750" image="#FCJH_WING_XP_SHIMMER_BLUE_15"/>
										<Key type="Image" time="0.9375" image="#FCJH_WING_XP_SHIMMER_BLUE_16"/>
										<Key type="Image" time="1.0000" image="#FCJH_WING_XP_SHIMMER_BLUE_17"/>
										<Key type="Image" time="1.0625" image="#FCJH_WING_XP_SHIMMER_BLUE_18"/>
										<Key type="Image" time="1.1250" image="#FCJH_WING_XP_SHIMMER_BLUE_19"/>
										<Key type="Image" time="1.1875" image="#FCJH_WING_XP_SHIMMER_BLUE_20"/>
										<Key type="Image" time="1.2500" image="#FCJH_WING_XP_SHIMMER_BLUE_21"/>
										<Key type="Image" time="1.3125" image="#FCJH_WING_XP_SHIMMER_BLUE_22"/>
										<Key type="Image" time="1.3750" image="#FCJH_WING_XP_SHIMMER_BLUE_23"/>
										<Key type="Image" time="1.4375" image="#FCJH_WING_XP_SHIMMER_BLUE_24"/>
										<Key type="Image" time="1.50" image="#FCJH_WING_XP_FILL"/>
										<Key type="Image" time="6.00" image="#FCJH_WING_XP_FILL"/>
									</Controller>
								</Animation>
								<Animation name="FCJH_ShimmerRest">  <!-- the plain fill back, wherever the sweep stopped -->
									<Event event="FCJH_ShimmerOff" action="Restart,Play"/>
									<Controller type="Texture" end="Pause">
										<Key type="Image" time="0" image="#FCJH_WING_XP_FILL"/>
									</Controller>
								</Animation>
							</Frame>
							<!-- The rim again, over the bar: FCJH_TopRim (498) beside this frame didn't cover
							     the fill (user, 2026-11-12) - a unit-status bar draws over its frame's
							     siblings whatever their priority - so it's a sibling of the bar's, as the
							     core's chrome is of its HealthBar. Clipped to this box (no Unclipped). -->
							<Frame type="Image" name="FCJH_WingRim">
								<Anchor side="Top" relative="$parent/$parent/FCJH_TopBackplate" pos="Min" offset="0"/>
								<Anchor side="Left" relative="$parent/$parent/FCJH_TopBackplate" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$parent/$parent/FCJH_TopBackplate" pos="Max" offset="0"/>
								<Anchor side="Right" relative="$parent/$parent/FCJH_TopBackplate" pos="Max" offset="0"/>
								<Texture val="#FCJH_TOP_RIM"/>
								<RenderPriority val="498"/>  <!-- over XPBar (497) -->
								<AcceptsMouse val="false"/>
							</Frame>
						</Frame>
						<Frame type="TeamVeterancyUnitStatusFrame" name="Team2XPUnitStatusFrame">
							<Alpha val="0"/>  <!-- loads hidden; FCJH_RedXpWatch (FCJH_Toggles) fades it in with the plates -->
							<Anchor side="Top"    relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_WING_XP_T"/>
							<Anchor side="Left"   relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_WING_XP_L"/>
							<Anchor side="Bottom" relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_WING_XP_B"/>
							<Anchor side="Right"  relative="$parent/FCJH_TopBackplate" pos="Min" offset="#FCJH_RED_WING_XP_R"/>
							<Width val="0"/>   <!-- 0: anchored on all four sides, a size ADDS to the span (it drew 2x, 2026-11-12) -->
							<Height val="0"/>
							<RenderPriority val="497"/>  <!-- over the backplate (490) and the flame (495), under the level (500) -->
							<Unclipped val="true"/>
							<Frame type="UnitStatusVeterancyBar" name="XPBar">
								<RenderPriority val="497"/>
								<Texture val="#FCJH_WING_XP_FILL"/>  <!-- Blizzard's fill without its soft ends (they stretched into a fuzz ahead of the fill; layout.toml [wing_xp] fill) -->
								<AlphaMaskTexture val="#FCJH_WING_XP_MASK_RED"/>  <!-- the box is square; this cuts it to the wing's outer slant and the hexagon's side (gen.py wing_xp_mask) -->
								<Tiled val="false" index="0"/>  <!-- stretched to the frame: tiled, Blizzard's 156-wide art spilled past it (2026-11-12) -->
								<!-- The gold's glint (user, 2026-11-12): a flip-book of this bar's own fill with a bright
								     streak stepping out from the hexagon (gen.py wing_xp_shimmer, layout.toml [wing_xp]
								     shimmer_*). It is the fill texture itself, so the engine cuts it to the XP as it does
								     the plain one. One sweep in 1.5 s, then the plain fill to 6 s - ten a minute (user, 2026-11-12), looping while FCJH_Ahead
								     holds; the sweep plays at once when the lead starts. -->
								<Animation name="FCJH_Shimmer">
									<Event event="FCJH_ShimmerOn" action="Restart,Play"/>
									<Event event="FCJH_ShimmerOff" action="Stop"/>
									<Controller type="Texture" end="Loop">
										<Key type="Image" time="0.0000" image="#FCJH_WING_XP_SHIMMER_RED_1"/>
										<Key type="Image" time="0.0625" image="#FCJH_WING_XP_SHIMMER_RED_2"/>
										<Key type="Image" time="0.1250" image="#FCJH_WING_XP_SHIMMER_RED_3"/>
										<Key type="Image" time="0.1875" image="#FCJH_WING_XP_SHIMMER_RED_4"/>
										<Key type="Image" time="0.2500" image="#FCJH_WING_XP_SHIMMER_RED_5"/>
										<Key type="Image" time="0.3125" image="#FCJH_WING_XP_SHIMMER_RED_6"/>
										<Key type="Image" time="0.3750" image="#FCJH_WING_XP_SHIMMER_RED_7"/>
										<Key type="Image" time="0.4375" image="#FCJH_WING_XP_SHIMMER_RED_8"/>
										<Key type="Image" time="0.5000" image="#FCJH_WING_XP_SHIMMER_RED_9"/>
										<Key type="Image" time="0.5625" image="#FCJH_WING_XP_SHIMMER_RED_10"/>
										<Key type="Image" time="0.6250" image="#FCJH_WING_XP_SHIMMER_RED_11"/>
										<Key type="Image" time="0.6875" image="#FCJH_WING_XP_SHIMMER_RED_12"/>
										<Key type="Image" time="0.7500" image="#FCJH_WING_XP_SHIMMER_RED_13"/>
										<Key type="Image" time="0.8125" image="#FCJH_WING_XP_SHIMMER_RED_14"/>
										<Key type="Image" time="0.8750" image="#FCJH_WING_XP_SHIMMER_RED_15"/>
										<Key type="Image" time="0.9375" image="#FCJH_WING_XP_SHIMMER_RED_16"/>
										<Key type="Image" time="1.0000" image="#FCJH_WING_XP_SHIMMER_RED_17"/>
										<Key type="Image" time="1.0625" image="#FCJH_WING_XP_SHIMMER_RED_18"/>
										<Key type="Image" time="1.1250" image="#FCJH_WING_XP_SHIMMER_RED_19"/>
										<Key type="Image" time="1.1875" image="#FCJH_WING_XP_SHIMMER_RED_20"/>
										<Key type="Image" time="1.2500" image="#FCJH_WING_XP_SHIMMER_RED_21"/>
										<Key type="Image" time="1.3125" image="#FCJH_WING_XP_SHIMMER_RED_22"/>
										<Key type="Image" time="1.3750" image="#FCJH_WING_XP_SHIMMER_RED_23"/>
										<Key type="Image" time="1.4375" image="#FCJH_WING_XP_SHIMMER_RED_24"/>
										<Key type="Image" time="1.50" image="#FCJH_WING_XP_FILL"/>
										<Key type="Image" time="6.00" image="#FCJH_WING_XP_FILL"/>
									</Controller>
								</Animation>
								<Animation name="FCJH_ShimmerRest">  <!-- the plain fill back, wherever the sweep stopped -->
									<Event event="FCJH_ShimmerOff" action="Restart,Play"/>
									<Controller type="Texture" end="Pause">
										<Key type="Image" time="0" image="#FCJH_WING_XP_FILL"/>
									</Controller>
								</Animation>
							</Frame>
							<!-- The rim again, over the bar: FCJH_TopRim (498) beside this frame didn't cover
							     the fill (user, 2026-11-12) - a unit-status bar draws over its frame's
							     siblings whatever their priority - so it's a sibling of the bar's, as the
							     core's chrome is of its HealthBar. Clipped to this box (no Unclipped). -->
							<Frame type="Image" name="FCJH_WingRim">
								<Anchor side="Top" relative="$parent/$parent/FCJH_TopBackplate" pos="Min" offset="0"/>
								<Anchor side="Left" relative="$parent/$parent/FCJH_TopBackplate" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$parent/$parent/FCJH_TopBackplate" pos="Max" offset="0"/>
								<Anchor side="Right" relative="$parent/$parent/FCJH_TopBackplate" pos="Max" offset="0"/>
								<Texture val="#FCJH_TOP_RIM"/>
								<RenderPriority val="498"/>  <!-- over XPBar (497) -->
								<AcceptsMouse val="false"/>
							</Frame>
						</Frame>

						<!-- Core health: blue anchors by its right edge, red by its left (Blizzard's
						     own sides); the fixed 300 x 100 frame keeps its size. Blizzard's
						     backing art off; our slanted track under the bar, the bar's
						     fill swapped for our team colour (untiled, untinted; bevelled, [bar_bevel]), all cut to the
						     slant by FCJH_CoreMask. Its own chrome line round it on top
						     (FCJH_CoreChrome, [team_core] frame_width), a child so it shows only
						     when Blizzard shows the core. The track and the sibling mask sit in a
						     box of their own (FCJH_CoreTrackBox) so the mask can't reach the chrome
						     (it never cut the bar either: the bar carries its own mask). -->
						<Frame type="UnitStatusFrame" name="Team1CoreUnitStatus">
							<Anchor side="Top"   relative="$GameUI" pos="Max" offset="#FCJH_BLUE_CORE_FRAME_T"/>
							<Anchor side="Right" relative="$GameUI" pos="Mid" offset="#FCJH_BLUE_CORE_FRAME_R"/>
							<Unclipped val="true"/>
							<Frame type="UnitStatusElement" name="HealthBarBackingBlue">
								<Frame type="Image" name="Image"><Alpha val="0"/></Frame>
							</Frame>
							<Frame type="Frame" name="FCJH_CoreTrackBox">
								<Anchor relative="$parent/HealthBar"/>
								<RenderPriority val="100"/>
								<AcceptsMouse val="false"/>
								<Frame type="Image" name="FCJH_CoreTrack">
									<Anchor relative="$parent"/>
									<Texture val="#FCJH_CORE_TRACK_BLUE"/>
									<RenderPriority val="100"/>
									<AcceptsMouse val="false"/>
								</Frame>
								<Frame type="Frame" name="FCJH_CoreMask">
									<Anchor relative="$parent"/>
									<AlphaMaskTexture val="#FCJH_CORE_MASK_BLUE"/>
									<AlphaMaskSiblings val="true"/>
									<RenderPriority val="1"/>  <!-- as Blizzard's own bar mask (HeroStatus ImageMaskFrame) -->
									<AcceptsMouse val="false"/>
								</Frame>
							</Frame>
							<Frame type="Image" name="FCJH_CoreChrome">
								<Anchor side="Top" relative="$parent/HealthBar" pos="Min" offset="#FCJH_CORE_CHROME_TL"/>
								<Anchor side="Left" relative="$parent/HealthBar" pos="Min" offset="#FCJH_CORE_CHROME_TL"/>
								<Anchor side="Bottom" relative="$parent/HealthBar" pos="Max" offset="#FCJH_CORE_CHROME_BR"/>
								<Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="#FCJH_CORE_CHROME_BR"/>
								<Texture val="#FCJH_CORE_CHROME_BLUE"/>
								<RenderPriority val="520"/>  <!-- over the bar's fill -->
								<AcceptsMouse val="false"/>
							</Frame>
							<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
								<Texture val="#FCJH_CORE_FILL_BLUE"/>
								<AlphaMaskTexture val="#FCJH_CORE_MASK_BLUE"/>
								<ColorStyle val="AllWhite" index="0"/>
								<Tiled val="false" index="0"/>
								<StateGroup name="FCJH_ColourBlind">  <!-- the game's colour-blind option: layout.toml [colour_blind] -->
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" Texture="#FCJH_CORE_FILL_BLUE_CB"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" Texture="#FCJH_CORE_FILL_BLUE"/>
									</State>
								</StateGroup>
							</Frame>
							<!-- Alterac Pass: the keeps' shields (Blizzard's, alteracmechanics.stormlayout
							     HealthBarShieldContainerTemplate), which Blizzard's map gives only the player
							     HUD's core bars. Each keep alive is a WarchiefAlive stack on the core (armour);
							     the map's own validators count them, the insides empty as keeps fall (3 -> 0).
							     Hidden until a count state fires, which only happens on Alterac (Ahli 0.75's
							     way: the validators and art exist only there). In a row past the bar's outer
							     end, outside its border ([team_core] av_shield*; centred, they covered the number). -->
							<Frame type="UnitStatusColor" name="FCJH_TeamColour"><Anchor relative="$parent"/><ColorStyle val="Primary"/></Frame>
							<Frame type="UnitStatusColor" name="FCJH_TeamColourLight"><Anchor relative="$parent"/><ColorStyle val="PrimaryLight"/></Frame>
							<Frame type="Frame" name="FCJH_AVShield3" template="FCJH_TopBar/FCJH_AVShieldTemplate">
								<Anchor side="Right" relative="$parent/HealthBar" pos="Min" offset="#FCJH_AV_SHIELD_OUT_BLUE"/>
							</Frame>
							<Frame type="Frame" name="FCJH_AVShield2" template="FCJH_TopBar/FCJH_AVShieldTemplate">
								<Anchor side="Right" relative="$parent/FCJH_AVShield3" pos="Min" offset="#FCJH_AV_SHIELD_STEP_BLUE"/>
							</Frame>
							<Frame type="Frame" name="FCJH_AVShield1" template="FCJH_TopBar/FCJH_AVShieldTemplate">
								<Anchor side="Right" relative="$parent/FCJH_AVShield2" pos="Min" offset="#FCJH_AV_SHIELD_STEP_BLUE"/>
							</Frame>
							<Frame type="UnitStatusValidatorAnimElement" name="FCJH_AVKeeps">
								<Anchor relative="$parent"/>
								<Validator val="SourceHas3WarchiefsAlive"/>
								<Validator val="SourceHas2WarchiefsAlive"/>
								<Validator val="SourceHas1WarchiefsAlive"/>
								<Validator val="SourceHas0WarchiefsAlive"/>
								<StateGroup name="FCJH_KeepsAlive">
									<DefaultState val="Other"/>
									<State name="3Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas3WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="True"/>
									</State>
									<State name="2Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas2WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="False"/>
									</State>
									<State name="1Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas1WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="False"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="False"/>
									</State>
									<State name="0Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas0WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="False"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="False"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="False"/>
									</State>
									<State name="Other"/>
								</StateGroup>
							</Frame>
						</Frame>
						<Frame type="UnitStatusFrame" name="Team2CoreUnitStatus">
							<Anchor side="Top"  relative="$GameUI" pos="Max" offset="#FCJH_RED_CORE_FRAME_T"/>
							<Anchor side="Left" relative="$GameUI" pos="Mid" offset="#FCJH_RED_CORE_FRAME_L"/>
							<Unclipped val="true"/>
							<Frame type="UnitStatusElement" name="HealthBarBackingRed">
								<Frame type="Image" name="ImageUnmirrored"><Alpha val="0"/></Frame>
							</Frame>
							<Frame type="Frame" name="FCJH_CoreTrackBox">
								<Anchor relative="$parent/HealthBar"/>
								<RenderPriority val="100"/>
								<AcceptsMouse val="false"/>
								<Frame type="Image" name="FCJH_CoreTrack">
									<Anchor relative="$parent"/>
									<Texture val="#FCJH_CORE_TRACK_RED"/>
									<RenderPriority val="100"/>
									<AcceptsMouse val="false"/>
								</Frame>
								<Frame type="Frame" name="FCJH_CoreMask">
									<Anchor relative="$parent"/>
									<AlphaMaskTexture val="#FCJH_CORE_MASK_RED"/>
									<AlphaMaskSiblings val="true"/>
									<RenderPriority val="1"/>  <!-- as Blizzard's own bar mask (HeroStatus ImageMaskFrame) -->
									<AcceptsMouse val="false"/>
								</Frame>
							</Frame>
							<Frame type="Image" name="FCJH_CoreChrome">
								<Anchor side="Top" relative="$parent/HealthBar" pos="Min" offset="#FCJH_CORE_CHROME_TL"/>
								<Anchor side="Left" relative="$parent/HealthBar" pos="Min" offset="#FCJH_CORE_CHROME_TL"/>
								<Anchor side="Bottom" relative="$parent/HealthBar" pos="Max" offset="#FCJH_CORE_CHROME_BR"/>
								<Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="#FCJH_CORE_CHROME_BR"/>
								<Texture val="#FCJH_CORE_CHROME_RED"/>
								<RenderPriority val="520"/>  <!-- over the bar's fill -->
								<AcceptsMouse val="false"/>
							</Frame>
							<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
								<Texture val="#FCJH_CORE_FILL_RED"/>
								<AlphaMaskTexture val="#FCJH_CORE_MASK_RED"/>
								<ColorStyle val="AllWhite" index="0"/>
								<Tiled val="false" index="0"/>
								<StateGroup name="FCJH_ColourBlind">  <!-- the game's colour-blind option: layout.toml [colour_blind] -->
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" Texture="#FCJH_CORE_FILL_RED_CB"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" Texture="#FCJH_CORE_FILL_RED"/>
									</State>
								</StateGroup>
							</Frame>
							<!-- Alterac Pass: the keeps' shields (Blizzard's, alteracmechanics.stormlayout
							     HealthBarShieldContainerTemplate), which Blizzard's map gives only the player
							     HUD's core bars. Each keep alive is a WarchiefAlive stack on the core (armour);
							     the map's own validators count them, the insides empty as keeps fall (3 -> 0).
							     Hidden until a count state fires, which only happens on Alterac (Ahli 0.75's
							     way: the validators and art exist only there). In a row past the bar's outer
							     end, outside its border ([team_core] av_shield*; centred, they covered the number). -->
							<Frame type="UnitStatusColor" name="FCJH_TeamColour"><Anchor relative="$parent"/><ColorStyle val="Primary"/></Frame>
							<Frame type="UnitStatusColor" name="FCJH_TeamColourLight"><Anchor relative="$parent"/><ColorStyle val="PrimaryLight"/></Frame>
							<Frame type="Frame" name="FCJH_AVShield3" template="FCJH_TopBar/FCJH_AVShieldTemplate">
								<Anchor side="Left" relative="$parent/HealthBar" pos="Max" offset="#FCJH_AV_SHIELD_OUT_RED"/>
							</Frame>
							<Frame type="Frame" name="FCJH_AVShield2" template="FCJH_TopBar/FCJH_AVShieldTemplate">
								<Anchor side="Left" relative="$parent/FCJH_AVShield3" pos="Max" offset="#FCJH_AV_SHIELD_STEP_RED"/>
							</Frame>
							<Frame type="Frame" name="FCJH_AVShield1" template="FCJH_TopBar/FCJH_AVShieldTemplate">
								<Anchor side="Left" relative="$parent/FCJH_AVShield2" pos="Max" offset="#FCJH_AV_SHIELD_STEP_RED"/>
							</Frame>
							<Frame type="UnitStatusValidatorAnimElement" name="FCJH_AVKeeps">
								<Anchor relative="$parent"/>
								<Validator val="SourceHas3WarchiefsAlive"/>
								<Validator val="SourceHas2WarchiefsAlive"/>
								<Validator val="SourceHas1WarchiefsAlive"/>
								<Validator val="SourceHas0WarchiefsAlive"/>
								<StateGroup name="FCJH_KeepsAlive">
									<DefaultState val="Other"/>
									<State name="3Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas3WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="True"/>
									</State>
									<State name="2Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas2WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="False"/>
									</State>
									<State name="1Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas1WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="True"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="False"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="False"/>
									</State>
									<State name="0Alive">
										<When type="AnimationState" UnitStatusValidatorState="SourceHas0WarchiefsAlive"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3" Visible="True" undo="false"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield1/ShieldInside" Visible="False"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield2/ShieldInside" Visible="False"/>
										<Action type="SetProperty" frame="$parent/FCJH_AVShield3/ShieldInside" Visible="False"/>
									</State>
									<State name="Other"/>
								</StateGroup>
							</Frame>
						</Frame>
					</Frame>

					<!-- Towers and kills; and the row frames: a chrome line round each team's plates and
					     XP bar ([row_frame]; tools/gen.py row_frame_texture). FCJH_RowPacker moves and
					     swaps them for rows of 1-4. Here, not in ObserverTopPanel, since RenderPriority
					     orders siblings only: ObserverTopPanel (200) draws under the team overviews, so
					     the chrome there sat under every plate (user, 2026-10-16). At 520 they're over
					     the cells (HeroOverview1-5, 501-505). -->
					<Frame type="Frame" name="Team1HeroOverview">
						<Frame type="Image" name="FCJH_BlueRowFrame">
							<Anchor side="Top"    relative="$GameUI" pos="Max" offset="#FCJH_BLUE_ROW_FRAME_T"/>
							<Anchor side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_BLUE_ROW_FRAME_L"/>
							<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_BLUE_ROW_FRAME_B"/>
							<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_BLUE_ROW_FRAME_R"/>
							<Texture val="#FCJH_ROW_FRAME_BLUE"/>
							<RenderPriority val="520"/>
							<Unclipped val="true"/>
							<AcceptsMouse val="false"/>
						</Frame>
						<Frame type="Label" name="TownsRemainingValueLabel" template="FCJH_HeroRow/FCJH_Parked"/>
						<Frame type="TeamScoreValueFrame" name="TeamKillsValueFrame" template="FCJH_HeroRow/FCJH_Parked"/>
					</Frame>
					<Frame type="Frame" name="Team2HeroOverview">
						<Frame type="Image" name="FCJH_RedRowFrame">
							<Anchor side="Top"    relative="$GameUI" pos="Max" offset="#FCJH_RED_ROW_FRAME_T"/>
							<Anchor side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_RED_ROW_FRAME_L"/>
							<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_RED_ROW_FRAME_B"/>
							<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_RED_ROW_FRAME_R"/>
							<Texture val="#FCJH_ROW_FRAME_RED"/>
							<RenderPriority val="520"/>
							<Unclipped val="true"/>
							<AcceptsMouse val="false"/>
						</Frame>
						<Frame type="Label" name="TownsRemainingValueLabel" template="FCJH_HeroRow/FCJH_Parked"/>
						<Frame type="TeamScoreValueFrame" name="TeamKillsValueFrame" template="FCJH_HeroRow/FCJH_Parked"/>
					</Frame>
				</Frame>

				<!-- The pause box: Blizzard's own ("X paused the game. (N remaining)", custom games),
				     moved off the logo plate and clock to 40 px under the clock (layout.toml
				     system_alert; user, 2026-10-24/25). Ahli moves the same panel. -->
				<Frame type="SystemAlertPanel" name="SystemAlertPanel">
					<Anchor side="Top"    relative="$GameUI" pos="Min" offset="#FCJH_SYSTEM_ALERT_T"/>
					<Anchor side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_SYSTEM_ALERT_L"/>
					<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="#FCJH_SYSTEM_ALERT_B"/>
					<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_SYSTEM_ALERT_R"/>
				</Frame>
			</Frame>
		</Frame>
	</Frame>
</Desc>
