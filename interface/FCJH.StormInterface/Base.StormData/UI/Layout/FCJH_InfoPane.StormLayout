								<Anchor side="Left"   relative="$parent" pos="Min" offset="541"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="5"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="46"/>
								<Height val="46"/>
							</Frame>
							<!-- Blizzard's talent squares, recoloured in colour-blind mode as the pop-ups' (gen.py colour_blind_plate "square"; hand-copied) -->
							<Frame type="Image" name="CustomTalentTreeIconBorder1">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="ffc2aa"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="e65d27"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
							<Frame type="Image" name="CustomTalentTreeIconBorder2">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="ffc2aa"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="e65d27"/>
									</State>
