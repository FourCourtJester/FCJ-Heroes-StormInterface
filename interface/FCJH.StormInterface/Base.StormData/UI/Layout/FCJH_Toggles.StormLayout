	<Frame type="UnitStatusName" name="HeroUnitStatusFrameYellowEnergy/HeroUnitStatusParentFrame/PlayerUnitNameLabel" file="UnitStatus">
		<Frame type="Label" name="Label"><Visible val="{$FCJH_NAMES/@Visible}"/></Frame>
