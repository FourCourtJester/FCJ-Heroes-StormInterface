									<State name="Ok31pc"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="31%"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok31"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="31"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
