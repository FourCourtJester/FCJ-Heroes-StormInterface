							</Frame>
						</Frame>
					</Frame>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame2">
						<Frame type="PlayerHeroIconFrame" name="CustomPlayerHeroIconFrame">
							<Anchor side="Left"   relative="$parent" pos="Min" offset="23"/>
							<Anchor side="Top"    relative="$parent" pos="Min" offset="11"/>
							<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
							<Width val="90"/>
							<Height val="33"/>
						</Frame>
						<Frame type="PlayerHeroSelectedTalentTreeFrame" name="TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame">
							<Frame type="Frame" name="FCJH_QuestCell">
								<!-- Blizzard's 68 whole, its 40 picture (14 in) on the 40 cell at 134, 8 -->
								<Anchor side="Left"   relative="$parent" pos="Min" offset="120"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="-6"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="68"/>
								<Height val="68"/>
								<Handle val="FCJH_QuestCell2"/>
								<AcceptsMouse val="false"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon1">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="192"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
