						<State name="Fire">
							<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon1" TalentTierState="TierSelected"/>
							<When type="Property" frame="Shown" visible="false"/>
							<Action type="SetProperty" frame="Shown" visible="true"/>
							<Action type="SetProperty" frame="$parent/FCJH_Talent0/FCJH_Body/T1" Visible="true"/>
							<Action type="SetProperty" frame="$parent/FCJH_Talent0/FCJH_Body/T2" Visible="false"/>
