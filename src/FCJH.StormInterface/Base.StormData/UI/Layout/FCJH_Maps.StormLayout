			<Animation name="FCJH_Sync6">
				<Event event="FCJH_Sync6" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="true"/></Controller>
			</Animation>
			<StateGroup name="FCJH_WhoTook">
				<DefaultState val="Same"/>
				<State name="Blue1"><When type="Property" frame="$this/FCJH_Cur0" Visible="true"/><When type="Property" frame="$this/FCJH_New1" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue2"><When type="Property" frame="$this/FCJH_Cur1" Visible="true"/><When type="Property" frame="$this/FCJH_New2" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue3"><When type="Property" frame="$this/FCJH_Cur2" Visible="true"/><When type="Property" frame="$this/FCJH_New3" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue4"><When type="Property" frame="$this/FCJH_Cur3" Visible="true"/><When type="Property" frame="$this/FCJH_New4" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue5"><When type="Property" frame="$this/FCJH_Cur4" Visible="true"/><When type="Property" frame="$this/FCJH_New5" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue6"><When type="Property" frame="$this/FCJH_Cur5" Visible="true"/><When type="Property" frame="$this/FCJH_New6" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Red0"><When type="Property" frame="$this/FCJH_Cur1" Visible="true"/><When type="Property" frame="$this/FCJH_New0" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red1"><When type="Property" frame="$this/FCJH_Cur2" Visible="true"/><When type="Property" frame="$this/FCJH_New1" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red2"><When type="Property" frame="$this/FCJH_Cur3" Visible="true"/><When type="Property" frame="$this/FCJH_New2" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red3"><When type="Property" frame="$this/FCJH_Cur4" Visible="true"/><When type="Property" frame="$this/FCJH_New3" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red4"><When type="Property" frame="$this/FCJH_Cur5" Visible="true"/><When type="Property" frame="$this/FCJH_New4" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red5"><When type="Property" frame="$this/FCJH_Cur6" Visible="true"/><When type="Property" frame="$this/FCJH_New5" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Same"/>
			</StateGroup>
		</Frame>
		<!-- The towns' shot counts (each team's towns plus the core shots), flanking the minimap's
		     middle on the screen's bottom edge (MapMechanicPanel TeamCollectionFrameTemplate). Their
		     panel filled the right-edge strip, which clipped them (user, 2026-10-06): it now
		     spans the screen, unclipped. -->
		<Frame type="Frame" name="PotentialPointsPanel">
			<Anchor side="Top"    relative="$GameUI" pos="Min" offset="0"/>
			<Anchor side="Left"   relative="$GameUI" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
			<Anchor side="Right"  relative="$GameUI" pos="Max" offset="0"/>
			<Unclipped val="true"/>
		</Frame>
	</Frame>
	<!-- ===== Volskaya Foundry: the capture point's hex is placed from the minimap; its strip clipped it ===== -->
	<Frame type="Frame" name="VolskayaCapturePointPanel" file="VolskayaMapMechanic">
		<Anchor side="Top"    relative="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" pos="Max" offset="-1235"/>
		<Anchor side="Bottom" relative="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" pos="Max" offset="-35"/>
		<Anchor side="Right"  relative="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" pos="Max" offset="0"/>
		<!-- the minimap's place on Volskaya Foundry, from the moment this panel exists -->
		<Frame type="Frame" name="FCJH_MinimapPlace">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<StateGroup name="FCJH_Place">
				<DefaultState val="Placed"/>
				<State name="Placed">
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_VOLSKAYA_FOUNDRY"/>
				</State>
			</StateGroup>
		</Frame>
	</Frame>
	<!-- ===== Warhead Junction: its panel is placed from the minimap already ===== -->
	<Frame type="Frame" name="SC2Panel" file="SCMap2">
		<!-- the minimap's place on Warhead Junction, from the moment this panel exists -->
		<Frame type="Frame" name="FCJH_MinimapPlace">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<StateGroup name="FCJH_Place">
				<DefaultState val="Placed"/>
				<State name="Placed">
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_WARHEAD_JUNCTION"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel/Minimap" side="Left" relative="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" pos="Min" offset="0"/>
				</State>
			</StateGroup>
		</Frame>
	</Frame>
</Desc>
