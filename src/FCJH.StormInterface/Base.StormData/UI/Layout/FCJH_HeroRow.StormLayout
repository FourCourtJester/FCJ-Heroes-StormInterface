		</Frame>
		<!-- EXPERIMENT: the same portrait mirrored, shown over it while Abathur has a clone
		     (HeroStatus's FCJH_Clone state). The mask spans the frame, so the cut stays put. -->
		<Frame type="Image" name="FCJH_ClonePortrait">
