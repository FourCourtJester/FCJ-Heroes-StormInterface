			<Texture val="@UI/HUD_TopBar_Team_HeroFrame_BG_Blue"/>
			<RenderPriority val="401"/>
		</Frame>
		<Frame type="Image" name="IconFrame">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="64"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="64"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="63"/>
			<Width val="0"/>
			<Height val="0"/>
			<Alpha val="0"/>
		</Frame>
		<Frame type="Image" name="HeroPortraitBackground" template="FCJH_HeroRow/FCJH_Parked"/>
		<Frame type="Image" name="TalentsBgImage" template="FCJH_HeroRow/FCJH_Parked"/>
		<Frame type="Label" name="HeroDeathTimeLabel">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="2"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="3"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="75"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="3"/>
			<Width val="0"/>
			<Height val="0"/>
			<Style val="Storm_TopBar_DeathTimer"/>
			<RenderPriority val="520"/>
		</Frame>
		<Frame type="Image" name="HeroPortraitImage">
