						<State name="Fire">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview4/HeroStatus/FCJH_LowMark" visible="true"/>
							<When type="Property" frame="FCJH_Armed" visible="true"/>
