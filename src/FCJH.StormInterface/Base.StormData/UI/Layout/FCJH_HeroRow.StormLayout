<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
<!-- GENERATED by tools/gen.py from layout.toml. Do not edit by hand:
     change layout.toml (or tools/gen.py) and rebuild. -->

	<!-- Hero row: Blizzard's observer hero cells, moved to the bottom row (layout.toml
	     [hero_row]) and dressed as Blizzard's IN-GAME top-bar cells: the same art, sizes and
	     stacking (tools/gen.py HeroCell). Cells overlap by 30 and the outermost draws on top,
	     so the slanted frames interlock. Rules this follows, all learned in game:
	       - Unclipped: a frame moved outside its parent's rectangle is otherwise clipped away
	       - IconFrame hidden with Alpha 0, not parked: Blizzard's death-timer states anchor
	         to it, so it is placed where those anchors land centred
	       - HeroStatus IS the health fill's rectangle: Blizzard's HeightOverride state pins
	         the bar's bottom to HeroStatus's, so the bar can't be sized any other way
	       - portraits are cut by our own alpha masks (FCJH_Portrait_*), not Blizzard's
	         ImageMaskTexture: that one follows the face crop and loses its left-edge cut
	       - the resource bar lives inside HeroStatus to inherit the hero; its colour comes
	         from Blizzard's own hero table, on HeroStatus itself (unit checks only work there) -->

	<Frame type="Frame" name="FCJH_Parked">
		<Anchor side="Top"    relative="$parent" pos="Min" offset="9999"/>
		<Anchor side="Left"   relative="$parent" pos="Min" offset="9999"/>
		<Anchor side="Bottom" relative="$parent" pos="Min" offset="10299"/>
		<Anchor side="Right"  relative="$parent" pos="Min" offset="10299"/>
	</Frame>

	<Frame type="Frame" name="FCJH_HeroCell">
		<Width val="198"/>
		<Height val="94"/>
		<Unclipped val="true"/>
		<Frame type="Image" name="FCJH_FrameBg">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
			<Width val="0"/>
			<Height val="0"/>
			<Texture val="@UI/HUD_TopBar_Team_HeroFrame"/>
			<RenderPriority val="400"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Frame type="Image" name="FCJH_TeamBg">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
			<Width val="0"/>
			<Height val="0"/>
			<Texture val="@UI/HUD_TopBar_Team_HeroFrame_BG_Blue"/>
			<RenderPriority val="401"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Frame type="Image" name="IconFrame">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="71"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="71"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="64"/>
			<Width val="0"/>
			<Height val="0"/>
			<Alpha val="0"/>
		</Frame>
		<Frame type="Image" name="HeroPortraitBackground" template="FCJH_HeroRow/FCJH_Parked"/>
		<Frame type="Image" name="TalentsBgImage" template="FCJH_HeroRow/FCJH_Parked"/>
		<!-- Blizzard's click target (select, centre the camera): the whole plate, above
		     everything we draw, so no art of ours can take the click; its hit test is the
		     plate's slanted shape (FCJH_PLATE_HIT_*), not the square -->
		<Frame type="UnitTargetFrame" name="TargetHeroUnitFrame">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
			<Width val="0"/>
			<Height val="0"/>
			<HitTestTexture val="#FCJH_PLATE_HIT_BLUE"/>
			<RenderPriority val="600"/>
		</Frame>
		<!-- Blizzard's timer is now only a sensor (Alpha 0): ours, FCJH_DeathTime, shows its
		     text and visibility, inside a holder that fades it in after the skull (Ahli's
		     handover) - the Viking watch sets the label's own Alpha, the holder's is the fade's.
		     The respawn flash is the instance's (pet_death_bindings). -->
		<Frame type="Label" name="HeroDeathTimeLabel">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="2"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="4"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="93"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="4"/>
			<Width val="0"/>
			<Height val="0"/>
			<Style val="Storm_TopBar_DeathTimer"/>
			<Alpha val="0"/>
			<RenderPriority val="520"/>
		</Frame>
		<Frame type="Frame" name="FCJH_DeathTimeHold">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="2"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="4"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="93"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="4"/>
			<RenderPriority val="520"/>
			<Unclipped val="true"/>
			<AcceptsMouse val="false"/>
			<Animation name="FCJH_Handover">
				<Event event="OnShown" action="Reset,Play" frame="$parent/HeroDeathTimeLabel"/>
				<Controller type="Fade" end="Pause">
					<Key type="Curve" time="0" value="0" inout="Linear"/>
					<Key type="Curve" time=".7" value="0" inout="Linear"/>
					<Key type="Curve" time="1.2" value="255" inout="Linear"/>
				</Controller>
			</Animation>
			<Frame type="Label" name="FCJH_DeathTime">
				<Anchor relative="$parent"/>
				<Text val="{$parent/$parent/HeroDeathTimeLabel/@Text}"/>
				<Visible val="{$parent/$parent/HeroDeathTimeLabel/@Visible}"/>
				<Style val="Storm_TopBar_DeathTimer"/>
				<RenderPriority val="520"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
		</Frame>
		<!-- The skull (death_skull): Blizzard's player-view death animation, scaled. The
		     respawn glow inside it pulses from the instance (pet_death_bindings). -->
		<Frame type="Frame" name="FCJH_DeathSkull">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="-5"/>
