					<AlphaMaskTexture val="#FCJH_TOKEN_MASK_BLUE"/>
					<TextureCoords top="0.13" left="0.0" bottom="0.87" right="1.0"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_Dim">
					<Anchor relative="$parent"/>
					<Texture val="#FCJH_TOKEN_DIM_BLUE"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
