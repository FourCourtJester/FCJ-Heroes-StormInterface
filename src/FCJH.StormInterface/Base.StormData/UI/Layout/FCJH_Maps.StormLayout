								<Unclipped val="true"/>
							</Frame>
							<Frame type="Label" name="SkullsRemainingLabel">
								<Anchor side="Top"    relative="$parent/FCJH_SkullsPlaque" pos="Mid" offset="3"/>
								<Anchor side="Bottom" relative="$parent/FCJH_SkullsPlaque" pos="Mid" offset="3"/>
								<Anchor side="Left" relative="$GameUI" pos="Mid" offset="0"/>
								<Anchor side="Right" relative="$GameUI" pos="Mid" offset="0"/>
								<Unclipped val="true"/>
							</Frame>
						</Frame>
					</Frame>
				</Frame>
			</Frame>
		</Frame>
		<!-- the older maps' own minimap places, from the start: Blizzard's map id (tools/maps.py id_placers) -->
		<Frame type="DataRefFrame" name="FCJH_MapId">
			<Argument name="GalaxyVar" val="libCore_gv_mAPMapStringID"/>
		</Frame>
		<Frame type="Frame" name="FCJH_MinimapPlaceHauntedMines">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<StateGroup name="FCJH_Place">
				<DefaultState val="Other"/>
				<State name="Placed">
					<When type="Property" frame="$parent/FCJH_MapId" StringValue="HauntedMines"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_LAUNCH_HAUNTED_MINES"/>
				</State>
				<State name="Other"/>
			</StateGroup>
			<!-- Haunted Mines: the whole map once SkullModeFrame first shows, gliding up (maps.glide) -->
			<Frame type="Frame" name="FCJH_Opened">
				<Anchor relative="$parent"/>
				<Visible val="false"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Animation name="FCJH_Glide">
				<Event event="FCJH_Open" action="Play"/>
				<Controller type="Anchor" end="Pause" side="Bottom" relative="true" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel">
					<Key type="Curve" time="0.0" value="138"/>
					<Key type="Curve" time="0.1" value="133"/>
					<Key type="Curve" time="0.2" value="119"/>
					<Key type="Curve" time="0.3" value="98"/>
					<Key type="Curve" time="0.4" value="74"/>
					<Key type="Curve" time="0.5" value="46"/>
					<Key type="Curve" time="0.6" value="19"/>
					<Key type="Curve" time="0.7" value="-5"/>
					<Key type="Curve" time="0.8" value="-26"/>
					<Key type="Curve" time="0.9" value="-40"/>
					<Key type="Curve" time="1.0" value="-45"/>
				</Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Opened">
					<Key type="Bool" time="0" value="true"/>
				</Controller>
			</Animation>
			<StateGroup name="FCJH_Open">
				<DefaultState val="Shut"/>
				<State name="Open">
					<When type="Property" frame="$parent/FCJH_MapId" StringValue="HauntedMines"/>
					<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/HauntedMinesPanel/SkullModeFrame" Visible="true"/>
					<When type="Property" frame="$this/FCJH_Opened" Visible="false"/>
					<Action type="SendEvent" frame="$this" event="FCJH_Open"/>
				</State>
				<State name="Shut"/>
			</StateGroup>
		</Frame>
		<!-- DIAGNOSTIC (maps.diag): the map id -->
		<Frame type="DataRefFrame" name="FCJH_DiagMapId">
			<Argument name="GalaxyVar" val="libCore_gv_mAPMapStringID"/>
		</Frame>
		<Frame type="Label" name="FCJH_Diag0">
			<Anchor side="Top"  relative="$GameUI" pos="Min" offset="300"/>
			<Anchor side="Left" relative="$GameUI" pos="Min" offset="25"/>
			<Width val="300"/>
			<Height val="26"/>
			<Style val="WaitingForPlayersDialogChat"/>
			<Options val="NoWrapping"/>
			<Unclipped val="true"/>
			<AcceptsMouse val="false"/>
			<Text val="map id:"/>
		</Frame>
		<Frame type="Label" name="FCJH_DiagValue0">
			<Anchor side="Top"  relative="$GameUI" pos="Min" offset="300"/>
			<Anchor side="Left" relative="$GameUI" pos="Min" offset="325"/>
			<Width val="400"/>
			<Height val="26"/>
			<Style val="WaitingForPlayersDialogChat"/>
			<Options val="NoWrapping"/>
			<Unclipped val="true"/>
			<AcceptsMouse val="false"/>
			<Text val="{$parent/FCJH_DiagMapId/@StringValue}"/>
		</Frame>
	</Frame>
	<!-- ===== Alterac Pass: a strip down the right edge; the cage fight bar and its two event banners at its middle ===== -->
	<Frame type="Frame" name="AlteracMechanicsPanel" file="AlteracMechanics">
		<Anchor side="Top"    relative="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" pos="Max" offset="-1260"/>
		<Anchor side="Bottom" relative="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" pos="Max" offset="-60"/>
		<Anchor side="Right"  relative="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" pos="Max" offset="0"/>
		<!-- the minimap's place on Alterac Pass, from the moment this panel exists -->
