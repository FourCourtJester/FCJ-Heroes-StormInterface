					<Action type="SetProperty" frame="RedTier" Text="6"/>
				</State>
				<State name="L25">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="25"/>
					<Action type="SetProperty" frame="RedTier" Text="6"/>
				</State>
				<State name="L26">
