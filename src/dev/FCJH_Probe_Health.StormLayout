<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): a critical-health pop-up per hero.

	     ROUND 5 DIAGNOSTIC: round 4 showed nothing below 25%. A second element per cell
	     uses TargetLifeFull (true for everyone at game start), drawn as a YELLOW plus lower
	     down: yellow pluses at the start = the element runs, the 25% check is the problem;
	     none anywhere = validator elements don't run in observer cells at all.

	     A UnitStatusValidatorAnimElement inside each stock top-bar cell's HeroStatus inherits
	     that cell's hero (the CC-sensor trick). It fires an event named after a validator when
	     that validator passes for the hero, and "NoState" when none do. TargetLifeLT25Percent
	     is Blizzard's own (heroesdata game data, always loaded).
	     Look for: a green plus under a hero while below 25% life; gone when healed.
	     Watch: dead heroes (0% life) - does the box sit on them too? -->

	<Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealthTemplate">
		<Anchor side="Top"   relative="$parent" pos="Max" offset="30"/>
		<Anchor side="Left"  relative="$parent" pos="Mid" offset="-22"/>
		<Anchor side="Right" relative="$parent" pos="Mid" offset="22"/>
		<Height val="44"/>
		<Validator val="TargetLifeLT25Percent"/>
		<!-- Round 3 showed nothing: unit-status elements hide by viewer relationship, and an
		     observer is none of owner / ally / enemy. Build 50's CC marker needed these too. -->
		<VisibleToOwner val="true"/>
		<VisibleToAlly val="true"/>
		<VisibleToEnemy val="true"/>
		<!-- Icon: the user's pick, #4 from the icon gallery - a white plus, tinted green
		     (a tint multiplies, so white becomes exactly the tint colour). -->
		<Frame type="Image" name="Icon">
			<Anchor relative="$parent"/>
			<Texture val="@UI/Storm_UI_Play_RandomHero_Button_Icon_Active_Healer"/>
			<Color val="3CDC5A"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Animation name="Low">
			<Event event="TargetLifeLT25Percent" action="Reset,Play"/>
			<Controller type="Visibility" end="Pause" frame="Icon">
				<Key type="Bool" time="0" value="true"/>
			</Controller>
		</Animation>
		<Animation name="NotLow">
			<Event event="NoState" action="Reset,Play"/>
			<Controller type="Visibility" end="Pause" frame="Icon">
				<Key type="Bool" time="0" value="false"/>
			</Controller>
		</Animation>
	</Frame>

	<Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealthTemplate">
		<Anchor side="Top"   relative="$parent" pos="Max" offset="80"/>
		<Anchor side="Left"  relative="$parent" pos="Mid" offset="-22"/>
		<Anchor side="Right" relative="$parent" pos="Mid" offset="22"/>
		<Height val="44"/>
		<Validator val="TargetLifeFull"/>
		<!-- Round 3 showed nothing: unit-status elements hide by viewer relationship, and an
		     observer is none of owner / ally / enemy. Build 50's CC marker needed these too. -->
		<VisibleToOwner val="true"/>
		<VisibleToAlly val="true"/>
		<VisibleToEnemy val="true"/>
		<!-- Icon: the user's pick, #4 from the icon gallery - a white plus, tinted green
		     (a tint multiplies, so white becomes exactly the tint colour). -->
		<Frame type="Image" name="Icon">
			<Anchor relative="$parent"/>
			<Texture val="@UI/Storm_UI_Play_RandomHero_Button_Icon_Active_Healer"/>
			<Color val="FFD24A"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Animation name="Low">
			<Event event="TargetLifeFull" action="Reset,Play"/>
			<Controller type="Visibility" end="Pause" frame="Icon">
				<Key type="Bool" time="0" value="true"/>
			</Controller>
		</Animation>
		<Animation name="NotLow">
			<Event event="NoState" action="Reset,Play"/>
			<Controller type="Visibility" end="Pause" frame="Icon">
				<Key type="Bool" time="0" value="false"/>
			</Controller>
		</Animation>
	</Frame>

	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverHeroOverviewPanel">
					<Frame type="Frame" name="Team1HeroOverview">
						<Frame type="Frame" name="HeroOverview1"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview2"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview3"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview4"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview5"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
					</Frame>
					<Frame type="Frame" name="Team2HeroOverview">
						<Frame type="Frame" name="HeroOverview1"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview2"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview3"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview4"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
						<Frame type="Frame" name="HeroOverview5"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeLowHealth" template="FCJH_Probe_Health/FCJH_ProbeLowHealthTemplate"/><Frame type="UnitStatusValidatorAnimElement" name="FCJH_ProbeFullHealth" template="FCJH_Probe_Health/FCJH_ProbeFullHealthTemplate"/></Frame></Frame>
					</Frame>
				</Frame>
			</Frame>
		</Frame>
	</Frame>
</Desc>
