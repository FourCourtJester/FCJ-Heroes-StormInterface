<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Replay controls, in the top-right corner (layout.toml element.replay; user, 2026-10-16;
	     on red's row before), collapsible. Narrowed to #FCJH_REPLAY_W (native 420), from when
	     it stood on red's row by the map alerts: everything in Blizzard's panel hangs off its
	     BackgroundImage's edges and middle, so it closes up with it.

	     Collapse: FCJH_ReplayToggle, a copy of Blizzard's own (ToggleControlObserverTools in
	     stormobserverpanel.stormlayout: fade, and a 300-unit slide) sliding in from the RIGHT,
	     since the box sits in the top-right corner (user, 2026-10-16) - Blizzard's slides from
	     the left, and its keys can't be changed in an override. Blizzard's toggle loses its key,
	     so only ours moves the panel. Ours is #FCJH_REPLAY_KEY (layout.toml [toggles]
	     replay): Blizzard's Ctrl+Shift+O is the game's UI editor's Save All, so it never reaches
	     the interface, and an interface's own GameHotkeys.txt can't move Save All off it (user,
	     2026-10-16). The toggle starts off while the panel shows, so the first press only
	     "showed" it: FCJH_ReplaySeen switches it on when a replay first shows the panel, as
	     Ahli 0.75 does.

	     The timeline (its chevron, or Ctrl+T) hides by collapsing ProgressSlider, which the art's
	     top hangs off, so the box shrinks from its top; FCJH_TimelineLift raises the panel as far
	     (gen.py REPLAY_TIMELINE) so the top stays in the corner (user, 2026-10-16).

	     While it's collapsed, a slim tab shows flush in the screen's top-right corner - the box
	     itself keeps the [screen] padding (element.replay_collapsed; user, 2026-10-16) - so the
	     operator can see it's there and how to bring it back. The tab watches the panel's
	     visibility; its pieces fade rather than the tab hiding itself, so its watcher keeps
	     running. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverToggleControls">
					<Frame type="ToggleControl" name="ToggleControlObserverTools">
						<Shortcut val=""/>
					</Frame>
					<Frame type="ToggleControl" name="FCJH_ReplayToggle">
						<Anchor relative="$parent"/>
						<AcceptsMouse val="false"/>
						<CollapseLayout val="true"/>
						<Shortcut val="#FCJH_REPLAY_KEY"/>
						<Visible val="false"/>
						<Animation name="FCJH_ToggleReplayPanel">
							<Event event="OnShown" action="Reset,Play"/>
							<Event event="OnHidden" action="DirectionReverse,Play"/>
							<Controller type="Fade" end="Pause" frame="$parent/$parent/ObserverPanelMovingContainer/ReplayPanel">
								<Key type="Curve" time="0.0" value="0"/>
								<Key type="Curve" time="0.2" value="255"/>
							</Controller>
							<Controller type="Anchor" end="Pause" side="Left" relative="true" frame="$parent/$parent/ObserverPanelMovingContainer/ReplayPanel">
								<Key type="Curve" time="0.0" value="300" inout="Linear"/>
								<Key type="Curve" time="0.2" value="0" inout="Slow,Linear"/>
							</Controller>
							<Controller type="Visibility" end="Pause" frame="$parent/$parent/ObserverPanelMovingContainer/ReplayPanel">
								<Key type="Bool" time="0.0" value="false"/>
								<Key type="Bool" time="0.001" value="true"/>
								<Key type="Bool" time="0.2" value="true"/>
							</Controller>
						</Animation>
					</Frame>
				</Frame>
				<Frame type="MovingFrame" name="ObserverPanelMovingContainer">
					<Frame type="ReplayPanel" name="ReplayPanel">
						<Anchor side="Top"   relative="$GameUI" pos="Min" offset="#FCJH_REPLAY_T"/>
						<Anchor side="Left"  relative="$GameUI" pos="Max" offset="#FCJH_REPLAY_L"/>
						<Anchor side="Right" relative="$this"   pos="Min" offset="0"/>
						<Width val="#FCJH_REPLAY_W"/>
						<Unclipped val="true"/>
						<Frame type="Image" name="BackgroundImage">
							<Width val="#FCJH_REPLAY_W"/>
						</Frame>
						<!-- the bottom row evened out: Slower and Faster chain off Play instead of hugging the
						     middle (gen.py REPLAY_BUTTON_GAP; user, 2026-10-16) -->
						<Frame type="Button" name="DecSpeedButton">
							<Anchor side="Left"  relative="$parent/PlayButton" pos="Max" offset="#FCJH_REPLAY_BUTTON_GAP"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
						</Frame>
						<Frame type="Button" name="IncSpeedButton">
							<Anchor side="Left"  relative="$parent/DecSpeedButton" pos="Max" offset="#FCJH_REPLAY_BUTTON_GAP"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
						</Frame>
					</Frame>
				</Frame>
			</Frame>
		</Frame>

		<Frame type="Frame" name="FCJH_ReplayTab">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_REPLAY_COLLAPSED_T"/>
			<Anchor side="Left"   relative="$parent" pos="Max" offset="#FCJH_REPLAY_COLLAPSED_L"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_REPLAY_COLLAPSED_B"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="#FCJH_REPLAY_COLLAPSED_R"/>
			<AcceptsMouse val="false"/>
			<Frame type="Image" name="FCJH_TabBack">
				<Anchor relative="$parent"/>
				<Texture val="@UI/PauseScreenDimImage"/>
				<ColorAdjustMode val="Fill"/>
				<AdjustmentColor val="220,11,12,20"/>
				<Alpha val="0"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="FCJH_TabLabel">
				<Anchor relative="$parent"/>
				<Style val="ObsBar_MatchTimer"/>
				<Text val="@FCJH/Replay"/>
				<Options val="NoWrapping | ScaleToPreventTruncation"/>
				<Alpha val="0"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<!-- Replays only: in a live observed game the replay panel never shows at all, and the
			     tab mustn't either (user, 2026-09-30). The interface has no "is this a replay"
			     flag, so FCJH_Seen latches the first time the panel is seen, and the tab only
			     shows after that. Leaving a state undoes its actions, so the latch's are
			     undo="false" (Ahli 0.75's way; 2026-10-16) - else hiding the panel dropped it. -->
			<Frame type="Frame" name="FCJH_Seen"><Anchor relative="$parent"/><Visible val="false"/></Frame>
			<StateGroup name="FCJH_ReplaySeen">
				<DefaultState val="NotYet"/>
				<State name="Seen">
					<When type="Property" frame="FCJH_Seen" visible="false"/>
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverPanelMovingContainer/ReplayPanel" Visible="true"/>
					<Action type="SetProperty" frame="FCJH_Seen" visible="true" undo="false"/>
					<Action type="SetProperty" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverToggleControls/FCJH_ReplayToggle" visible="true" undo="false"/>
				</State>
				<State name="NotYet"/>
			</StateGroup>
			<StateGroup name="FCJH_TimelineLift">
				<DefaultState val="Down"/>
				<State name="Lifted">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverPanelMovingContainer/ReplayPanel/ProgressSlider" visible="false"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverPanelMovingContainer/ReplayPanel" side="Top" relative="$GameUI" pos="Min" offset="#FCJH_REPLAY_LIFTED_T"/>
				</State>
				<State name="Down">
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverPanelMovingContainer/ReplayPanel" side="Top" relative="$GameUI" pos="Min" offset="#FCJH_REPLAY_T"/>
				</State>
			</StateGroup>
			<StateGroup name="FCJH_Collapsed">
				<DefaultState val="Open"/>
				<State name="Collapsed">
					<When type="Property" frame="FCJH_Seen" visible="true"/>
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverPanelMovingContainer/ReplayPanel" Visible="false"/>
					<Action type="SetProperty" frame="FCJH_TabBack" Alpha="255"/>
					<Action type="SetProperty" frame="FCJH_TabLabel" Alpha="255"/>
				</State>
				<State name="Open">
					<Action type="SetProperty" frame="FCJH_TabBack" Alpha="0"/>
					<Action type="SetProperty" frame="FCJH_TabLabel" Alpha="0"/>
				</State>
			</StateGroup>
		</Frame>
	</Frame>
</Desc>
