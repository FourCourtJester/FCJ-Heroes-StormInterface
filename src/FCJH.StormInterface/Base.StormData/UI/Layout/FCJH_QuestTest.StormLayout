<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- TEST (2026-10-19), hand-kept, to come out once answered: do the quest tooltips fill from
	     a leader panel set up Ahli 0.75's way (references/AhliObs075 _LeaderPanelBottom
	     TalentOverview, _Ahli HeroLeaderPanelHotkeyHijackFIX)? Blizzard's art only, none of his.
	     Control+Shift+Q shows Blizzard's own Tab panel, talents view, centre screen, with each
	     row's two default-quest icons on a tooltip of its own; hover them. What his has that
	     our tries 3 and 4 didn't: it sits in ConsoleUIContainer, on the screen; its talents
	     view is switched on by its toggle's animation (also at load: Init, then InitEnd back),
	     through a hidden frame the rows' visibility is bound to, not on from the start; and a
	     second panel takes Blizzard's Tab hotkey and passes it on to Blizzard's panel.
	     Try 5 (484d4df): boxes empty. Try 6: Ahli's Handles too, on each row and quest icon,
	     and each tooltip binds the icon's picture through its Handle, as his do: empty.
	     Try 7: the boxes' backing set under their text (510), as his are, in place of the
	     whole tip at 900: empty.
	     Try 8: blue's rows, Ahli's quest tooltip copied child for child (his icon picture,
	     hero portrait, label anchors, progress ring and count, and his quest state copied
	     from the icon), Blizzard's art in place of his; red's rows, no tooltip of ours at
	     all: Blizzard's shared one, as on Blizzard's own Tab panel. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="ConsoleUIContainer">
				<!-- Ahli's: a new leader panel can take the Tab hotkey; this one does, and hands it on -->
				<Frame type="HeroLeaderPanel" name="FCJH_QTestHotkeyFix" template="HeroLeaderPanel/HeroLeaderPanelTemplate">
					<Anchor relative="$parent"/>
					<Frame type="Frame" name="HeroLeaderPanelContainer">
						<Anchor side="Top"    relative="$parent" pos="Max" offset="9999"/>
						<Anchor side="Left"   relative="$parent" pos="Max" offset="9999"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="9999"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="9999"/>
						<Visible val="false"/>
						<Animation name="KeepHidden">
							<Event event="OnShown" action="Reset,Play"/>
							<Controller type="Visibility" end="Pause">
								<Key type="Bool" time="0" value="false"/>
							</Controller>
						</Animation>
						<Animation name="PassShow">
							<Event event="Show" action="Play" frame="$parent"/>
							<Controller type="Event" end="Stop" frame="$GameUI/UIContainer/FullscreenUpperContainer/HeroLeaderPanel">
								<Key type="Event" time="0" event="Show"/>
							</Controller>
						</Animation>
						<Animation name="PassHide">
							<Event event="Hide" action="Play" frame="$parent"/>
							<Controller type="Event" end="Stop" frame="$GameUI/UIContainer/FullscreenUpperContainer/HeroLeaderPanel">
								<Key type="Event" time="0" event="Hide"/>
							</Controller>
						</Animation>
					</Frame>
				</Frame>
				<Frame type="Frame" name="FCJH_QuestTest">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Frame type="ToggleControl" name="FCJH_QuestTestToggle">
						<Anchor relative="$parent"/>
						<Shortcut val="Control+Shift+Q"/>
						<AcceptsMouse val="false"/>
						<CollapseLayout val="true"/>
						<Visible val="false"/>
						<Animation name="FCJH_Show">
							<Event event="OnShown" action="DirectionForward,Play"/>
							<Event event="OnHidden" action="DirectionReverse,Play"/>
							<Event event="Init" action="DirectionForward,Play"/>
							<Event event="InitEnd" action="DirectionReverse,Play"/>
							<Controller type="Fade" end="Pause" frame="$parent/FCJH_QuestTestPanel">
								<Key type="Curve" time="0" value="0"/>
								<Key type="Curve" time="0.1" value="50"/>
								<Key type="Curve" time="0.25" value="255"/>
							</Controller>
							<Controller type="Anchor" end="Pause" frame="$parent/FCJH_QuestTestPanel" side="Top" relative="true">
								<Key type="Curve" time="0" value="4400" inout="Fast"/>
								<Key type="Curve" time="0.001" value="0" inout="Fast"/>
							</Controller>
							<Controller type="Anchor" end="Pause" frame="$parent/FCJH_QuestTestPanel" side="Bottom" relative="true">
								<Key type="Curve" time="0" value="4400" inout="Fast"/>
								<Key type="Curve" time="0.001" value="0" inout="Fast"/>
							</Controller>
							<Controller type="Visibility" end="Pause" frame="$parent/FCJH_QuestTestPanel/HeroLeaderPanelContainer/TabControl/FCJH_TalentsOn">
								<Key type="Bool" time="0" value="false"/>
								<Key type="Bool" time="0.001" value="true"/>
								<Key type="Bool" time="0.25" value="true"/>
							</Controller>
						</Animation>
					</Frame>
					<Frame type="HeroLeaderPanel" name="FCJH_QuestTestPanel" template="HeroLeaderPanel/HeroLeaderPanelTemplate">
						<Anchor relative="$parent"/>
						<Visible val="true"/>
						<RenderPriority val="600"/>
						<Frame type="BaselineQuestTooltip" name="FCJH_QTestTip0A" template="StandardTooltip/BaselineTooltipTemplate">
							<Frame type="Image" name="BackgroundColorImage"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BackgroundGradientImage"><RenderPriority val="510"/></Frame>
							<Frame type="BlurFrame" name="BlurBackground"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BottomBorder"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TipGradient"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TopBorder"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="HeroPortrait">
								<Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
								<Height val="50"/>
								<Texture val="{$FCJH_QTestRow0/PlayerHeroIconFrame/HeroIconImage/@Texture}"/>
								<RenderPriority val="511"/>
							</Frame>
							<Frame type="Image" name="IconImage">
								<Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
								<Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
								<Width val="50"/>
								<Height val="50"/>
								<Texture val="{$FCJH_QTestIcon0A/IconImage/@Texture}"/>
								<RenderPriority val="511"/>
							</Frame>
							<Frame type="Label" name="NameLabel">
								<Anchor side="Top" relative="$parent" pos="Min" offset="25"/>
								<Anchor side="Left" relative="$parent/IconImage" pos="Max" offset="0"/>
								<Anchor side="Right" relative="$parent/HeroPortrait" pos="Min" offset="0"/>
							</Frame>
							<Frame type="Label" name="CooldownLabel">
								<Anchor side="Left" relative="$parent" pos="Min" offset="31"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-30"/>
							</Frame>
							<Frame type="Label" name="DescriptionLabel">
								<Anchor side="Left" relative="$parent" pos="Min" offset="31"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-30"/>
							</Frame>
							<Frame type="Frame" name="BottomFrame">
								<Anchor side="Left" relative="$parent" pos="Min" offset="30"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-30"/>
							</Frame>
							<Frame type="Image" name="UnfilledProgressImage"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/><Unclipped val="true"/><RenderPriority val="535"/><Alpha val="42"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_Progress_Bar_Background"/></Frame>
							<Frame type="ProgressBar" name="QuestProgressBar"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/>
								<Unclipped val="true"/><RenderPriority val="536"/><Vertical val="False"/><Circular val="true"/>
								<CircularStart val="0"/><CircularEndOffset val="360"/><FillInset val="0.0"/><Visible val="False"/>
								<MaxValue val="{$FCJH_QTestIcon0A/QuestProgressBar/@MaxValue}"/>
								<Value val="{$FCJH_QTestIcon0A/QuestProgressBar/@Value}"/>
								<Frame type="Frame" name="FillImageContainer"><Anchor relative="$parent"/>
									<Frame type="Image" name="FillImage"><Anchor relative="$parent"/><Unclipped val="true"/><TextureType val="Circular"/><RenderPriority val="536"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_Quest_Progress_Bar"/></Frame>
								</Frame>
							</Frame>
							<Frame type="Image" name="QuestCompleteImage"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/><Unclipped val="true"/><RenderPriority val="537"/><Visible val="False"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_QuestComplete"/></Frame>
							<Frame type="Label" name="QuestProgressStackLabel">
								<Anchor side="Top" relative="$parent/QuestProgressBar" pos="Max" offset="-2"/>
								<Anchor side="Left" relative="$parent/QuestProgressBar" pos="Min" offset="0"/>
								<Height val="20"/><Style val="Storm_LeaderTalentQuestStack"/><Visible val="false"/>
								<RenderPriority val="538"/><Unclipped val="true"/>
								<Text val="{$FCJH_QTestIcon0A/QuestProgressBar/@Value}"/>
							</Frame>
							<StateGroup name="BaselineQuestProgress">
								<DefaultState val="NoQuest"/>
								<State name="HasQuest">
									<When type="Property" frame="$FCJH_QTestIcon0A" QuestProgress="QuestInProgress"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="True"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="HasUntrackedQuest">
									<When type="Property" frame="$FCJH_QTestIcon0A" QuestProgress="ProgressUntracked"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="FinishedQuest">
									<When type="Property" frame="$FCJH_QTestIcon0A" QuestProgress="FinishedQuest"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="True"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="False"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="70"/>
								</State>
								<State name="FinishedUnlimitedQuest">
									<When type="Property" frame="$FCJH_QTestIcon0A" QuestProgress="FinishedUnlimitedQuest"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="True"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="NoQuest">
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="False"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="False"/>
								</State>
							</StateGroup>
						</Frame>
						<Frame type="BaselineQuestTooltip" name="FCJH_QTestTip0B" template="StandardTooltip/BaselineTooltipTemplate">
							<Frame type="Image" name="BackgroundColorImage"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BackgroundGradientImage"><RenderPriority val="510"/></Frame>
							<Frame type="BlurFrame" name="BlurBackground"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BottomBorder"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TipGradient"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TopBorder"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="HeroPortrait">
								<Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
								<Height val="50"/>
								<Texture val="{$FCJH_QTestRow0/PlayerHeroIconFrame/HeroIconImage/@Texture}"/>
								<RenderPriority val="511"/>
							</Frame>
							<Frame type="Image" name="IconImage">
								<Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
								<Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
								<Width val="50"/>
								<Height val="50"/>
								<Texture val="{$FCJH_QTestIcon0B/IconImage/@Texture}"/>
								<RenderPriority val="511"/>
							</Frame>
							<Frame type="Label" name="NameLabel">
								<Anchor side="Top" relative="$parent" pos="Min" offset="25"/>
								<Anchor side="Left" relative="$parent/IconImage" pos="Max" offset="0"/>
								<Anchor side="Right" relative="$parent/HeroPortrait" pos="Min" offset="0"/>
							</Frame>
							<Frame type="Label" name="CooldownLabel">
								<Anchor side="Left" relative="$parent" pos="Min" offset="31"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-30"/>
							</Frame>
							<Frame type="Label" name="DescriptionLabel">
								<Anchor side="Left" relative="$parent" pos="Min" offset="31"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-30"/>
							</Frame>
							<Frame type="Frame" name="BottomFrame">
								<Anchor side="Left" relative="$parent" pos="Min" offset="30"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-30"/>
							</Frame>
							<Frame type="Image" name="UnfilledProgressImage"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/><Unclipped val="true"/><RenderPriority val="535"/><Alpha val="42"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_Progress_Bar_Background"/></Frame>
							<Frame type="ProgressBar" name="QuestProgressBar"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/>
								<Unclipped val="true"/><RenderPriority val="536"/><Vertical val="False"/><Circular val="true"/>
								<CircularStart val="0"/><CircularEndOffset val="360"/><FillInset val="0.0"/><Visible val="False"/>
								<MaxValue val="{$FCJH_QTestIcon0B/QuestProgressBar/@MaxValue}"/>
								<Value val="{$FCJH_QTestIcon0B/QuestProgressBar/@Value}"/>
								<Frame type="Frame" name="FillImageContainer"><Anchor relative="$parent"/>
									<Frame type="Image" name="FillImage"><Anchor relative="$parent"/><Unclipped val="true"/><TextureType val="Circular"/><RenderPriority val="536"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_Quest_Progress_Bar"/></Frame>
								</Frame>
							</Frame>
							<Frame type="Image" name="QuestCompleteImage"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/><Unclipped val="true"/><RenderPriority val="537"/><Visible val="False"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_QuestComplete"/></Frame>
							<Frame type="Label" name="QuestProgressStackLabel">
								<Anchor side="Top" relative="$parent/QuestProgressBar" pos="Max" offset="-2"/>
								<Anchor side="Left" relative="$parent/QuestProgressBar" pos="Min" offset="0"/>
								<Height val="20"/><Style val="Storm_LeaderTalentQuestStack"/><Visible val="false"/>
								<RenderPriority val="538"/><Unclipped val="true"/>
								<Text val="{$FCJH_QTestIcon0B/QuestProgressBar/@Value}"/>
							</Frame>
							<StateGroup name="BaselineQuestProgress">
								<DefaultState val="NoQuest"/>
								<State name="HasQuest">
									<When type="Property" frame="$FCJH_QTestIcon0B" QuestProgress="QuestInProgress"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="True"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="HasUntrackedQuest">
									<When type="Property" frame="$FCJH_QTestIcon0B" QuestProgress="ProgressUntracked"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="FinishedQuest">
									<When type="Property" frame="$FCJH_QTestIcon0B" QuestProgress="FinishedQuest"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="True"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="False"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="70"/>
								</State>
								<State name="FinishedUnlimitedQuest">
									<When type="Property" frame="$FCJH_QTestIcon0B" QuestProgress="FinishedUnlimitedQuest"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="True"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="NoQuest">
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="False"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="False"/>
								</State>
							</StateGroup>
						</Frame>
						<Frame type="BaselineQuestTooltip" name="FCJH_QTestTip1A" template="StandardTooltip/BaselineTooltipTemplate">
							<Frame type="Image" name="BackgroundColorImage"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BackgroundGradientImage"><RenderPriority val="510"/></Frame>
							<Frame type="BlurFrame" name="BlurBackground"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BottomBorder"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TipGradient"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TopBorder"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="HeroPortrait">
								<Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
								<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
								<Height val="50"/>
								<Texture val="{$FCJH_QTestRow1/PlayerHeroIconFrame/HeroIconImage/@Texture}"/>
