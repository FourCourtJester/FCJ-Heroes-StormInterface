									<Style val="PartyFrame_HeroicTalentCooldown"/>
									<Options val="NoWrapping | ScaleToPreventTruncation"/>
									<Alpha val="0"/>
									<Unclipped val="true"/>
									<AcceptsMouse val="false"/>
								</Frame>
								<StateGroup name="FCJH_Cooldown">
									<DefaultState val="Ready"/>
									<!-- Tracer: never "on cooldown" - her charge meter shows instead
									     (talent_row_lifts; it read as permanently greyed out, 2026-09-30) -->
									<State name="Charge">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame9/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/TracerChargeContainer/TracerPulseBombChargeFrame" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>

									<State name="DeathwingCataclysm">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame9/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/FCJH_Kit_DeathwingCataclysm/AbilIcon/CooldownLabel" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="80"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="true"/>
									</State>
									<State name="HeroDeathwingReady">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus" Unit="HeroDeathwing"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>
									<State name="DeathwingDragonflightUnitReady">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus" Unit="DeathwingDragonflightUnit"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>
									<State name="Cooldown">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame9/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/UnitStatusAbil/AbilIcon/CooldownLabel" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="80"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="true"/>
									</State>
									<State name="Ready">
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>
								</StateGroup>
								<StateGroup name="FCJH_ReadyGlow">
									<DefaultState val="No"/>
									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5/HeroicTalentPanel/HeroicTalentFrame_Ready" Visible="true"/><Action type="SetProperty" frame="$this/FCJH_UltReady" Alpha="255"/></State>
									<State name="No"><Action type="SetProperty" frame="$this/FCJH_UltReady" Alpha="0"/></State>
								</StateGroup>
							</Frame>

						</Frame>
