						</State>
						<State name="Done">
							<When type="Property" frame="Shown" visible="true"/>
						</State>
						<State name="Waiting">
							<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon1" operator="NotEqual" TalentTierState="TierSelected"/>
