									<State name="OlafDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview1/HeroDeathTimeVikingOlafLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="BaleogDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview1/HeroDeathTimeVikingBaleogLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="ErikDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview1/HeroDeathTimeVikingErikLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="No"><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="255"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="255"/></State>
