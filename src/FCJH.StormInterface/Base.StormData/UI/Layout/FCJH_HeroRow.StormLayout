						</State>
						<State name="Rearm">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview4/HeroStatus/FCJH_HealthyMark" visible="true"/>
							<Action type="SetProperty" frame="FCJH_Armed" visible="true"/>
