<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StyleFile>
	<!-- Info-pane stats tables: every heading, team total and value centred on its column,
	     so they line up whatever the number's width. Blizzard's own value styles are
	     left-justified and swapped at runtime by its best-value animations, so the panes
	     draw their numbers with these instead. Colours are Blizzard's observer ones
	     (ColorObsLightBlue/Red, ...2, GlowColorObsLight...). -->
	<Style name="FCJH_StatHeading" template="HeaderExtendedTemplate" height="15" textcolor="8fa3c8" vjustify="Middle" hjustify="Center" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatValue_Blue" template="HeaderExtendedTemplate" height="20" textcolor="55a9f8" vjustify="Middle" hjustify="Center" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatValue_Red" template="HeaderExtendedTemplate" height="20" textcolor="e0668f" vjustify="Middle" hjustify="Center" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatTotal_Blue" template="HeaderExtendedTemplate" height="21" textcolor="d2f1ff" vjustify="Middle" hjustify="Center" styleflags="!Shadow|Glow|!Uppercase" glowcolor="2669e4"/>
	<Style name="FCJH_StatTotal_Red" template="HeaderExtendedTemplate" height="21" textcolor="ffe2e8" vjustify="Middle" hjustify="Center" styleflags="!Shadow|Glow|!Uppercase" glowcolor="e42626"/>
	<Style name="FCJH_StatTeam_Blue" template="HeaderExtendedTemplate" height="15" textcolor="55a9f8" vjustify="Middle" hjustify="Left" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatTeam_Red" template="HeaderExtendedTemplate" height="15" textcolor="e0668f" vjustify="Middle" hjustify="Left" styleflags="!Shadow|!Glow|!Uppercase"/>
</StyleFile>
