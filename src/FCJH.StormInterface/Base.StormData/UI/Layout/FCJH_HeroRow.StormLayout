							<Anchor side="Top"    relative="$parent/$parent/$parent" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$parent/$parent/$parent" pos="Max" offset="0"/>
							<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
							<Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm"/>
							<Tiled val="true" index="0"/>
							<Tiled val="true" index="1"/>
							<Tiled val="true" index="2"/>
							<Tiled val="true" index="3"/>
							<Tiled val="true" index="4"/>
							<Unclipped val="true"/>
						</Frame>
						<Frame type="UnitTargetFrame" name="FCJH_Target">
							<Anchor relative="$parent"/>
							<AllowTargeting val="false"/>
							<AllowSelection val="true"/>
							<AllowCameraCentering val="true"/>
							<AllowSmartCommand val="false"/>
							<Unclipped val="true"/>
							<RenderPriority val="610"/>
						</Frame>
					</Frame>
					<Frame type="UnitStatusFrame" name="TrackedUnitStatusFrame2">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="88"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="136"/>
						<Unclipped val="true"/>
						<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
							<Anchor side="Top"    relative="$parent/$parent/$parent" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$parent/$parent/$parent" pos="Max" offset="0"/>
							<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
							<Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm"/>
							<Tiled val="true" index="0"/>
							<Tiled val="true" index="1"/>
							<Tiled val="true" index="2"/>
							<Tiled val="true" index="3"/>
							<Tiled val="true" index="4"/>
							<Unclipped val="true"/>
						</Frame>
						<Frame type="UnitTargetFrame" name="FCJH_Target">
							<Anchor relative="$parent"/>
							<AllowTargeting val="false"/>
							<AllowSelection val="true"/>
							<AllowCameraCentering val="true"/>
							<AllowSmartCommand val="false"/>
							<Unclipped val="true"/>
							<RenderPriority val="610"/>
						</Frame>
					</Frame>
			</Frame>
			<!-- Misha's bar: not shown (user, 2026-09-30 - she can't be selected, and it adds
			     little); HeightOverride below keeps Rexxar's bar full height -->
			<Frame type="UnitStatusUnitTrackingBehavior" name="RexxarTrackingElement">
				<Alpha val="0"/>
				<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
				<Width val="0"/>
				<Frame type="UnitStatusFrame" name="TrackedUnitStatusFrame0">
					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Frame type="UnitStatusShieldedHealthBar" name="HealthBar"><Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm"/><Tiled val="true" index="0"/><Tiled val="true" index="1"/><Tiled val="true" index="2"/><Tiled val="true" index="3"/><Tiled val="true" index="4"/></Frame>
				</Frame>
			</Frame>
			<Frame type="Image" name="FCJH_HealthBacking">
				<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="32"/>
				<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="56"/>
				<Anchor side="Right" relative="$parent/$parent" pos="Min" offset="190"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="82"/>
				<Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFrame"/>
				<TextureType val="Nineslice"/>
				<Width val="0"/>
				<Height val="0"/>
				<RenderPriority val="450"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Image" name="FCJH_ManaBacking">
				<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="40"/>
				<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="71"/>
				<Anchor side="Right" relative="$parent/$parent" pos="Min" offset="196"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="82"/>
				<Texture val="@UI/HUD_TopBar_Team_HeroFrame_ManaFrame"/>
				<TextureType val="Nineslice"/>
				<Width val="0"/>
				<Height val="0"/>
				<RenderPriority val="450"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="UnitStatusEnergyBar" name="FCJH_Resource">
				<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="46"/>
				<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="74"/>
				<Anchor side="Right" relative="$parent/$parent" pos="Min" offset="193"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="80"/>
				<Width val="0"/>
				<Height val="0"/>
				<Texture val="@UI/HUD_TopBar_Team_HeroFrame_ManaFill"/>
				<Tiled val="true"/>
				<BarCount val="1"/>
				<ColorStyle val="StandardEnergy" index="0"/>
				<Unclipped val="true"/>
			</Frame>
			<!-- CC: Blizzard's nameplate debuff element as an invisible SENSOR (it ships at
			     Alpha 0 and only fades in on a world-nameplate event observer cells never get).
			     Inside HeroStatus, so it reads this cell's own hero. Its text - "STUNNED",
			     "ROOTED"... - is mirrored into our own label. Recipe from build 50. -->
			<Frame type="UnitStatusBuffDebuffElement" name="FCJH_CC" template="UnitStatus/UnitStatusBuffDebuffDisplayTemplate">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="34"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="56"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Max" offset="0"/>
				<CollapseLayout val="true"/>
				<VisibleToOwner val="true"/>
				<VisibleToAlly val="true"/>
				<VisibleToEnemy val="true"/>
				<Unclipped val="true"/>
			</Frame>
			<!-- The text sits across the health bar (HeroStatus is the bar's rect), centred on it
			     both ways; the box reaches past the bar above and below, so the text can be taller
			     than the bar, but not sideways: UNSTOPPABLE ran under the heroic icon (2026-09-30),
			     and now scales down to the bar's width instead. -->
			<Frame type="Label" name="FCJH_CCText">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="-20"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="20"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
				<Text val="{$parent/FCJH_CC/DebuffLabel/@Text}"/>
				<Style val="FCJH_CCText"/>
				<Options val="NoWrapping | ScaleToPreventTruncation"/>
				<RenderPriority val="530"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<!-- ...and its icon, mirrored the same way, centred in the portrait. Shown only while
			     Blizzard's own ICON is (not merely the element): when a CC ends, Blizzard's
			     NoState hides its icon and label but the element stays up for its ~1 s fade, and
			     the icon's default picture is @UI/Editor/BorderImage - a thin black box, seen in
			     game 2026-09-29 (matching the label's text against "" never fired). -->
			<Frame type="Image" name="FCJH_CCIcon">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="12"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Mid" offset="-13"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="46"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Mid" offset="21"/>
				<Texture val="{$parent/FCJH_CC/DebuffIconLeft/@Texture}"/>
				<Alpha val="0"/>
				<RenderPriority val="530"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
				<StateGroup name="FCJH_WhenCC">
					<DefaultState val="None"/>
					<State name="CC">
						<When type="Property" frame="$parent/FCJH_CC" Visible="true"/>
						<When type="Property" frame="$parent/FCJH_CC/DebuffIconLeft" Visible="true"/>
						<When type="Property" frame="$parent/FCJH_CloneSensor" Visible="false"/>
						<Action type="SetProperty" frame="$this" Alpha="255"/>
						<Action type="SetProperty" frame="$parent/FCJH_CCText" Alpha="255"/>
					</State>
					<State name="None">
						<Action type="SetProperty" frame="$this" Alpha="0"/>
						<Action type="SetProperty" frame="$parent/FCJH_CCText" Alpha="0"/>
					</State>
				</StateGroup>
			</Frame>
			<StateGroup name="FCJH_ResourceColour">
				<DefaultState val="Normal"/>
				<State name="Auriel"><When type="Property" Unit="HeroAuriel"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Chen"><When type="Property" Unit="HeroChen"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Deathwing"><When type="Property" Unit="HeroDeathwing"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DeathwingEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="DVaPilot"><When type="Property" Unit="HeroDVaPilot"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="DVaMech"><When type="Property" Unit="HeroDVaMech"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Junkrat"><When type="Property" Unit="HeroJunkrat"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="true" index="0"/><Action type="SetProperty" frame="FCJH_Resource" SegmentValue="1"/></State>
				<State name="Morales"><When type="Property" Unit="HeroMedic"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Sonya"><When type="Property" Unit="HeroBarbarian"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Tracer"><When type="Property" Unit="HeroTracer"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="StandardEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="true" index="0"/><Action type="SetProperty" frame="FCJH_Resource" SegmentValue="2"/></State>
				<State name="Valeera"><When type="Property" Unit="HeroValeera"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="VolskayaGunner"><When type="Property" Unit="VolskayaVehicleGunner"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Zarya"><When type="Property" Unit="HeroZarya"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Gazlowe"><When type="Property" Unit="HeroTinker"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="true" index="0"/><Action type="SetProperty" frame="FCJH_Resource" SegmentValue="1"/></State>
				<State name="Hogger"><When type="Property" Unit="HeroHogger"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="RageEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
				<State name="Normal"><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="StandardEnergy"/><Action type="SetProperty" frame="FCJH_Resource" Segmented="false" index="0"/></State>
			</StateGroup>
			<!-- Fountain (user, 2026-10-06): the inspect card's - Blizzard's buff slot with the
			     fountain's art in its slanted mask; bright when ready, dimmed on cooldown with the
			     seconds left. On the health bar's top edge at the plate's outer end, against its
			     edge (fountain_rect). -->
			<Frame type="Frame" name="FCJH_Fountain">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="31"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Min" offset="16"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="57"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Min" offset="61"/>
				<RenderPriority val="525"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
				<Frame type="Frame" name="ImageMaskContainer">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="9"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="28"/>
					<Anchor side="Right"  relative="$parent" pos="Min" offset="36"/>
					<AlphaMaskTexture val="@UI/HUD_TopBar_Team_HeroFrame_Ult_Bg"/>
					<Unclipped val="true"/>
					<!-- a dark purple backdrop, in the same mask; it keeps its colour on cooldown -->
					<Frame type="Image" name="FCJH_Backdrop">
						<Anchor relative="$parent"/>
						<Texture val="_Assets\Textures\FCJH_White.dds"/>
						<Color val="42,24,70"/>
						<IgnoreParentAlpha val="true"/>
						<RenderPriority val="525"/>
						<Unclipped val="true"/>
						<AcceptsMouse val="false"/>
					</Frame>
					<!-- exactly the mask's box: drawn bigger (45 in 40, as on the inspect card), the
					     overhang went unmasked - a thin purple line (user, 2026-10-06 13:16) -->
					<Frame type="Image" name="IconImage">
						<Anchor relative="$parent"/>
						<Texture val="@UI/Storm_UI_Ingame_HealingWell_Active"/>
						<!-- the middle of the art only, as on the inspect card -->
						<TextureCoords top="0.2" left="0.2" bottom="0.8" right="0.8"/>
						<RenderPriority val="526"/>
						<Unclipped val="true"/>
						<AcceptsMouse val="false"/>
					</Frame>
				</Frame>
				<Frame type="Image" name="IconImageBg">
					<Anchor relative="$parent"/>
					<Texture val="@UI/Storm_UI_InGame_Buff_Background"/>
					<TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
					<RenderPriority val="527"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<StateGroup name="FCJH_Fountain">
					<DefaultState val="Ready"/>
					<!-- on cooldown only the art dims: the slot's frame stays lit, or it read as a
					     number on a dulled-out icon (user, 2026-10-06) -->
					<State name="Cooldown">
						<When type="Property" frame="$parent/FCJH_FountainSensor" Visible="true"/>
						<Action type="SetProperty" frame="$this/ImageMaskContainer/IconImage" Alpha="60"/>
					</State>
					<State name="Ready">
						<Action type="SetProperty" frame="$this/ImageMaskContainer/IconImage" Alpha="255"/>
					</State>
				</StateGroup>
			</Frame>
			<!-- ...and Blizzard's fountain behaviour icon (hero console) on it: present only while
			     the fountain is on cooldown. Its own pictures are off; it lends the fountain its
			     countdown (the game fills a CooldownLabel in a behaviour icon) -->
			<Frame type="UnitStatusBehaviorIcon" name="FCJH_FountainSensor">
				<Anchor relative="$parent/FCJH_Fountain"/>
				<Behavior val="HealingFountainCooldown"/>
				<RenderPriority val="531"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
				<AcceptsMouseTooltip val="false"/>
				<Frame type="BehaviorIcon" name="BehaviorIcon" template="BehaviorBar/BehaviorIconTemplate">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
					<Frame type="Frame" name="ImageMaskContainer"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="Image" name="IconImageBg"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="Label" name="StackLabel"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="ProgressBar" name="QuestProgressBar"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="ProgressBar" name="CooldownBar"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="Image" name="BGFlashImage"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="Label" name="CooldownLabel">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="2"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="5"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="-7"/>
						<Style val="FCJH_FountainCooldown"/>
						<Options val="NoWrapping | ScaleToPreventTruncation"/>
						<RenderPriority val="531"/>
						<Unclipped val="true"/>
					</Frame>
				</Frame>
			</Frame>
			<!-- Abathur's clone (Ultimate Evolution; 2026-09-27). Blizzard puts
			     AbathurUltimateEvolutionVehicleCasterBehavior on Abathur when the clone spawns
			     (UltimateEvolutionCastSet, WhichUnit Source) and removes it when the clone ends;
			     an interrupted cast doesn't reach it. Same sensor trick as the fountain. While it's
			     on: the portrait mirrors (FCJH_ClonePortrait, in the cell), the Ultimate Evolution
			     icon sits where the death timer does, and "CLONE" runs across the health bar.
			     The bar itself stays Abathur's: nothing links him to the clone unit (his only unit
			     tracker is the Monstrosity's). -->
			<Frame type="UnitStatusBehaviorIcon" name="FCJH_CloneSensor">
				<Anchor relative="$parent"/>
				<Behavior val="AbathurUltimateEvolutionVehicleCasterBehavior"/>
				<Alpha val="0"/>
				<AcceptsMouse val="false"/>
				<AcceptsMouseTooltip val="false"/>
				<Frame type="BehaviorIcon" name="BehaviorIcon" template="BehaviorBar/BehaviorIconTemplate">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
				</Frame>
			</Frame>
			<Frame type="Image" name="FCJH_CloneIcon">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="12"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Mid" offset="-13"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="46"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Mid" offset="21"/>
				<Texture val="Assets\Textures\storm_ui_icon_abathur_ultimateevolution.dds"/>
				<Alpha val="0"/>
				<RenderPriority val="531"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="FCJH_CloneText">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="-20"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="-20"/>
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="20"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="20"/>
				<Text val="CLONE"/>
				<Style val="FCJH_CCText"/>
				<Alpha val="0"/>
				<RenderPriority val="531"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<StateGroup name="FCJH_Clone">
				<DefaultState val="None"/>
				<State name="Clone">
					<When type="Property" frame="$this/FCJH_CloneSensor" Visible="true"/>
					<Action type="SetProperty" frame="$this/FCJH_CloneIcon" Alpha="255"/>
					<Action type="SetProperty" frame="$this/FCJH_CloneText" Alpha="255"/>
					<Action type="SetProperty" frame="$parent/FCJH_ClonePortrait" Alpha="255"/>
				</State>
				<State name="None">
					<Action type="SetProperty" frame="$this/FCJH_CloneIcon" Alpha="0"/>
					<Action type="SetProperty" frame="$this/FCJH_CloneText" Alpha="0"/>
					<Action type="SetProperty" frame="$parent/FCJH_ClonePortrait" Alpha="0"/>
				</State>
			</StateGroup>
			<!-- Vikings: the plate's own click target steps aside so each Viking's (inside this
			     frame, which sits under the plate's target in the cell) gets the click -->
			<!-- Blizzard's own, with "Present" (Misha up) no longer halving Rexxar's bar. All three
			     states restated, so it's right whether the engine merges or replaces the group. -->
			<StateGroup name="HeightOverride">
				<DefaultState val="Default"/>
				<State name="Default">
					<When type="Property" frame="$this/RexxarTrackingElement" Visible="False"/>
					<When type="Property" frame="$this/VikingTrackingElement" Visible="False"/>
					<Action type="SetAnchor" frame="$this/HealthBar" side="Bottom" relative="$parent" pos="Max" offset="0"/>
				</State>
				<State name="Present">
					<When type="Property" frame="$this/RexxarTrackingElement" Visible="True"/>
					<Action type="SetAnchor" frame="$this/HealthBar" side="Bottom" relative="$parent" pos="Max" offset="0"/>
				</State>
				<State name="Vikings">
					<When type="Property" frame="$this/VikingTrackingElement" Visible="True"/>
					<Action type="SetAnchor" frame="$this/HealthBar" side="Bottom" relative="$parent" pos="Min" offset="0"/>
					<Action type="SetProperty" frame="$this/HealthBar" Visible="False"/>
					<Action type="SetProperty" frame="$this/HealthBar" RenderType="Offscreen"/>
					<Action type="SetProperty" frame="$this/HealthBar" Alpha="0"/>
				</State>
			</StateGroup>
			<StateGroup name="FCJH_VikingClicks">
				<DefaultState val="Plate"/>
				<State name="Vikings">
					<When type="Property" frame="$this/VikingTrackingElement" Visible="true"/>
					<Action type="SetProperty" frame="$parent/TargetHeroUnitFrame" Visible="false"/>
				</State>
				<State name="Plate">
					<Action type="SetProperty" frame="$parent/TargetHeroUnitFrame" Visible="true"/>
				</State>
			</StateGroup>
			<!-- What the hero carries (user, 2026-10-12): Blizzard's map stack - doubloons, the
			     Spider Queen's gems - in the fountain's slot one step up the slant, the count over
			     its icon; shown from 1 (carry_rect, CARRY_MAPS) -->
			<Frame type="UnitStatusBehaviorIcon" name="FCJH_Carry">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="8"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Min" offset="1"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="34"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Min" offset="46"/>
				<Behavior val="MapMechanicStack"/>
				<Alpha val="0"/>
				<RenderPriority val="525"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
				<AcceptsMouseTooltip val="false"/>
				<Frame type="BehaviorIcon" name="BehaviorIcon" template="BehaviorBar/BehaviorIconTemplate">
					<Anchor relative="$parent"/>
					<MinStackCountDisplayed val="1"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
					<Frame type="Frame" name="ImageMaskContainer">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="9"/>
						<Width val="28"/>
						<Height val="28"/>
						<AlphaMaskTexture val="@UI/HUD_TopBar_Team_HeroFrame_Ult_Bg"/>
						<Unclipped val="true"/>
						<Frame type="Image" name="FCJH_Backdrop">
							<Anchor relative="$parent"/>
							<Texture val="_Assets\Textures\FCJH_White.dds"/>
							<Color val="42,24,70"/>
							<RenderPriority val="511"/>
							<Unclipped val="true"/>
							<AcceptsMouse val="false"/>
						</Frame>
						<!-- the mask's size exactly: the template's 45 in 40 overhangs it (the fountain) -->
						<Frame type="Image" name="IconImage">
							<Width val="28"/>
							<Height val="28"/>
							<Unclipped val="true"/>
						</Frame>
					</Frame>
					<Frame type="Image" name="IconImageBg">
						<Anchor relative="$parent"/>
						<TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
						<Unclipped val="true"/>
					</Frame>
					<Frame type="Label" name="StackLabel">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="2"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="5"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="-7"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
						<Style val="FCJH_FountainCooldown"/>
						<Options val="NoWrapping | ScaleToPreventTruncation"/>
						<Unclipped val="true"/>
					</Frame>
					<Frame type="ProgressBar" name="QuestProgressBar"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="ProgressBar" name="CooldownBar"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="Image" name="BGFlashImage"><Visible val="false"/><Alpha val="0"/></Frame>
					<Frame type="Label" name="BuffLabel"><Visible val="false"/><Alpha val="0"/></Frame>
				</Frame>
			</Frame>
			<!-- ...shown on CARRY_MAPS only, by the map id: a group in a frame that's always shown -->
			<Frame type="Frame" name="FCJH_CarryGate">
				<Anchor relative="$parent"/>
				<AcceptsMouse val="false"/>
				<StateGroup name="FCJH_CarryMaps">
					<DefaultState val="Off"/>
					<State name="blackhearts_bay"><When type="Property" frame="$GameUI/FCJH_MapId" StringValue="BlackheartsBay"/><Action type="SetProperty" frame="$parent/FCJH_Carry" Alpha="255"/></State>
					<State name="tomb_of_the_spider_queen"><When type="Property" frame="$GameUI/FCJH_MapId" StringValue="Crypts"/><Action type="SetProperty" frame="$parent/FCJH_Carry" Alpha="255"/></State>
					<State name="Off"><Action type="SetProperty" frame="$parent/FCJH_Carry" Alpha="0"/></State>
				</StateGroup>
			</Frame>
			<!-- Heal pop-ups: the health sensor (tools/gen.py health_sensor) -->
			<Frame type="UnitStatusHealthLabel" name="FCJH_HPPercent">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="-2"/>
				<Width val="60"/>
				<ShowPercent val="true"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
				<Frame type="Label" name="StatusLabel">
					<Anchor relative="$parent"/>
					<Style val="ObsBar_MatchTimer"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
				</Frame>
			</Frame>
			<Frame type="Frame" name="FCJH_LowMark"><Anchor relative="$parent"/><Visible val="false"/></Frame>
			<Frame type="Frame" name="FCJH_HealthyMark"><Anchor relative="$parent"/><Visible val="false"/></Frame>
			<Frame type="Frame" name="FCJH_ClearMark"><Anchor relative="$parent"/><Visible val="false"/></Frame>
