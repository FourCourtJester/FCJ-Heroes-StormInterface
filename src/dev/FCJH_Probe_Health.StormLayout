<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): critical-health marker, second attempt (2026-09-26).

	     First attempt parked: Blizzard's low-life validator elements don't run in observer
	     cells. This one reads Blizzard's health PERCENT label instead (UnitStatusHealthLabel,
	     ShowPercent - the same element their core bars use), placed inside each cell's
	     HeroStatus so it reads that cell's hero.
	       - the percent label sits at the right end of each health bar, INVISIBLE: it's only
	         a sensor (its text drives the plus). The user doesn't want a percent on the
	         plates in the final product (2026-09-27)
	       - label comparisons are STRING compares, so the trigger lists every value: 1-25,
	         with and without "%". A match shows the green plus (#4) centred on the portrait.
	     FCJH_HealthyMark (round 3): a second flag, set only at 26-100%, so the heal pop-up
	     rearms on real recovery, not on a flicker of the critical one.
	     FCJH_CritMark (2026-09-29): a hidden flag that follows the critical state, for the
	     heal pop-ups (FCJH_Probe_HealPop) to watch. The plus itself no longer shows - the
	     pop-up replaces it (user, 2026-09-29) - so its states only drive the flag.
	     Look for: nothing here; see FCJH_Probe_HealPop. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverHeroOverviewPanel">
				<Frame type="Frame" name="Team1HeroOverview">
					<Frame type="Frame" name="HeroOverview1"><Frame type="UnitStatusFrame" name="HeroStatus">
							<Frame type="UnitStatusHealthLabel" name="FCJH_HPPercent">
								<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
								<Anchor side="Right"  relative="$parent" pos="Max" offset="-2"/>
								<Width val="60"/>
								<ShowPercent val="true"/>
								<Unclipped val="true"/>
								<Frame type="Label" name="StatusLabel">
									<Anchor relative="$parent"/>
									<Style val="ObsBar_MatchTimer"/>
									<Alpha val="0"/>  <!-- a sensor only: its text drives the plus; not shown (user, 2026-09-27) -->
									<Unclipped val="true"/>
								</Frame>
							</Frame>
							<Frame type="Frame" name="FCJH_HealthyMark"><Anchor relative="$parent"/><Visible val="false"/></Frame>
							<Frame type="Frame" name="FCJH_HealthyWatch">
								<Anchor relative="$parent"/>
								<AcceptsMouse val="false"/>
								<StateGroup name="FCJH_Healthy">
									<DefaultState val="No"/>
									<State name="Ok26pc"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="26%"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok26"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="26"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok27pc"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="27%"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok27"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="27"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok28pc"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="28%"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok28"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="28"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok29pc"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="29%"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok29"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="29"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
									<State name="Ok30pc"><When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="30%"/><Action type="SetProperty" frame="$parent/FCJH_HealthyMark" visible="true"/></State>
