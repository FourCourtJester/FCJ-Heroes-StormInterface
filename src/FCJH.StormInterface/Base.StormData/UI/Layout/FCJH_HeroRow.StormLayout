								<Text val="{$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview4/HeroDeathTimeVikingBaleogLabel/@Text}"/>
								<StateGroup name="FCJH_Shown">
									<DefaultState val="No"/>
