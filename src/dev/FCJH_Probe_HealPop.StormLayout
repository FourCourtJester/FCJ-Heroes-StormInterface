<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): heal pop-ups, round 8 (2026-09-30). Written by a one-off script.

	     Spec (user, 2026-09-27/29): the talent pop-up's spot and motion - slide up from the
	     plate's middle to its top edge - with a green plus in a green border; since round 5 it
	     STAYS while the hero is at 25% or less and fades out when they're healed past 25% or die;
	     fires when a hero drops to 25% health or less; leaves early once they're back above
	     25%; a talent pop-up draws over it. Dead heroes get none (their percent isn't 1-25).
	     The trigger is the health probe's critical-health state (FCJH_Probe_Health), which
	     now also flips a hidden flag, HeroStatus/FCJH_CritMark; a watcher per plate fires the
	     pop-up once per dip.
	     Look for: a hero dropping to 25% or less - the green square sliding up out of the
	     plate and sitting on its top edge; it vanishing early if they're healed above 25%. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="FCJH_HealPopups">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<RenderPriority val="520"/>
			<Frame type="Frame" name="FCJH_Heal0">
				<Anchor side="Top"   relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="#FCJH_HERO_POPUP_T"/>
				<Anchor side="Left"  relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_L"/>
				<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_R"/>
				<Height val="#FCJH_HERO_POPUP_SIZE"/>
				<Visible val="false"/>
				<AcceptsMouse val="false"/>
				<!-- round 5: the content fades out (0.75 s) when the hero is healed past 25% or dies;
				     a new pop-up resets it -->
				<Frame type="Frame" name="FCJH_Body">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Animation name="Leave">
						<Event event="FCJH_Leave" action="Reset,Play"/>
						<Event event="FCJH_Pop" action="Reset,Stop" frame="$parent"/>
						<Controller type="Fade" end="Pause">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.75" value="0"/>
						</Controller>
					</Animation>
					<Frame type="Image" name="FCJH_Back">
						<Anchor relative="$parent"/>
						<Texture val="@UI/PauseScreenDimImage"/>
						<ColorAdjustMode val="Fill"/>
						<AdjustmentColor val="235,8,24,12"/>
						<AcceptsMouse val="false"/>
					</Frame>
					<Frame type="Image" name="FCJH_Plus">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="3"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="3"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="-3"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="-3"/>
						<Texture val="@UI/Storm_UI_Play_RandomHero_Button_Icon_Active_Healer"/>
						<Color val="60,255,90"/>
						<AcceptsMouse val="false"/>
					</Frame>
					<!-- 1 unit outside the box: measured in game, the talent pop-up's square shows ~42 px
					     wide on its 40 px icon (Blizzard's art sits inside its -5..+5 frame); ours at -5..+5
					     drew 48 px (2026-09-29) -->
					<Frame type="Image" name="FCJH_Border">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="-1"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="-1"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="1"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="1"/>
						<Texture val="_Assets\Textures\FCJH_PopBorder_Heal.dds"/>
						<Unclipped val="true"/>
						<AcceptsMouse val="false"/>
					</Frame>
				</Frame>
				<!-- round 5 (user): no timed exit - it slides in and stays while the hero is at 25% or
				     less; FCJH_Body fades it out on recovery or death -->
				<Animation name="Pop">
					<Event event="FCJH_Pop" action="Restart,Play"/>
					<Controller type="Visibility" end="Pause">
						<Key type="Bool" time="0" value="true"/>
					</Controller>
					<Controller type="Anchor" end="Pause" side="Top" relative="true">
						<Key type="Curve" time="0" value="38" inout="Slow"/>
						<Key type="Curve" time="0.35" value="0" inout="Slow"/>
					</Controller>
					<Controller type="Fade" end="Pause">
						<Key type="Curve" time="0" value="0"/>
						<Key type="Curve" time="0.25" value="255"/>
					</Controller>
				</Animation>
			</Frame>
			<Frame type="Frame" name="FCJH_HealWatch0">
				<Anchor relative="$parent"/>
				<AcceptsMouse val="false"/>
				<Frame type="Frame" name="Shown"><Anchor relative="$parent"/><Visible val="false"/></Frame>
				<Frame type="Frame" name="FCJH_Settled"><Anchor relative="$parent"/><Visible val="false"/></Frame>
				<!-- round 7: the 1 s timer runs HERE, on the always-visible watcher, and flips FCJH_Settled.
				     In round 6 it ran on FCJH_Settled itself - a hidden frame, whose animation never
				     advances - so "healed" never came and no pop-up cleared (2026-09-30). -->
				<Animation name="Settle">
					<Event event="FCJH_Settle" action="Reset,Play"/>
					<Event event="FCJH_Cancel" action="Reset,Stop"/>
					<Controller type="Visibility" end="Pause" frame="FCJH_Settled">
						<Key type="Bool" time="0" value="false"/>
						<Key type="Bool" time="1.0" value="true"/>
					</Controller>
				</Animation>
				<!-- round 8: after a pop-up leaves, this plate rests 4.0 s before it can pop again - the
				     duration-based guard (user, 2026-09-30) on top of the sticky logic -->
				<Frame type="Frame" name="FCJH_Rest"><Anchor relative="$parent"/><Visible val="false"/></Frame>
				<Animation name="Rest">
					<Event event="FCJH_Rest" action="Reset,Play"/>
					<Controller type="Visibility" end="Pause" frame="FCJH_Rest">
						<Key type="Bool" time="0" value="true"/>
						<Key type="Bool" time="4.0" value="false"/>
					</Controller>
				</Animation>
				<StateGroup name="Crit">
					<DefaultState val="Hold"/>
					<!-- Shows on a drop to 25% or less and STAYS until the hero dies or has read healthy (26-100%)
					     for 1 s straight. Both health flags flicker as the percent changes, so:
					       - any reading that isn't healthy cancels the 1 s timer (round 7 only cancelled on a
					         critical reading; a moment with neither flag let the timer run out, and the next
					         flicker of "healthy" then read as healed - the come-and-go, 2026-09-30)
					       - FCJH_Settled is cleared by hand whenever the timer restarts or stops, in case
					         Reset alone doesn't put its visibility back
					       - after leaving, FCJH_Rest blocks a new pop-up for 4.0 s -->
					<State name="Fire">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1/HeroStatus/FCJH_CritMark" visible="true"/>
						<When type="Property" frame="Shown" visible="false"/>
						<When type="Property" frame="FCJH_Rest" visible="false"/>
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeLabel" visible="false"/>
						<Action type="SetProperty" frame="Shown" visible="true"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SetProperty" frame="$parent/FCJH_Heal0/FCJH_Body" visible="true"/>
						<Action type="SendEvent" frame="$parent/FCJH_Heal0" event="FCJH_Pop"/>
					</State>
					<State name="Died">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeLabel" visible="true"/>
						<When type="Property" frame="Shown" visible="true"/>
						<Action type="SetProperty" frame="Shown" visible="false"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SendEvent" frame="$parent/FCJH_Heal0/FCJH_Body" event="FCJH_Leave"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Rest"/>
					</State>
					<State name="Healed">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1/HeroStatus/FCJH_HealthyMark" visible="true"/>
						<When type="Property" frame="Shown" visible="true"/>
						<When type="Property" frame="FCJH_Settled" visible="true"/>
						<Action type="SetProperty" frame="Shown" visible="false"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SendEvent" frame="$parent/FCJH_Heal0/FCJH_Body" event="FCJH_Leave"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Rest"/>
					</State>
					<State name="MaybeHealed">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1/HeroStatus/FCJH_HealthyMark" visible="true"/>
						<When type="Property" frame="Shown" visible="true"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Settle"/>
					</State>
					<State name="NotHealthy">
						<When type="Property" frame="Shown" visible="true"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
					</State>
					<State name="Hold"/>
				</StateGroup>
			</Frame>
			<Frame type="Frame" name="FCJH_Heal1">
				<Anchor side="Top"   relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2" pos="Min" offset="#FCJH_HERO_POPUP_T"/>
				<Anchor side="Left"  relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_L"/>
				<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_R"/>
				<Height val="#FCJH_HERO_POPUP_SIZE"/>
				<Visible val="false"/>
				<AcceptsMouse val="false"/>
				<!-- round 5: the content fades out (0.75 s) when the hero is healed past 25% or dies;
				     a new pop-up resets it -->
				<Frame type="Frame" name="FCJH_Body">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Animation name="Leave">
						<Event event="FCJH_Leave" action="Reset,Play"/>
						<Event event="FCJH_Pop" action="Reset,Stop" frame="$parent"/>
						<Controller type="Fade" end="Pause">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.75" value="0"/>
						</Controller>
					</Animation>
					<Frame type="Image" name="FCJH_Back">
						<Anchor relative="$parent"/>
						<Texture val="@UI/PauseScreenDimImage"/>
						<ColorAdjustMode val="Fill"/>
						<AdjustmentColor val="235,8,24,12"/>
						<AcceptsMouse val="false"/>
					</Frame>
					<Frame type="Image" name="FCJH_Plus">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="3"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="3"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="-3"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="-3"/>
						<Texture val="@UI/Storm_UI_Play_RandomHero_Button_Icon_Active_Healer"/>
						<Color val="60,255,90"/>
						<AcceptsMouse val="false"/>
					</Frame>
					<!-- 1 unit outside the box: measured in game, the talent pop-up's square shows ~42 px
					     wide on its 40 px icon (Blizzard's art sits inside its -5..+5 frame); ours at -5..+5
					     drew 48 px (2026-09-29) -->
					<Frame type="Image" name="FCJH_Border">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="-1"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="-1"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="1"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="1"/>
						<Texture val="_Assets\Textures\FCJH_PopBorder_Heal.dds"/>
						<Unclipped val="true"/>
						<AcceptsMouse val="false"/>
					</Frame>
				</Frame>
				<!-- round 5 (user): no timed exit - it slides in and stays while the hero is at 25% or
				     less; FCJH_Body fades it out on recovery or death -->
				<Animation name="Pop">
					<Event event="FCJH_Pop" action="Restart,Play"/>
					<Controller type="Visibility" end="Pause">
						<Key type="Bool" time="0" value="true"/>
					</Controller>
					<Controller type="Anchor" end="Pause" side="Top" relative="true">
						<Key type="Curve" time="0" value="38" inout="Slow"/>
						<Key type="Curve" time="0.35" value="0" inout="Slow"/>
					</Controller>
					<Controller type="Fade" end="Pause">
						<Key type="Curve" time="0" value="0"/>
						<Key type="Curve" time="0.25" value="255"/>
					</Controller>
				</Animation>
			</Frame>
			<Frame type="Frame" name="FCJH_HealWatch1">
				<Anchor relative="$parent"/>
				<AcceptsMouse val="false"/>
				<Frame type="Frame" name="Shown"><Anchor relative="$parent"/><Visible val="false"/></Frame>
				<Frame type="Frame" name="FCJH_Settled"><Anchor relative="$parent"/><Visible val="false"/></Frame>
				<!-- round 7: the 1 s timer runs HERE, on the always-visible watcher, and flips FCJH_Settled.
				     In round 6 it ran on FCJH_Settled itself - a hidden frame, whose animation never
				     advances - so "healed" never came and no pop-up cleared (2026-09-30). -->
				<Animation name="Settle">
					<Event event="FCJH_Settle" action="Reset,Play"/>
					<Event event="FCJH_Cancel" action="Reset,Stop"/>
					<Controller type="Visibility" end="Pause" frame="FCJH_Settled">
						<Key type="Bool" time="0" value="false"/>
						<Key type="Bool" time="1.0" value="true"/>
					</Controller>
				</Animation>
				<!-- round 8: after a pop-up leaves, this plate rests 4.0 s before it can pop again - the
				     duration-based guard (user, 2026-09-30) on top of the sticky logic -->
				<Frame type="Frame" name="FCJH_Rest"><Anchor relative="$parent"/><Visible val="false"/></Frame>
				<Animation name="Rest">
					<Event event="FCJH_Rest" action="Reset,Play"/>
					<Controller type="Visibility" end="Pause" frame="FCJH_Rest">
						<Key type="Bool" time="0" value="true"/>
						<Key type="Bool" time="4.0" value="false"/>
					</Controller>
				</Animation>
				<StateGroup name="Crit">
					<DefaultState val="Hold"/>
					<!-- Shows on a drop to 25% or less and STAYS until the hero dies or has read healthy (26-100%)
					     for 1 s straight. Both health flags flicker as the percent changes, so:
					       - any reading that isn't healthy cancels the 1 s timer (round 7 only cancelled on a
					         critical reading; a moment with neither flag let the timer run out, and the next
					         flicker of "healthy" then read as healed - the come-and-go, 2026-09-30)
					       - FCJH_Settled is cleared by hand whenever the timer restarts or stops, in case
					         Reset alone doesn't put its visibility back
					       - after leaving, FCJH_Rest blocks a new pop-up for 4.0 s -->
					<State name="Fire">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2/HeroStatus/FCJH_CritMark" visible="true"/>
						<When type="Property" frame="Shown" visible="false"/>
						<When type="Property" frame="FCJH_Rest" visible="false"/>
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2/HeroDeathTimeLabel" visible="false"/>
						<Action type="SetProperty" frame="Shown" visible="true"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SetProperty" frame="$parent/FCJH_Heal1/FCJH_Body" visible="true"/>
						<Action type="SendEvent" frame="$parent/FCJH_Heal1" event="FCJH_Pop"/>
					</State>
					<State name="Died">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2/HeroDeathTimeLabel" visible="true"/>
						<When type="Property" frame="Shown" visible="true"/>
						<Action type="SetProperty" frame="Shown" visible="false"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SendEvent" frame="$parent/FCJH_Heal1/FCJH_Body" event="FCJH_Leave"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Rest"/>
					</State>
					<State name="Healed">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2/HeroStatus/FCJH_HealthyMark" visible="true"/>
						<When type="Property" frame="Shown" visible="true"/>
						<When type="Property" frame="FCJH_Settled" visible="true"/>
						<Action type="SetProperty" frame="Shown" visible="false"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SendEvent" frame="$parent/FCJH_Heal1/FCJH_Body" event="FCJH_Leave"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Rest"/>
					</State>
					<State name="MaybeHealed">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2/HeroStatus/FCJH_HealthyMark" visible="true"/>
						<When type="Property" frame="Shown" visible="true"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Settle"/>
					</State>
					<State name="NotHealthy">
						<When type="Property" frame="Shown" visible="true"/>
						<Action type="SendEvent" frame="$this" event="FCJH_Cancel"/>
						<Action type="SetProperty" frame="FCJH_Settled" visible="false"/>
					</State>
					<State name="Hold"/>
				</StateGroup>
			</Frame>
			<Frame type="Frame" name="FCJH_Heal2">
				<Anchor side="Top"   relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview3" pos="Min" offset="#FCJH_HERO_POPUP_T"/>
				<Anchor side="Left"  relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview3" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_L"/>
				<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview3" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_R"/>
				<Height val="#FCJH_HERO_POPUP_SIZE"/>
				<Visible val="false"/>
				<AcceptsMouse val="false"/>
				<!-- round 5: the content fades out (0.75 s) when the hero is healed past 25% or dies;
				     a new pop-up resets it -->
				<Frame type="Frame" name="FCJH_Body">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Animation name="Leave">
