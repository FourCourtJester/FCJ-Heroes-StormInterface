				</State>
				<State name="L4">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="4"/>
					<Action type="SetProperty" frame="RedTier" Text="1"/>
				</State>
				<State name="L5">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="5"/>
					<Action type="SetProperty" frame="RedTier" Text="1"/>
				</State>
				<State name="L6">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="6"/>
					<Action type="SetProperty" frame="RedTier" Text="1"/>
				</State>
				<State name="L7">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="7"/>
					<Action type="SetProperty" frame="RedTier" Text="2"/>
				</State>
				<State name="L8">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="8"/>
					<Action type="SetProperty" frame="RedTier" Text="2"/>
				</State>
				<State name="L9">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="9"/>
					<Action type="SetProperty" frame="RedTier" Text="2"/>
				</State>
				<State name="L10">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="10"/>
