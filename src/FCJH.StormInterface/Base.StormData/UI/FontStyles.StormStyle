<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StyleFile>
	<!-- Info-pane stats tables: every heading, team total and value right-aligned in its
	     column, so digits line up and the last column ends on the pane's right margin.
	     All on HeaderExtendedTemplate: Blizzard's own header font (Metronic for Blizzard
	     Bold), the one Ahli's and Spazzo's interfaces use too. Blizzard's own value styles are
	     left-justified and swapped at runtime by its best-value animations, so the panes
	     draw their numbers with these instead. Colours are Blizzard's observer ones
	     (ColorObsLightBlue/Red, ...2, GlowColorObsLight...). -->
	<Style name="FCJH_StatHeading" template="HeaderExtendedTemplate" height="15" textcolor="8fa3c8" vjustify="Middle" hjustify="Right" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatValue_Blue" template="HeaderExtendedTemplate" height="20" textcolor="55a9f8" vjustify="Middle" hjustify="Right" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatValue_Red" template="HeaderExtendedTemplate" height="20" textcolor="e0668f" vjustify="Middle" hjustify="Right" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatTotal_Blue" template="HeaderExtendedTemplate" height="21" textcolor="d2f1ff" vjustify="Middle" hjustify="Right" styleflags="!Shadow|Glow|!Uppercase" glowcolor="2669e4"/>
	<Style name="FCJH_StatTotal_Red" template="HeaderExtendedTemplate" height="21" textcolor="ffe2e8" vjustify="Middle" hjustify="Right" styleflags="!Shadow|Glow|!Uppercase" glowcolor="e42626"/>
	<Style name="FCJH_StatTeam_Blue" template="HeaderExtendedTemplate" height="15" textcolor="55a9f8" vjustify="Middle" hjustify="Left" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_StatTeam_Red" template="HeaderExtendedTemplate" height="15" textcolor="e0668f" vjustify="Middle" hjustify="Left" styleflags="!Shadow|!Glow|!Uppercase"/>
	<!-- Plate CC text ("STUNNED"): Blizzard's TalentChoiceAlertNameplateLabel, but centred
	     vertically too, so it sits across the middle of the health bar. 14, not 17: UNSTOPPABLE
	     overflowed the shorter bar a heroic leaves (2026-09-30) -->
	<Style name="FCJH_CCText" template="HeaderExtendedTemplate" height="14" textcolor="ffffff" hjustify="Center" vjustify="Middle" fontflags="Outline" styleflags="!Shadow"/>
	<!-- Per-Viking / Misha death timer: Blizzard's pet timer, centred both ways in its slice
	     of the plate (Blizzard's own isn't centred there) -->
	<Style name="FCJH_PetDeathTimer" template="Storm_TopBar_DeathTimer_Pet" hjustify="Center" vjustify="Middle"/>
	<!-- Plate heroic token: the "?" before the pick, and the cooldown seconds over the icon -->
	<Style name="FCJH_HeroicMark" template="HeaderExtendedTemplate" height="18" textcolor="e7c8ff" hjustify="Center" vjustify="Middle" fontflags="Outline" styleflags="!Shadow"/>
	<Style name="FCJH_HeroicCooldown" template="HeaderExtendedTemplate" height="15" textcolor="ffffff" hjustify="Center" vjustify="Middle" fontflags="Outline" styleflags="!Shadow"/>
	<!-- Inspect card -->
	<Style name="FCJH_InspectSection" template="HeaderExtendedTemplate" height="12" textcolor="8fa3c8" hjustify="Left" vjustify="Middle" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_InspectName" template="HeaderExtendedTemplate" height="20" textcolor="ffffff" hjustify="Left" vjustify="Middle" fontflags="Outline" styleflags="!Shadow"/>
	<Style name="FCJH_InspectSub" template="HeaderExtendedTemplate" height="13" textcolor="8fa3c8" hjustify="Left" vjustify="Middle" styleflags="!Shadow|!Glow|!Uppercase"/>
	<Style name="FCJH_InspectLevel" template="HeaderExtendedTemplate" height="20" textcolor="e4edff" hjustify="Center" vjustify="Middle" fontflags="Outline" styleflags="!Shadow"/>
	<Style name="FCJH_InspectKey" template="HeaderExtendedTemplate" height="12" textcolor="ffffff" hjustify="Left" vjustify="Bottom" fontflags="Outline" styleflags="!Shadow"/>
	<Style name="FCJH_InspectTier" template="HeaderExtendedTemplate" height="11" textcolor="6f7b96" hjustify="Center" vjustify="Top" styleflags="!Shadow|!Glow|!Uppercase"/>
</StyleFile>
