					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="130,106,122,170"/>
					<RenderPriority val="620"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_BorderLeft">
					<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
					<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_BORDER"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="130,106,122,170"/>
					<RenderPriority val="620"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_BorderRight">
					<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left" relative="$parent" pos="Max" offset="#FCJH_INFO_PANE_BORDER_NEG"/>
					<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="130,106,122,170"/>
					<RenderPriority val="620"/>
					<AcceptsMouse val="false"/>
				</Frame>
			</Frame>
			<Frame type="Button" name="FCJH_Close">
				<Anchor side="Top"   relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<Width val="#FCJH_INFO_PANE_TITLE_H"/>
				<Height val="#FCJH_INFO_PANE_TITLE_H"/>
				<RenderPriority val="650"/>
				<AcceptsMouse val="true"/>
				<Frame type="Label" name="FCJH_X">
					<Anchor relative="$parent"/>
					<Style val="ObsBar_MatchTimer"/>
					<Text val="X"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Animation name="FCJH_Close">
					<Event event="OnClick" action="Reset,Play"/>
					<Controller type="Visibility" end="Stop" frame="$parent/$parent/FCJH_Pane_StructuresToggle">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
				</Animation>
			</Frame>
		</Frame>

		<!-- The hotkeys, all four panes (talents included) -->
		<Frame type="ToggleControl" name="FCJH_Pane_TalentsToggle">
			<Anchor side="Top"  relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
			<Width val="1"/>
			<Height val="1"/>
			<Shortcut val="#FCJH_INFO_PANE_KEY_TALENTS"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
			<Animation name="FCJH_Show">
				<Event event="OnShown" action="DirectionForward,Play"/>
				<Event event="OnHidden" action="DirectionReverse,Play"/>
				<Controller type="Visibility" end="Pause" frame="$parent/FCJH_Pane_Talents">
					<Key type="Bool" time="0" value="false"/>
					<Key type="Bool" time="0.001" value="true"/>
				</Controller>
				<Controller type="Fade" end="Pause" frame="$parent/FCJH_Pane_Talents">
					<Key type="Curve" time="0" value="0"/>
					<Key type="Curve" time="0.15" value="255"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Only">
				<Event event="OnShown" action="Reset,Play"/>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_KdaToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_HealingToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_StructuresToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
			</Animation>
		</Frame>
		<Frame type="ToggleControl" name="FCJH_Pane_KdaToggle">
			<Anchor side="Top"  relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
			<Width val="1"/>
			<Height val="1"/>
			<Shortcut val="#FCJH_INFO_PANE_KEY_KDA"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
			<Animation name="FCJH_Show">
				<Event event="OnShown" action="DirectionForward,Play"/>
				<Event event="OnHidden" action="DirectionReverse,Play"/>
				<Controller type="Visibility" end="Pause" frame="$parent/FCJH_Pane_Kda">
					<Key type="Bool" time="0" value="false"/>
					<Key type="Bool" time="0.001" value="true"/>
				</Controller>
				<Controller type="Fade" end="Pause" frame="$parent/FCJH_Pane_Kda">
					<Key type="Curve" time="0" value="0"/>
					<Key type="Curve" time="0.15" value="255"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Only">
				<Event event="OnShown" action="Reset,Play"/>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_TalentsToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_HealingToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_StructuresToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
			</Animation>
		</Frame>
		<Frame type="ToggleControl" name="FCJH_Pane_HealingToggle">
			<Anchor side="Top"  relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
			<Width val="1"/>
			<Height val="1"/>
			<Shortcut val="#FCJH_INFO_PANE_KEY_HEALING"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
			<Animation name="FCJH_Show">
				<Event event="OnShown" action="DirectionForward,Play"/>
				<Event event="OnHidden" action="DirectionReverse,Play"/>
				<Controller type="Visibility" end="Pause" frame="$parent/FCJH_Pane_Healing">
					<Key type="Bool" time="0" value="false"/>
					<Key type="Bool" time="0.001" value="true"/>
				</Controller>
				<Controller type="Fade" end="Pause" frame="$parent/FCJH_Pane_Healing">
					<Key type="Curve" time="0" value="0"/>
					<Key type="Curve" time="0.15" value="255"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Only">
				<Event event="OnShown" action="Reset,Play"/>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_TalentsToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_KdaToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_StructuresToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
			</Animation>
		</Frame>
		<Frame type="ToggleControl" name="FCJH_Pane_StructuresToggle">
			<Anchor side="Top"  relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
			<Width val="1"/>
			<Height val="1"/>
			<Shortcut val="#FCJH_INFO_PANE_KEY_STRUCTURES"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
			<Animation name="FCJH_Show">
				<Event event="OnShown" action="DirectionForward,Play"/>
				<Event event="OnHidden" action="DirectionReverse,Play"/>
				<Controller type="Visibility" end="Pause" frame="$parent/FCJH_Pane_Structures">
					<Key type="Bool" time="0" value="false"/>
					<Key type="Bool" time="0.001" value="true"/>
				</Controller>
				<Controller type="Fade" end="Pause" frame="$parent/FCJH_Pane_Structures">
					<Key type="Curve" time="0" value="0"/>
					<Key type="Curve" time="0.15" value="255"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Only">
				<Event event="OnShown" action="Reset,Play"/>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_TalentsToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_KdaToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_HealingToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
			</Animation>
		</Frame>
	</Frame>
</Desc>
