				</State>
				<State name="L17">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="17"/>
					<Action type="SetProperty" frame="BlueTier" Text="5"/>
				</State>
				<State name="L18">
