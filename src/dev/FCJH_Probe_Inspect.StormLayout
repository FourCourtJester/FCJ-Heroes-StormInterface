								<Anchor relative="$parent"/>
								<Style val="FCJH_HeroicCooldown"/>
								<RenderPriority val="700"/>
								<Animation name="FCJH_Dim">
									<Event event="OnShown" action="DirectionForward,Play"/>
									<Event event="OnHidden" action="DirectionReverse,Play"/>
									<Controller type="Color" end="Pause" frame="$parent/IconImage">
										<Key type="Curve" time="0" value="255,255,255" inout="Step"/>
										<Key type="Curve" time="0.01" value="70,70,70" inout="Step"/>
									</Controller>
								</Animation>
							</Frame>
							<Frame type="ProgressBar" name="CooldownBar"><Anchor relative="$parent"/><Alpha val="0"/></Frame>
