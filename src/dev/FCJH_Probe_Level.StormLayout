					<Action type="SetProperty" frame="BlueTier" Text="6"/>
				</State>
				<State name="L26">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="26"/>
					<Action type="SetProperty" frame="BlueTier" Text="6"/>
				</State>
				<State name="L27">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="27"/>
					<Action type="SetProperty" frame="BlueTier" Text="6"/>
				</State>
				<State name="L28">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1LevelLabel" Text="28"/>
					<Action type="SetProperty" frame="BlueTier" Text="6"/>
				</State>
				<State name="L29">
