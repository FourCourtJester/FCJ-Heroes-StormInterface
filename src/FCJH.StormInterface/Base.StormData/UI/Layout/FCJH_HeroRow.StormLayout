										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus" side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="11"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_HealthBacking" side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="3"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_ManaBacking" side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="3"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_Resource" side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="6"/>
										<Action type="SetProperty" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/HealthBar" Texture="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm_Right"/>
										<Action type="SetProperty" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_Resource" Texture="@UI/HUD_TopBar_Team_HeroFrame_ManaFill_Right"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/VikingTrackingElement/TrackedUnitStatusFrame0" side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="11"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/VikingTrackingElement/TrackedUnitStatusFrame0" side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="54"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/VikingTrackingElement/TrackedUnitStatusFrame1" side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="56"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/VikingTrackingElement/TrackedUnitStatusFrame1" side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="99"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/VikingTrackingElement/TrackedUnitStatusFrame2" side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="101"/>
										<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/VikingTrackingElement/TrackedUnitStatusFrame2" side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="144"/>
									</State>
								</StateGroup>
								<!-- cooldown: the hidden bar's own count never showed for observers (2026-09-30),
								     so a second source - our ability sensor in this plate's HeroStatus
								     (FCJH_HeroicAbil, below) - can trigger the same dim-and-count -->
								<Frame type="Label" name="FCJH_UltCooldown2">
									<Anchor side="Left"   relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="-1"/>
									<Anchor side="Top"    relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="41"/>
									<Anchor side="Right"  relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="61"/>
									<Anchor side="Bottom" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="75"/>
									<Text val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_HeroicAbil/AbilIcon/CooldownLabel/@Text}"/>
									<Style val="PartyFrame_HeroicTalentCooldown"/>
									<Options val="NoWrapping | ScaleToPreventTruncation"/>
									<Alpha val="0"/>
									<Unclipped val="true"/>
									<AcceptsMouse val="false"/>
								</Frame>
								<StateGroup name="FCJH_Cooldown">
									<DefaultState val="Ready"/>
									<State name="Cooldown">
										<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5/HeroicTalentPanel/HeroicTalentCooldownLabel" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown2" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="80"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="true"/>
									</State>
									<State name="CooldownSensor">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_HeroicAbil/AbilIcon/CooldownLabel" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown2" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="80"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="true"/>
									</State>
									<State name="Ready">
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown2" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>
								</StateGroup>
								<StateGroup name="FCJH_ReadyGlow">
									<DefaultState val="No"/>
									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5/HeroicTalentPanel/HeroicTalentFrame_Ready" Visible="true"/><Action type="SetProperty" frame="$this/FCJH_UltReady" Alpha="255"/></State>
									<State name="No"><Action type="SetProperty" frame="$this/FCJH_UltReady" Alpha="0"/></State>
								</StateGroup>
								<StateGroup name="FCJH_Charges">
									<DefaultState val="No"/>
									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5/HeroicTalentPanel/HeroicTalentChargeFillProgress" Visible="true"/><Action type="SetProperty" frame="$this/FCJH_UltCharge" Alpha="255"/></State>
									<State name="No"><Action type="SetProperty" frame="$this/FCJH_UltCharge" Alpha="0"/></State>
								</StateGroup>
							</Frame>
							<Frame type="UnitStatusFrame" name="HeroStatus">
								<!-- the heroic as an invisible ability icon bound to this plate's hero (Ahli's way),
								     given the heroic from the talent pane's row for this player: a cooldown source -->
								<Frame type="UnitStatusAbilIcon" name="FCJH_HeroicAbil">
									<Anchor relative="$parent"/>
									<AbilityLink val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame9/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/@HeroicAbilLink}"/>
									<Alpha val="0"/>
									<AcceptsMouse val="false"/>
									<AcceptsMouseTooltip val="false"/>
									<Frame type="AbilIcon" name="AbilIcon">
										<Anchor relative="$parent"/>
										<Frame type="Image" name="IconImage"><Anchor relative="$parent"/></Frame>
										<Frame type="Label" name="CooldownLabel"><Anchor relative="$parent"/></Frame>
									</Frame>
								</Frame>
							</Frame>
						</Frame>
					</Frame>
				</Frame>
			</Frame>
		</Frame>
	</Frame>
</Desc>
