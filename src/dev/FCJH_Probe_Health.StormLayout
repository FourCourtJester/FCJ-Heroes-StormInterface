							<Frame type="Frame" name="FCJH_CritMark"><Anchor relative="$parent"/><Visible val="false"/></Frame>
							<Frame type="Image" name="FCJH_Crit">
								<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="12"/>
								<Anchor side="Left"   relative="$parent/$parent" pos="Mid" offset="-19"/>
								<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="56"/>
								<Anchor side="Right"  relative="$parent/$parent" pos="Mid" offset="25"/>
								<Texture val="@UI/Storm_UI_Play_RandomHero_Button_Icon_Active_Healer"/>
								<Color val="60,255,90"/>
								<Alpha val="0"/>
								<RenderPriority val="540"/>
								<Unclipped val="true"/>
								<AcceptsMouse val="false"/>
								<StateGroup name="FCJH_Critical">
									<DefaultState val="Fine"/>
									<State name="Crit1pc">
										<When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="1%"/>
										<Action type="SetProperty" frame="$this" Alpha="0"/>
										<Action type="SetProperty" frame="$parent/FCJH_CritMark" visible="true"/>
									</State>
									<State name="Crit1">
