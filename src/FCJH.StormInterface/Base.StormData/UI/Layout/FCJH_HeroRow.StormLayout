				<Tiled val="true"/>
				<BarCount val="1"/>
				<ColorStyle val="StandardEnergy" index="0"/>
				<Unclipped val="true"/>
			</Frame>
			<!-- CC: Blizzard's nameplate debuff element as an invisible SENSOR (it ships at
			     Alpha 0 and only fades in on a world-nameplate event observer cells never get).
			     Inside HeroStatus, so it reads this cell's own hero. Its text - "STUNNED",
			     "ROOTED"... - is mirrored into our own label. Recipe from build 50. -->
			<Frame type="UnitStatusBuffDebuffElement" name="FCJH_CC" template="UnitStatus/UnitStatusBuffDebuffDisplayTemplate">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="28"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="45"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Max" offset="0"/>
				<CollapseLayout val="true"/>
				<VisibleToOwner val="true"/>
				<VisibleToAlly val="true"/>
				<VisibleToEnemy val="true"/>
				<Unclipped val="true"/>
			</Frame>
			<Frame type="Label" name="FCJH_CCText">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="28"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Min" offset="3"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="45"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Max" offset="3"/>
				<Text val="{$parent/FCJH_CC/DebuffLabel/@Text}"/>
				<Style val="TalentChoiceAlertNameplateLabel"/>
				<Options val="NoWrapping | ScaleToPreventTruncation"/>
				<RenderPriority val="530"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<StateGroup name="FCJH_ResourceColour">
				<DefaultState val="Normal"/>
				<State name="Auriel"><When type="Property" Unit="HeroAuriel"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="Chen"><When type="Property" Unit="HeroChen"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="Deathwing"><When type="Property" Unit="HeroDeathwing"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DeathwingEnergy"/></State>
				<State name="DVaPilot"><When type="Property" Unit="HeroDVaPilot"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="DVaMech"><When type="Property" Unit="HeroDVaMech"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="Junkrat"><When type="Property" Unit="HeroJunkrat"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/></State>
				<State name="Morales"><When type="Property" Unit="HeroMedic"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="Sonya"><When type="Property" Unit="HeroBarbarian"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/></State>
				<State name="Tracer"><When type="Property" Unit="HeroTracer"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="StandardEnergy"/></State>
				<State name="Valeera"><When type="Property" Unit="HeroValeera"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="VolskayaGunner"><When type="Property" Unit="VolskayaVehicleGunner"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="Zarya"><When type="Property" Unit="HeroZarya"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="Gazlowe"><When type="Property" Unit="HeroTinker"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/></State>
				<State name="Normal"><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="StandardEnergy"/></State>
			</StateGroup>
		</Frame>
