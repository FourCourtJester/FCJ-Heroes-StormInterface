<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Minimap, bottom-centre.

	     Blizzard's MinimapPanel (minimappanel.stormlayout) is 468 x 438 units, its square
	     Minimap child (438 x 438) at the top-left. The engine fits each map's shape inside
	     that square, centred: wide maps draw short, tall maps draw tall. Like Blizzard (who
	     hang it 35 units below the edge), we let the square hang off the bottom of the screen
	     so wide maps sit low.

	     Base anchors are Right + Bottom with a fixed Width; we replace Right and add Left, so
	     both horizontal edges are ours and the width stays 468. Numbers: layout.toml [minimap].

	     This is its place before a map moves it, and on maps that don't (the ARAM maps): each
	     battleground moves it up or down so the map as drawn sits on the padding line, from
	     inside its own panel (FCJH_Maps, tools/maps.py). The map objective widgets aren't part
	     of this panel either: they live in MapMechanicPanel, and FCJH_Maps pins each map's
	     panel to this one. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="ConsoleUIContainer">
				<Frame type="MinimapPanel" name="MinimapPanel">
					<Anchor side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
					<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
					<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_PANEL_BOTTOM"/>
					<!-- A minimap icon's name went to Blizzard's MinimapPanelTooltip, a box anchored in
					     the panel's own corner (Right -500, Bottom -250), left behind when we move the
					     panel. TRIAL (user, 2026-10-15): no tooltip frame named here, to see whether the
					     game then gives the name as its cursor tooltip; if nothing shows, it's off,
					     which the user prefers to the box anyway. -->
					<Frame type="Minimap" name="Minimap">
						<TooltipFrame val=""/>
					</Frame>
				</Frame>
			</Frame>
		</Frame>
	</Frame>
</Desc>
