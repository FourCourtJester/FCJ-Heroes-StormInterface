								<Animation name="FCJH_RespawnFlash">
									<Event event="HeroAlmostRespawnedHero1" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview4"/>
									<Event event="HeroRespawnedHero1" action="Reset,Stop" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview4"/>
									<Controller type="Style" end="Pause" style1="FCJH_PetDeathTimer" style2="FCJH_PetDeathTimer_Respawn">
										<Key type="Curve" time="0" value="1"/>
										<Key type="Curve" time="0.5" value="0"/>
										<Key type="Curve" time="1" value="1"/>
										<Key type="Curve" time="1.5" value="0"/>
										<Key type="Curve" time="2" value="1"/>
										<Key type="Curve" time="2.5" value="0"/>
										<Key type="Curve" time="3" value="1"/>
										<Key type="Curve" time="3.5" value="0"/>
										<Key type="Curve" time="4" value="1"/>
										<Key type="Curve" time="4.5" value="0"/>
										<Key type="Curve" time="5" value="1"/>
										<Key type="Curve" time="5.01" value="1"/>
									</Controller>
								</Animation>
								<Animation name="FCJH_RespawnFlashClear">
									<Event event="HeroRespawnedHero1" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview4"/>
									<Controller type="Style" end="Pause" style1="FCJH_PetDeathTimer" style2="FCJH_PetDeathTimer">
										<Key type="Curve" time="0" value="0"/>
										<Key type="Curve" time=".01" value="0"/>
									</Controller>
								</Animation>
							</Frame>
