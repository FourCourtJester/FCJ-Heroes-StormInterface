											<Frame type="Frame" name="QuestContainerContainerFrame">
												<Unclipped val="true"/>
												<Frame type="ParentCenteredFrame" name="BaseQuestCenterFrame">
													<Unclipped val="true"/>
													<Frame type="UnitStatusBaselineQuestIcon" name="BaseQuestIcon0">
														<Anchor side="Top" relative="$FCJH_QuestCell0" pos="Min" offset="0"/>
														<Anchor side="Left" relative="$FCJH_QuestCell0" pos="Min" offset="0"/>
														<Anchor side="Bottom" relative="$FCJH_QuestCell0" pos="Max" offset="0"/>
														<Anchor side="Right" relative="$FCJH_QuestCell0" pos="Max" offset="0"/>
														<Unclipped val="true"/>
														<RenderPriority val="#RenderPriorityLevel_3"/>
														<Frame type="Image" name="IconBackgroundImage"><Alpha val="0"/></Frame>
														<!-- the border Blizzard's progress ring fills, on heroes with a quest only (user,
														     2026-10-19: without it Murky's fill was a loose bar); none for the rest -->
														<Frame type="Image" name="IconBorderImage"><Alpha val="0"/></Frame>
														<StateGroup name="QuestState">
															<State name="QuestSelected"/>
															<State name="QuestAvailable">
																<Action type="SetProperty" frame="$this/IconImage" texture="@UI/Storm_UI_InGame_Leader_Talent_Unselected"/>
															</State>
															<State name="QuestNotAvailable">
																<Action type="SetProperty" frame="$this/IconImage" visible="false"/>
															</State>
														</StateGroup>
														<StateGroup name="FCJH_QuestBorder">
															<DefaultState val="FCJH_NoQuest"/>
															<State name="FCJH_InProgress">
																<When type="Property" frame="$this" QuestProgress="QuestInProgress"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_Untracked">
																<When type="Property" frame="$this" QuestProgress="ProgressUntracked"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_Finished">
																<When type="Property" frame="$this" QuestProgress="FinishedQuest"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_FinishedUnlimited">
																<When type="Property" frame="$this" QuestProgress="FinishedUnlimitedQuest"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_NoQuest">
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="0"/>
															</State>
														</StateGroup>
													</Frame>
