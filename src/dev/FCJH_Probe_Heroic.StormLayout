				<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview3" pos="Min" offset="#FCJH_HERO_BLUE_HEROIC_R"/>
				<RenderPriority val="560"/>
