				</State>
				<State name="L19">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="19"/>
					<Action type="SetProperty" frame="RedTier" Text="5"/>
				</State>
				<State name="L20">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="20"/>
