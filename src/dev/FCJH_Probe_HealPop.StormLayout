						<Key type="Bool" time="0" value="true"/>
						<Key type="Bool" time="4.0" value="false"/>
					</Controller>
				</Animation>
				<StateGroup name="Crit">
					<DefaultState val="Hold"/>
					<!-- Shows on a drop to 25% or less and STAYS until the hero dies or has read healthy (26-100%)
					     for 1 s straight. Both health flags flicker as the percent changes, so:
					       - any reading that isn't healthy cancels the 1 s timer (round 7 only cancelled on a
					         critical reading; a moment with neither flag let the timer run out, and the next
					         flicker of "healthy" then read as healed - the come-and-go, 2026-09-30)
