<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Blizzard panels we hide by default. Parked off-screen (all four sides pinned), since
	     Visible=false doesn't stick on Blizzard panels.

	       - TargetInfoFrame: the small draggable "inspect" rectangle that shows whatever unit
	         is selected. Hidden until we design an inspect panel of our own. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="TargetInfoFrame" name="TargetInfoFrame">
					<Anchor side="Top"    relative="$GameUI" pos="Min" offset="9999"/>
					<Anchor side="Left"   relative="$GameUI" pos="Min" offset="9999"/>
					<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="10115"/>
					<Anchor side="Right"  relative="$GameUI" pos="Min" offset="10225"/>
				</Frame>
			</Frame>
		</Frame>
	</Frame>
</Desc>
