<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): the inspect pane, first experiment (2026-09-26).

	     A tall hero card in the info-pane box for whatever unit is SELECTED (click a hero's
	     plate). No hotkey yet - the real trigger will be a modifier-click, worked out later;
	     for now the card simply shows while something is selected, like Blizzard's own
	     inspect box. Square panel, none of the slanted plate art.

	     Round 2 (2026-09-26): round 1 showed our copy of the inspect box DOES fill for the
	     selection (portrait, health/resource with numbers and regen, stats), and clicking
	     off the unit hides it; a layout Escape binding fires but can't clear the selection.
	     Blizzard's HUD panels (abilities, buffs, mechanics) only fill in the observer's
	     player-view mode, not for a selection - moved out again, and kept hidden
	     (FCJH_Hidden). What follows is round 1's notes:
	       1. OUR OWN copy of Blizzard's inspect box (a TargetInfoFrame from
	          TargetInfoPanel/TargetInfoPanelTemplate), re-laid out tall: portrait, health and
	          resource with numbers and regen, and the seven stats. THE question: does the
	          engine fill (and show) a second TargetInfoFrame for the selection?
	       2. Blizzard's player-HUD panels, MOVED into the card (they're one-offs, so they
	          can't be copied): abilities (CommandPanel), buffs/debuffs plus the fountain
	          icon (HeroBuffDebuffPanel), hero mechanics (HeroSpecificStatusContainer).
	          They show when the engine decides - in observer, while a hero is selected.
	     Look for: the card top-left when you click a hero plate; which parts appear, which
	     don't, and what's where. Expect overlaps - this is to see what's available. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">

		<!-- 1. Our copy of the inspect box -->
		<Frame type="TargetInfoFrame" name="FCJH_Inspect">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
			<Anchor side="Right"  relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
			<AcceptsMouse val="false"/>
			<RenderPriority val="650"/>

			<Frame type="Image" name="FCJH_Back">
				<Anchor relative="$parent"/>
				<Texture val="@UI/PauseScreenDimImage"/>
				<ColorAdjustMode val="Fill"/>
				<AdjustmentColor val="215,11,12,20"/>
				<RenderPriority val="200"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Image" name="FCJH_TitleBand">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
				<Texture val="@UI/PauseScreenDimImage"/>
				<ColorAdjustMode val="Fill"/>
				<AdjustmentColor val="235,24,28,48"/>
				<RenderPriority val="210"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="FCJH_Title">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
				<Style val="ObsBar_MatchTimer"/>
				<Text val="INSPECT"/>
				<RenderPriority val="215"/>
				<AcceptsMouse val="false"/>
			</Frame>

			<Frame type="Frame" name="TargetInfoPanel" template="TargetInfoPanel/TargetInfoPanelTemplate">
				<Anchor relative="$parent"/>
				<Visible val="{$this/@Enabled}"/>
				<!-- Blizzard's small-box art, off -->
				<Frame type="Image" name="BackgroundFrame"><Alpha val="0"/></Frame>
				<Frame type="Image" name="TopBackground"><Alpha val="0"/></Frame>
				<Frame type="Image" name="BottomBorderImage"><Alpha val="0"/></Frame>
				<Frame type="Image" name="BorderFrame"><Alpha val="0"/></Frame>

				<!-- Portrait: top-left, Blizzard's 128 x 56 shape at 1.75x -->
				<Frame type="Frame" name="TargetPortraitFrame">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="40"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="12"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="138"/>
					<Anchor side="Right"  relative="$parent" pos="Min" offset="236"/>
					<Width val="0"/>
					<Height val="0"/>
					<Frame type="Image" name="TargetPortraitImage">
						<Anchor relative="$parent"/>
						<Width val="0"/>
						<Height val="0"/>
					</Frame>
				</Frame>

				<Frame type="UnitStatusFrame" name="HealthAndManaUnitStatusFrame">
					<!-- Health, right of the portrait, stretched to the card's edge; the resource
					     bars hang under it (they anchor to it) and stretch with it -->
					<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
						<Anchor side="Top"   relative="$parent" pos="Min" offset="48"/>
						<Anchor side="Left"  relative="$parent" pos="Min" offset="250"/>
						<Anchor side="Right" relative="$parent" pos="Max" offset="-14"/>
						<Height val="24"/>
						<Width val="0"/>
					</Frame>
					<Frame type="UnitStatusEnergyBar" name="NormalEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
					<Frame type="UnitStatusEnergyBar" name="OrangeEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
					<Frame type="UnitStatusEnergyBar" name="PinkEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
					<Frame type="UnitStatusEnergyBar" name="YellowEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
					<Frame type="UnitStatusEnergyBar" name="DeathwingEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>

					<!-- Stats: two columns under the portrait -->
					<Frame type="Frame" name="TargetStatsPanel">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="150"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="12"/>
						<Anchor side="Bottom" relative="$parent" pos="Min" offset="260"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="-12"/>
						<Frame type="TargetInfoStatFrame" name="AttackDamageFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="260"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AttackSpeedFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="26"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="260"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AttackRangeFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="52"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="260"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AbilityPowerFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="78"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="260"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="MoveSpeedFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="290"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="260"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="PhysicalArmorFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="26"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="290"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="260"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AbilityArmorFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="52"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="290"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="260"/>
						</Frame>
					</Frame>
				</Frame>
			</Frame>
		</Frame>

	</Frame>
</Desc>
