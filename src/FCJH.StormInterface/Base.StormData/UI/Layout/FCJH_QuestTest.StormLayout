<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- TEST (2026-10-19), hand-kept, to come out once answered: do the quest tooltips fill from
	     a leader panel set up Ahli 0.75's way (references/AhliObs075 _LeaderPanelBottom
	     TalentOverview, _Ahli HeroLeaderPanelHotkeyHijackFIX)? Blizzard's art only, none of his.
	     Control+Shift+Q shows Blizzard's own Tab panel, talents view, centre screen, with each
	     row's two default-quest icons on a tooltip of its own; hover them. What his has that
	     our tries 3 and 4 didn't: it sits in ConsoleUIContainer, on the screen; its talents
	     view is switched on by its toggle's animation (also at load: Init, then InitEnd back),
	     through a hidden frame the rows' visibility is bound to, not on from the start; and a
	     second panel takes Blizzard's Tab hotkey and passes it on to Blizzard's panel.
	     Try 5 (484d4df): boxes empty. Try 6: Ahli's Handles too, on each row and quest icon,
	     and each tooltip binds the icon's picture through its Handle, as his do: empty.
	     Try 7: the boxes' backing set under their text (510), as his are, in place of the
	     whole tip at 900. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="ConsoleUIContainer">
				<!-- Ahli's: a new leader panel can take the Tab hotkey; this one does, and hands it on -->
				<Frame type="HeroLeaderPanel" name="FCJH_QTestHotkeyFix" template="HeroLeaderPanel/HeroLeaderPanelTemplate">
					<Anchor relative="$parent"/>
					<Frame type="Frame" name="HeroLeaderPanelContainer">
						<Anchor side="Top"    relative="$parent" pos="Max" offset="9999"/>
						<Anchor side="Left"   relative="$parent" pos="Max" offset="9999"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="9999"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="9999"/>
						<Visible val="false"/>
						<Animation name="KeepHidden">
							<Event event="OnShown" action="Reset,Play"/>
							<Controller type="Visibility" end="Pause">
								<Key type="Bool" time="0" value="false"/>
							</Controller>
						</Animation>
						<Animation name="PassShow">
							<Event event="Show" action="Play" frame="$parent"/>
							<Controller type="Event" end="Stop" frame="$GameUI/UIContainer/FullscreenUpperContainer/HeroLeaderPanel">
								<Key type="Event" time="0" event="Show"/>
							</Controller>
						</Animation>
						<Animation name="PassHide">
							<Event event="Hide" action="Play" frame="$parent"/>
							<Controller type="Event" end="Stop" frame="$GameUI/UIContainer/FullscreenUpperContainer/HeroLeaderPanel">
								<Key type="Event" time="0" event="Hide"/>
							</Controller>
						</Animation>
					</Frame>
				</Frame>
				<Frame type="Frame" name="FCJH_QuestTest">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Frame type="ToggleControl" name="FCJH_QuestTestToggle">
						<Anchor relative="$parent"/>
						<Shortcut val="Control+Shift+Q"/>
						<AcceptsMouse val="false"/>
						<CollapseLayout val="true"/>
						<Visible val="false"/>
						<Animation name="FCJH_Show">
							<Event event="OnShown" action="DirectionForward,Play"/>
							<Event event="OnHidden" action="DirectionReverse,Play"/>
							<Event event="Init" action="DirectionForward,Play"/>
							<Event event="InitEnd" action="DirectionReverse,Play"/>
							<Controller type="Fade" end="Pause" frame="$parent/FCJH_QuestTestPanel">
								<Key type="Curve" time="0" value="0"/>
								<Key type="Curve" time="0.1" value="50"/>
								<Key type="Curve" time="0.25" value="255"/>
							</Controller>
							<Controller type="Anchor" end="Pause" frame="$parent/FCJH_QuestTestPanel" side="Top" relative="true">
								<Key type="Curve" time="0" value="4400" inout="Fast"/>
								<Key type="Curve" time="0.001" value="0" inout="Fast"/>
							</Controller>
							<Controller type="Anchor" end="Pause" frame="$parent/FCJH_QuestTestPanel" side="Bottom" relative="true">
								<Key type="Curve" time="0" value="4400" inout="Fast"/>
								<Key type="Curve" time="0.001" value="0" inout="Fast"/>
							</Controller>
							<Controller type="Visibility" end="Pause" frame="$parent/FCJH_QuestTestPanel/HeroLeaderPanelContainer/TabControl/FCJH_TalentsOn">
								<Key type="Bool" time="0" value="false"/>
								<Key type="Bool" time="0.001" value="true"/>
								<Key type="Bool" time="0.25" value="true"/>
							</Controller>
						</Animation>
					</Frame>
					<Frame type="HeroLeaderPanel" name="FCJH_QuestTestPanel" template="HeroLeaderPanel/HeroLeaderPanelTemplate">
						<Anchor relative="$parent"/>
						<Visible val="true"/>
						<RenderPriority val="600"/>
						<Frame type="BaselineQuestTooltip" name="FCJH_QTestTip0A" template="StandardTooltip/BaselineTooltipTemplate">
							<!-- try 7, Ahli's: the box's backing under the text (510), not the tip on top -->
							<Frame type="Image" name="BackgroundColorImage"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BackgroundGradientImage"><RenderPriority val="510"/></Frame>
							<Frame type="BlurFrame" name="BlurBackground"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="BottomBorder"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TipGradient"><RenderPriority val="510"/></Frame>
							<Frame type="Image" name="TopBorder"><RenderPriority val="510"/></Frame>
							<!-- Ahli's binding: the icon's picture, through its Handle -->
							<Frame type="Image" name="FCJH_Icon">
								<Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
								<Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
								<Width val="50"/>
								<Height val="50"/>
								<Texture val="{$FCJH_QTestIcon0A/IconImage/@Texture}"/>
								<RenderPriority val="511"/>
							</Frame>
						</Frame>
						<Frame type="BaselineQuestTooltip" name="FCJH_QTestTip0B" template="StandardTooltip/BaselineTooltipTemplate">
