													<!-- the dim, over the heroic's icon (the container is its square; the icon is inset in its
													     backplate's shape, heroic_panel) and under the count -->
													<Frame type="Image" name="FCJH_ChargeDim">
														<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="2"/>
														<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="2"/>
														<Anchor side="Bottom" relative="$parent/$parent" pos="Max" offset="-2"/>
														<Anchor side="Right" relative="$parent/$parent" pos="Max" offset="-2"/>
