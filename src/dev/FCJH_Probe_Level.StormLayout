				</State>
				<State name="L14">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="14"/>
					<Action type="SetProperty" frame="RedTier" Text="4"/>
				</State>
				<State name="L15">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="15"/>
					<Action type="SetProperty" frame="RedTier" Text="4"/>
				</State>
				<State name="L16">
