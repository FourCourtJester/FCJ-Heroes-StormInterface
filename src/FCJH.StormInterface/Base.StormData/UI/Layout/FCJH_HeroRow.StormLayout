							<Frame type="Frame" name="FCJH_VikingDeathWatch">
								<Anchor relative="$parent"/>
								<AcceptsMouse val="false"/>
								<StateGroup name="FCJH_OneDown">
									<DefaultState val="No"/>
									<State name="OlafDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2/HeroDeathTimeVikingOlafLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="BaleogDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2/HeroDeathTimeVikingBaleogLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="ErikDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2/HeroDeathTimeVikingErikLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="No"><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="255"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="255"/></State>
								</StateGroup>
							</Frame>
							<Frame type="Frame" name="FCJH_DeathTimeHold">
								<Animation name="FCJH_RespawnFlash">
									<Event event="HeroAlmostRespawned" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2"/>
									<Event event="HeroRespawned" action="Reset,Stop" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2"/>
									<Event event="OnHidden" action="Reset,Stop" frame="$parent/HeroDeathTimeLabel"/>
									<Controller type="Style" end="Pause" frame="FCJH_DeathTime" style1="Storm_TopBar_DeathTimer" style2="Storm_TopBar_DeathTimer_Respawn">
										<Key type="Curve" time="0" value="1"/>
										<Key type="Curve" time="0.5" value="0"/>
										<Key type="Curve" time="1" value="1"/>
										<Key type="Curve" time="1.5" value="0"/>
										<Key type="Curve" time="2" value="1"/>
										<Key type="Curve" time="2.5" value="0"/>
										<Key type="Curve" time="3" value="1"/>
										<Key type="Curve" time="3.5" value="0"/>
										<Key type="Curve" time="4" value="1"/>
										<Key type="Curve" time="4.5" value="0"/>
										<Key type="Curve" time="5" value="1"/>
										<Key type="Curve" time="5.01" value="1"/>
									</Controller>
								</Animation>
								<Animation name="FCJH_RespawnFlashClear">
									<Event event="HeroRespawned" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2"/>
									<Event event="OnHidden" action="Reset,Play" frame="$parent/HeroDeathTimeLabel"/>
									<Controller type="Style" end="Pause" frame="FCJH_DeathTime" style1="Storm_TopBar_DeathTimer" style2="Storm_TopBar_DeathTimer">
										<Key type="Curve" time="0" value="0"/>
										<Key type="Curve" time=".01" value="0"/>
									</Controller>
								</Animation>
							</Frame>
							<Frame type="Frame" name="FCJH_DeathSkull">
								<Frame type="Image" name="FCJH_RespawnGlow">
									<Animation name="FCJH_RespawnPulse">
										<Event event="HeroAlmostRespawned" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2"/>
										<Event event="HeroRespawned" action="Reset,Stop" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview2"/>
										<Event event="OnHidden" action="Reset,Stop" frame="$parent/$parent/HeroDeathTimeLabel"/>
										<Controller type="Fade" end="Pause">
											<Key type="Curve" time="0" value="255" inout="Linear"/>
											<Key type="Curve" time="0.5" value="0" inout="Linear"/>
											<Key type="Curve" time="1" value="255" inout="Linear"/>
											<Key type="Curve" time="1.5" value="0" inout="Linear"/>
											<Key type="Curve" time="2" value="255" inout="Linear"/>
											<Key type="Curve" time="2.5" value="0" inout="Linear"/>
											<Key type="Curve" time="3" value="255" inout="Linear"/>
											<Key type="Curve" time="3.5" value="0" inout="Linear"/>
											<Key type="Curve" time="4" value="255" inout="Linear"/>
											<Key type="Curve" time="4.5" value="0" inout="Linear"/>
											<Key type="Curve" time="5" value="255" inout="Linear"/>
											<Key type="Curve" time="5.01" value="0" inout="Linear"/>
										</Controller>
									</Animation>
								</Frame>
							</Frame>
