<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): resource bars, round 3 - per-hero colour, Blizzard's way.

	     Round 2 proved the colour styles render (static) and can change at runtime
	     (SetProperty ColorStyle); what failed was a unit check owned by a CHILD frame
	     (frame="$parent" Unit=...). Blizzard's working version - HeroResourceStates in
	     targetinfopanelunitstatustemplate.stormlayout:257 - puts the StateGroup ON the
	     unit-status frame itself, with no frame= on the When. Same here: the group lives on
	     each cell's HeroStatus, with Blizzard's table. Unmatched heroes fall to "Normal"
	     (a state with no When - Blizzard's fallback pattern).
	     Look for: Sonya orange; Auriel and Chen yellow; everyone else mana-blue. -->

	<Frame type="UnitStatusEnergyBar" name="FCJH_ProbeBar">
		<Anchor side="Top"   relative="$parent" pos="Max" offset="14"/>
		<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
		<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
		<Height val="10"/>
		<Texture val="@UI/HUD_TopBar_Team_HeroFrame_ManaFill"/>
		<Tiled val="true"/>
		<BarCount val="1"/>
		<ColorStyle val="StandardEnergy" index="0"/>
		<Unclipped val="true"/>
	</Frame>

	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverHeroOverviewPanel">
					<Frame type="Frame" name="Team1HeroOverview">
						<Frame type="Frame" name="HeroOverview1"><Frame type="UnitStatusFrame" name="HeroStatus"><Frame type="UnitStatusEnergyBar" name="FCJH_ProbeMana" template="FCJH_Probe_Mana/FCJH_ProbeBar"/><StateGroup name="FCJH_ResourceColour"><DefaultState val="Normal"/><State name="Auriel"><When type="Property" Unit="HeroAuriel"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="BrewEnergy"/></State><State name="Chen"><When type="Property" Unit="HeroChen"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="BrewEnergy"/></State><State name="Deathwing"><When type="Property" Unit="HeroDeathwing"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="DeathwingEnergy"/></State><State name="DVaPilot"><When type="Property" Unit="HeroDVaPilot"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="DivaEnergy"/></State><State name="DVaMech"><When type="Property" Unit="HeroDVaMech"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="DivaEnergy"/></State><State name="Junkrat"><When type="Property" Unit="HeroJunkrat"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="FuryEnergy"/></State><State name="Morales"><When type="Property" Unit="HeroMedic"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="BrewEnergy"/></State><State name="Sonya"><When type="Property" Unit="HeroBarbarian"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="FuryEnergy"/></State><State name="Tracer"><When type="Property" Unit="HeroTracer"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="StandardEnergy"/></State><State name="Valeera"><When type="Property" Unit="HeroValeera"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="BrewEnergy"/></State><State name="VolskayaGunner"><When type="Property" Unit="VolskayaVehicleGunner"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="DivaEnergy"/></State><State name="Zarya"><When type="Property" Unit="HeroZarya"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="DivaEnergy"/></State><State name="Gazlowe"><When type="Property" Unit="HeroTinker"/><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="FuryEnergy"/></State><State name="Normal"><Action type="SetProperty" frame="FCJH_ProbeMana" ColorStyle="StandardEnergy"/></State></StateGroup></Frame></Frame>
