							</StateGroup>
						</Frame>
						<!-- red, the bottom slot: the chests spawning (neutral), then Blackheart's cannon on red -->
						<Frame type="Frame" name="FCJH_ChestSpawnFrameSpot">
							<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_CHEST"/>
