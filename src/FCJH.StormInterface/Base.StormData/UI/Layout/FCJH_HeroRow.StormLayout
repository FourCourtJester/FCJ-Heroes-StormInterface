		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverHeroOverviewPanel">
					<!-- Blizzard's top-bar talent rows are anchored to the cells, so they follow
					     them down here. Hidden with Alpha 0, not parked: the talent pop-ups watch
					     their icons, which must stay alive. -->

					<!-- Tracer's charge meter, lifted out of the observer talent row onto our plates (tools/gen.py talent_row_lifts) -->
					<Frame type="Frame" name="TalentsOverview">
						<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
						<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
						<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
						<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
						<AcceptsMouse val="false"/>
						<AcceptsMouseTooltip val="false"/>
						<!-- the game keeps the talent panel hidden: assert it shown every frame (animations
						     outrank properties; FCJH_Hidden's recipe, turned round) -->
						<Animation name="FCJH_KeepRowShown">
							<Event event="OnShown" action="Play"/>
							<Controller type="Visibility" end="Loop" frame="TalentOverview">
								<Key type="Bool" time="0" value="true"/>
							</Controller>
							<Controller type="Visibility" end="Loop" frame="TalentOverview/HeroTalentsPanelContainer">
								<Key type="Bool" time="0" value="true"/>
							</Controller>
						</Animation>
						<Frame type="HeroTalentsPanel" name="TalentOverview">
							<Visible val="true"/>
							<Batch val="false"/>  <!-- batched, it may draw nothing outside its own box -->
							<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
							<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
							<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
							<AcceptsMouse val="false"/>
							<AcceptsMouseTooltip val="false"/>
							<Frame type="Frame" name="HeroTalentsPanelContainer">
								<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
								<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
								<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
								<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
								<AcceptsMouse val="false"/>
								<AcceptsMouseTooltip val="false"/>
							<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame0">
								<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
								<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
								<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
								<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
								<AcceptsMouse val="false"/>
								<AcceptsMouseTooltip val="false"/>
								<Frame type="Frame" name="TalentsContainerFrame">
									<Batch val="false"/>
									<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
									<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
									<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
									<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
									<AcceptsMouse val="false"/>
									<AcceptsMouseTooltip val="false"/>
									<Frame type="SelectionUnitStatusPanel" name="SelectionUnitStatusPanel">
										<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
										<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
										<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
										<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
										<AcceptsMouse val="false"/>
										<AcceptsMouseTooltip val="false"/>
										<Frame type="UnitStatusFrame" name="UnitStatusFrame0">
											<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
											<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
											<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
											<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
											<AcceptsMouse val="false"/>
											<AcceptsMouseTooltip val="false"/>
											<Frame type="PlayerHeroSelectedTalentTreeFrame" name="HeroSelectedTalentTreeFrame">
												<Anchor side="Left" relative="$GameUI" pos="Min" offset="0"/>
												<Anchor side="Top" relative="$GameUI" pos="Min" offset="0"/>
												<Anchor side="Right" relative="$GameUI" pos="Max" offset="0"/>
												<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
												<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon1"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
												<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon2"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
												<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon3"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
												<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon4"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
												<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon5"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
												<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon6"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
												<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon7"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
											</Frame>
											<Frame type="UnitStatusAbilIcon" name="UnitStatusAbil"><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/></Frame>
											<Frame type="UnitStatusAbilIcon" name="FCJH_Kit_DeathwingCataclysm"><Anchor relative="$parent"/><AbilityLink val="DeathwingCataclysm"/><Alpha val="0"/><AcceptsMouse val="false"/><AcceptsMouseTooltip val="false"/><Frame type="AbilIcon" name="AbilIcon"><Anchor relative="$parent"/><Frame type="Image" name="IconImage"><Anchor relative="$parent"/></Frame><Frame type="ProgressBar" name="CooldownBar"><Anchor relative="$parent/IconImage"/><Visible val="false"/></Frame><Frame type="Label" name="CooldownLabel"><Anchor relative="$parent"/><Style val="PartyFrame_HeroicTalentCooldown"/><Visible val="false"/></Frame></Frame></Frame>
											<Frame type="Frame" name="TracerChargeContainer">
												<Anchor side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="125"/>
												<Anchor side="Top" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="35"/>
												<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="184"/>
												<Anchor side="Bottom" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="94"/>
												<Unclipped val="true"/>
												<StateGroup name="FCJH_WithHeroic">
													<DefaultState val="Shown"/>
													<State name="Gone">
														<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroicTalentPanel" Visible="false"/>
														<Action type="SetProperty" frame="$this" Alpha="0"/>
													</State>
													<State name="Shown">
														<Action type="SetProperty" frame="$this" Alpha="255"/>
													</State>
												</StateGroup>
												<!-- Blizzard's own meter here is the observer row's straight fill (it lit the gold frame
												     as an orange border): hidden. The frame stays: heroic_panel reads it -->
												<Frame type="UnitStatusAbilCharge" name="TracerPulseBombChargeFrame">
													<Frame type="ProgressBar" name="ChargeFillProgress"><Alpha val="0"/></Frame>
												</Frame>
												<!-- her HUD's round dial, from its own template, as Ahli's: the observer bar restyled
												     circular never filled (user, 2026-10-16). Its fill drew, but its orange ticks were lost
												     in the orange Pulse Bomb icon (diagnostics, 57474cd), so they're out: the count in the
												     middle, hidden at 0, and the heroic dimmed while charging (user, 2026-10-17). No percent
												     label. The template's ready ping plays at full, though shrunk and faded here: its own
												     animation drives it (seen, user, 2026-10-17) and it stays -->
												<Frame type="UnitStatusAbilCharge" name="FCJH_PulseBombDial" template="Tracer/TracerPulseBombChargeButtonOverrideFrame/UnitStatusFrame0/TracerPulseBombChargeFrame">
													<Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
													<Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
													<Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
													<Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
													<Width val="28"/>
													<Height val="31"/>
													<RenderPriority val="1000"/>
													<Unclipped val="true"/>
													<Frame type="Image" name="TracerPulseBombBackgroundImage"><Alpha val="0"/><Unclipped val="true"/></Frame>
													<!-- the tick ring out: you could barely see it over the art (user, 2026-10-17) -->
													<Frame type="ProgressBar" name="ChargeFillProgress"><Alpha val="0"/></Frame>
													<!-- the dim, over the heroic's icon (the container is its square; the icon is inset in its
													     backplate's shape, heroic_panel) and under the count -->
													<Frame type="Image" name="FCJH_ChargeDim">
														<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="2"/>
														<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="2"/>
														<Anchor side="Bottom" relative="$parent/$parent" pos="Max" offset="-2"/>
														<Anchor side="Right" relative="$parent/$parent" pos="Max" offset="-2"/>
