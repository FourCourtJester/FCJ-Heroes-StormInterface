			</StateGroup>
			<StateGroup name="Lead">
				<State name="BlueLeads1">
					<When type="Property" frame="BlueTier" Text="1" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="RedTier" Text="1" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="true"/>
					<Action type="SetProperty" frame="RedLeads" Visible="false"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="BlueLeads2">
					<When type="Property" frame="BlueTier" Text="2" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="RedTier" Text="2" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="true"/>
					<Action type="SetProperty" frame="RedLeads" Visible="false"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="BlueLeads3">
					<When type="Property" frame="BlueTier" Text="3" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="RedTier" Text="3" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="true"/>
					<Action type="SetProperty" frame="RedLeads" Visible="false"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="BlueLeads4">
					<When type="Property" frame="BlueTier" Text="4" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="RedTier" Text="4" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="true"/>
					<Action type="SetProperty" frame="RedLeads" Visible="false"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="BlueLeads5">
					<When type="Property" frame="BlueTier" Text="5" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="RedTier" Text="5" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="true"/>
					<Action type="SetProperty" frame="RedLeads" Visible="false"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="BlueLeads6">
					<When type="Property" frame="BlueTier" Text="6" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="RedTier" Text="6" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="true"/>
					<Action type="SetProperty" frame="RedLeads" Visible="false"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="RedLeads1">
					<When type="Property" frame="RedTier" Text="1" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="BlueTier" Text="1" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="false"/>
					<Action type="SetProperty" frame="RedLeads" Visible="true"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="RedLeads2">
					<When type="Property" frame="RedTier" Text="2" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="BlueTier" Text="2" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="false"/>
					<Action type="SetProperty" frame="RedLeads" Visible="true"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="RedLeads3">
					<When type="Property" frame="RedTier" Text="3" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="BlueTier" Text="3" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="false"/>
					<Action type="SetProperty" frame="RedLeads" Visible="true"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="RedLeads4">
					<When type="Property" frame="RedTier" Text="4" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="BlueTier" Text="4" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="false"/>
					<Action type="SetProperty" frame="RedLeads" Visible="true"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="RedLeads5">
					<When type="Property" frame="RedTier" Text="5" operator="GreaterThanOrEqual"/>
					<When type="Property" frame="BlueTier" Text="5" operator="LessThan"/>
					<Action type="SetProperty" frame="BlueLeads" Visible="false"/>
					<Action type="SetProperty" frame="RedLeads" Visible="true"/>
					<Action type="SetProperty" frame="Even" Visible="false"/>
				</State>
				<State name="RedLeads6">
