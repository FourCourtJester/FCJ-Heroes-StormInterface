										<Key type="Curve" time="0" value="0"/>
										<Key type="Curve" time=".01" value="0"/>
									</Controller>
								</Animation>
							</Frame>
							<Frame type="Frame" name="FCJH_DeathSkull">
								<Frame type="Image" name="FCJH_RespawnGlow">
									<Animation name="FCJH_RespawnPulse">
										<Event event="HeroAlmostRespawned" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview4"/>
										<Event event="HeroRespawned" action="Reset,Stop" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview4"/>
										<Event event="OnHidden" action="Reset,Stop" frame="$parent/$parent/HeroDeathTimeLabel"/>
										<Controller type="Fade" end="Pause">
											<Key type="Curve" time="0" value="255" inout="Linear"/>
											<Key type="Curve" time="0.5" value="0" inout="Linear"/>
											<Key type="Curve" time="1" value="255" inout="Linear"/>
											<Key type="Curve" time="1.5" value="0" inout="Linear"/>
											<Key type="Curve" time="2" value="255" inout="Linear"/>
											<Key type="Curve" time="2.5" value="0" inout="Linear"/>
											<Key type="Curve" time="3" value="255" inout="Linear"/>
											<Key type="Curve" time="3.5" value="0" inout="Linear"/>
											<Key type="Curve" time="4" value="255" inout="Linear"/>
											<Key type="Curve" time="4.5" value="0" inout="Linear"/>
											<Key type="Curve" time="5" value="255" inout="Linear"/>
											<Key type="Curve" time="5.01" value="0" inout="Linear"/>
										</Controller>
									</Animation>
								</Frame>
