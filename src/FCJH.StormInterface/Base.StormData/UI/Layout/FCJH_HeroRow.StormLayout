											<Key type="Cutscene" time="0" action="AddFilter" filter="Right"/>
											<Key type="Cutscene" time="0" action="RemoveFilter" filter="Left"/>
											<Key type="Cutscene" time="0" action="AddFilter" filter="Offense"/>
