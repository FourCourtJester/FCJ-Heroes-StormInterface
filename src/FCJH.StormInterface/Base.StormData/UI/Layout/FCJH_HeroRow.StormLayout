			<Anchor side="Left" relative="$parent" pos="Min" offset="33"/>
			<Anchor side="Top" relative="$parent" pos="Min" offset="52"/>
			<Anchor side="Right" relative="$parent" pos="Min" offset="166"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="63"/>
			<Width val="0"/>
			<Height val="0"/>
			<RenderPriority val="510"/>
			<Frame type="Frame" name="ImageMaskFrame"><AlphaMaskSiblings val="false"/></Frame>
			<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
				<Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm"/>
