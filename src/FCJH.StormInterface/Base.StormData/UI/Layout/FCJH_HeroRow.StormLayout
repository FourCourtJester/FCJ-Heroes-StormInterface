									<Event event="HeroRespawned" action="Reset,Stop" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5"/>
									<Event event="OnHidden" action="Reset,Stop" frame="$parent/HeroDeathTimeLabel"/>
									<Controller type="Style" end="Pause" frame="FCJH_DeathTime" style1="Storm_TopBar_DeathTimer" style2="Storm_TopBar_DeathTimer_Respawn">
										<Key type="Curve" time="0" value="1"/>
										<Key type="Curve" time="0.5" value="0"/>
										<Key type="Curve" time="1" value="1"/>
										<Key type="Curve" time="1.5" value="0"/>
										<Key type="Curve" time="2" value="1"/>
										<Key type="Curve" time="2.5" value="0"/>
										<Key type="Curve" time="3" value="1"/>
										<Key type="Curve" time="3.5" value="0"/>
										<Key type="Curve" time="4" value="1"/>
										<Key type="Curve" time="4.5" value="0"/>
										<Key type="Curve" time="5" value="1"/>
