					<DefaultState val="None"/>
					<State name="Picked">
						<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame1/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4" TalentTierState="TierSelected"/>
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="255"/>
					</State>
					<State name="Available">
						<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame1/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4" TalentTierState="TierAvailable"/>
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="0"/>
					</State>
					<State name="None">
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="0"/>
