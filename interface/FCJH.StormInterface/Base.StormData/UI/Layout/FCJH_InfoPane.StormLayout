<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Info pane: Talents (layout.toml element.info_pane, [info_pane]).

	     OUR OWN instance of Blizzard's talent panel: a HeroTalentsPanel from
	     CleanTalentsPanelTemplate, which the engine fills - portraits, picks, tooltips - with
	     none of the bottom panel's clipping. Rows from Blizzard's own row template: blue 0-4
	     stacked over red 5-9, red un-mirrored so every row reads portrait-first.
	     Blizzard's decorations (hex art, borders, buttons, team stats) are hidden; the look is
	     the inspect card's, shared by every pane (FCJH_PaneSkin, 2026-10-05; the Try Me
	     panel's since 2026-10-16), under the rows.
	     (Promoted from the dev probe of the same design, 2026-09-26.)
	     Shown by its hotkey (layout.toml [info_pane]); starts hidden, and only one info
	     pane shows at a time - the hotkeys for all four live in FCJH_StatPanes. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="FCJH_Pane_Talents">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
			<Frame type="Frame" name="FCJH_InfoPaneArea">
				<Anchor side="Top" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<!-- under the rows (FCJH_TalentPanel, 500): RenderPriority orders siblings only, so the
				     skin and grid inside this frame draw where THIS frame does (without one it drew
				     over the rows, 2026-10-05) -->
				<RenderPriority val="400"/>
				<AcceptsMouse val="false"/>
				<!-- the look: the inspect card's (tools/inspect_card.py pane_skin), as every pane -->
				<Frame type="Frame" name="FCJH_Skin" template="FCJH_Constants/FCJH_PaneSkin">
					<Anchor relative="$parent"/>
				</Frame>
				<!-- Blizzard's observer talent grid (obs_talents_top; approved in game, user 2026-10-05)
				     behind the rows. Blizzard tiles it once per 60-unit row (TextureCoords 0-5 over
				     300, WrapUV); its width spans both teams - blue's 565-unit row on the left half,
				     red's mirrored on the right. Our rows all read portrait-first at blue's places,
				     so blue rows take the left half and red rows the right half flipped, each cut to
				     our 549 units (0.5 x 549 / 565 = 0.4858) and widened one cell for the default quest's gap. Blizzard's own backdrop (obs_talents_bg)
				     was tried and scrapped (user). -->
				<!-- 2 above the first row, as Blizzard's rows sit 2 below their tile. Each team's
				     half in two slices: up to the talent-1 cell (124), then from that cell again on,
				     58 right. The gap between (124-182) is the default quest's column: no grid cell,
				     just the pane's background (user, 2026-10-16). The first slice ends 2 short of the
				     cell (122, 0.1080 / 0.8920), the bridge from there. -->
				<!-- colour-blind mode: each half recoloured as its team's plates (gen.py
				     colour_blind_plate, from layout.toml [colour_blind]; hand-copied) -->
				<Frame type="Image" name="FCJH_GridBlueA">
					<Anchor side="Top"   relative="$parent/$parent/FCJH_TalentPanel/HeroTalentsPanelContainer/PlayerFrame0" pos="Min" offset="-2"/>
					<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Right" relative="$parent" pos="Min" offset="122"/>
					<Height val="300"/>
					<Texture val="@UI/obs_talents_top"/>
					<TextureCoords top="0.0" left="0.0000" bottom="5.0" right="0.1080"/>
					<WrapUV val="True"/>
					<RenderPriority val="450"/>
					<AcceptsMouse val="false"/>
					<StateGroup name="FCJH_ColourBlind">
						<DefaultState val="Off"/>
						<State name="On">
							<When type="Option" colorblind="True"/>
							<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
							<Action type="SetProperty" frame="$this" LightAdjustColor="5ae6fd"/>
							<Action type="SetProperty" frame="$this" DarkAdjustColor="0a434c"/>
						</State>
						<State name="Off">
							<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
						</State>
					</StateGroup>
				</Frame>
				<Frame type="Image" name="FCJH_GridBlueB">
					<Anchor side="Top"   relative="$parent/FCJH_GridBlueA" pos="Min" offset="0"/>
					<Anchor side="Left"  relative="$parent" pos="Min" offset="182"/>
					<Anchor side="Right" relative="$parent" pos="Min" offset="607"/>
					<Height val="300"/>
					<Texture val="@UI/obs_talents_top"/>
					<TextureCoords top="0.0" left="0.1097" bottom="5.0" right="0.4858"/>
					<WrapUV val="True"/>
					<RenderPriority val="450"/>
					<AcceptsMouse val="false"/>
					<StateGroup name="FCJH_ColourBlind">
						<DefaultState val="Off"/>
						<State name="On">
							<When type="Option" colorblind="True"/>
							<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
							<Action type="SetProperty" frame="$this" LightAdjustColor="5ae6fd"/>
							<Action type="SetProperty" frame="$this" DarkAdjustColor="0a434c"/>
						</State>
						<State name="Off">
							<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
						</State>
					</StateGroup>
				</Frame>
				<Frame type="Image" name="FCJH_GridRedA">
					<Anchor side="Top"   relative="$parent/FCJH_GridBlueA" pos="Max" offset="0"/>
					<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Right" relative="$parent" pos="Min" offset="122"/>
					<Height val="300"/>
					<Texture val="@UI/obs_talents_top"/>
					<TextureCoords top="0.0" left="1.0000" bottom="5.0" right="0.8920"/>
					<WrapUV val="True"/>
					<RenderPriority val="450"/>
					<AcceptsMouse val="false"/>
					<StateGroup name="FCJH_ColourBlind">
						<DefaultState val="Off"/>
						<State name="On">
							<When type="Option" colorblind="True"/>
							<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
							<Action type="SetProperty" frame="$this" LightAdjustColor="ff8d60"/>
							<Action type="SetProperty" frame="$this" DarkAdjustColor="4c1f0d"/>
						</State>
						<State name="Off">
							<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
						</State>
					</StateGroup>
				</Frame>
				<Frame type="Image" name="FCJH_GridRedB">
					<Anchor side="Top"   relative="$parent/FCJH_GridRedA" pos="Min" offset="0"/>
					<Anchor side="Left"  relative="$parent" pos="Min" offset="182"/>
					<Anchor side="Right" relative="$parent" pos="Min" offset="607"/>
					<Height val="300"/>
					<Texture val="@UI/obs_talents_top"/>
					<TextureCoords top="0.0" left="0.8903" bottom="5.0" right="0.5142"/>
					<WrapUV val="True"/>
					<RenderPriority val="450"/>
					<AcceptsMouse val="false"/>
					<StateGroup name="FCJH_ColourBlind">
						<DefaultState val="Off"/>
						<State name="On">
							<When type="Option" colorblind="True"/>
							<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
							<Action type="SetProperty" frame="$this" LightAdjustColor="ff8d60"/>
							<Action type="SetProperty" frame="$this" DarkAdjustColor="4c1f0d"/>
						</State>
						<State name="Off">
							<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
						</State>
					</StateGroup>
				</Frame>
				<!-- the line from the portrait to talent 1 across the quest column (user, 2026-10-16):
				     one texel column of the grid's own line (120, inside its dash) stretched over the
				     gap. Not a slice: a 4-texel one (118-122) stretched 15 times blurred its first
				     texel into the brighter one beside it, a faint white line down every row at
				     ~131 px (user, 2026-10-19; gone with the bridges hidden, 2696582). -->
				<Frame type="Image" name="FCJH_GridBlueBridge">
					<Anchor side="Top"   relative="$parent/FCJH_GridBlueA" pos="Min" offset="0"/>
					<Anchor side="Left"  relative="$parent" pos="Min" offset="122"/>
					<Anchor side="Right" relative="$parent" pos="Min" offset="182"/>
					<Height val="300"/>
					<Texture val="@UI/obs_talents_top"/>
					<TextureCoords top="0.0" left="0.1066" bottom="5.0" right="0.1066"/>
					<WrapUV val="True"/>
					<RenderPriority val="450"/>
					<AcceptsMouse val="false"/>
					<StateGroup name="FCJH_ColourBlind">
						<DefaultState val="Off"/>
						<State name="On">
							<When type="Option" colorblind="True"/>
							<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
							<Action type="SetProperty" frame="$this" LightAdjustColor="5ae6fd"/>
							<Action type="SetProperty" frame="$this" DarkAdjustColor="0a434c"/>
						</State>
						<State name="Off">
							<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
						</State>
					</StateGroup>
				</Frame>
				<Frame type="Image" name="FCJH_GridRedBridge">
					<Anchor side="Top"   relative="$parent/FCJH_GridRedA" pos="Min" offset="0"/>
					<Anchor side="Left"  relative="$parent" pos="Min" offset="122"/>
					<Anchor side="Right" relative="$parent" pos="Min" offset="182"/>
					<Height val="300"/>
					<Texture val="@UI/obs_talents_top"/>
					<TextureCoords top="0.0" left="0.8934" bottom="5.0" right="0.8934"/>
					<WrapUV val="True"/>
					<RenderPriority val="450"/>
					<AcceptsMouse val="false"/>
					<StateGroup name="FCJH_ColourBlind">
						<DefaultState val="Off"/>
						<State name="On">
							<When type="Option" colorblind="True"/>
							<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
							<Action type="SetProperty" frame="$this" LightAdjustColor="ff8d60"/>
							<Action type="SetProperty" frame="$this" DarkAdjustColor="4c1f0d"/>
						</State>
						<State name="Off">
							<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
						</State>
					</StateGroup>
				</Frame>
			</Frame>
			<Frame type="HeroTalentsPanel" name="FCJH_TalentPanel" template="TalentsOverviewPanel/CleanTalentsPanelTemplate">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
				<Anchor side="Right"  relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<Width val="#FCJH_INFO_PANE_W"/>
				<Height val="#FCJH_INFO_PANE_H"/>
				<Visible val="true"/>
				<RenderPriority val="500"/>
				<Frame type="Frame"  name="TopHexContainer"><Alpha val="0"/></Frame>
				<Frame type="Image"  name="HexImage"><Alpha val="0"/></Frame>
				<Frame type="Image"  name="HexOverlayImage"><Alpha val="0"/></Frame>
				<Frame type="Frame"  name="BorderContainer"><Alpha val="0"/></Frame>
				<Frame type="Button" name="CloseButton"><Alpha val="0"/><AcceptsMouse val="false"/></Frame>
				<Frame type="Button" name="ClearSortButton"><Alpha val="0"/><AcceptsMouse val="false"/></Frame>
				<Frame type="Frame"  name="BlueTeamStats"><Alpha val="0"/></Frame>
				<Frame type="Frame"  name="RedTeamStats"><Alpha val="0"/></Frame>
				<Frame type="Frame" name="HeroTalentsPanelContainer" template="TalentsOverviewPanel/HeroTalentsPanelContainerTemplate">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Max" offset="-8"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame0">
						<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Right" relative="$this"   pos="Min" offset="0"/>
					</Frame>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame4">
						<Anchor side="Bottom" relative="$parent/PlayerFrame5" pos="Min" offset="0"/>
					</Frame>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame5">
						<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Right" relative="$this"   pos="Min" offset="0"/>
					</Frame>
					<!-- Every row's portrait and talents fitted into Blizzard's grid art (FCJH_GridBlue/Red;
					     measured off obs_talents_top, 2026-10-05): portrait 90 x 33 at 23, 11; talents 40 at y 8,
					     x 134 191 247 369 424; the heroic tiers (4, 7) 46 at y 5, x 305 483. Absolute places,
					     every row alike - which also un-mirrors red (Blizzard's red template anchors from the
					     right), so every row reads portrait-first.
					     The hero's default quest (user, 2026-10-16) takes talent 1's place, and every talent
					     moves one cell (58) right. The cell here (FCJH_QuestCell0-9) is only a place: the
					     quest icon on it is FCJH_QuestPanel's, below (our own icon's tooltip was blank
					     until Tab, docs/blizzard-fixes.md). Each row's handle (FCJH_TalentRow0-9) is where
					     that panel's row of the same number goes. -->
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame0">
						<Handle val="FCJH_TalentRow0"/>
						<Frame type="PlayerHeroIconFrame" name="CustomPlayerHeroIconFrame">
							<Anchor side="Left"   relative="$parent" pos="Min" offset="23"/>
							<Anchor side="Top"    relative="$parent" pos="Min" offset="11"/>
							<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
							<Width val="90"/>
							<Height val="33"/>
						</Frame>
						<Frame type="PlayerHeroSelectedTalentTreeFrame" name="TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame">
							<Frame type="Frame" name="FCJH_QuestCell">
								<!-- only a place: the quest icon on it is FCJH_QuestPanel's, below. Blizzard's 68
								     whole, its 40 picture (14 in) on the 40 cell at 134, 8 -->
								<Anchor side="Left"   relative="$parent" pos="Min" offset="120"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="-6"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="68"/>
								<Height val="68"/>
								<Handle val="FCJH_QuestCell0"/>
								<AcceptsMouse val="false"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon1">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="192"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="40"/>
								<Height val="40"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon2">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="249"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="40"/>
								<Height val="40"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon3">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="305"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="40"/>
								<Height val="40"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon4">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="363"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="5"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="46"/>
								<Height val="46"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon5">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="427"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="40"/>
								<Height val="40"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon6">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="482"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="40"/>
								<Height val="40"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon7">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="541"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="5"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="46"/>
								<Height val="46"/>
							</Frame>
							<!-- Blizzard's talent squares, recoloured in colour-blind mode as the pop-ups' (gen.py colour_blind_plate "square"; hand-copied) -->
							<Frame type="Image" name="CustomTalentTreeIconBorder1">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="a7f2fe"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="20c8e3"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
							<Frame type="Image" name="CustomTalentTreeIconBorder2">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="a7f2fe"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="20c8e3"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
							<Frame type="Image" name="CustomTalentTreeIconBorder3">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="a7f2fe"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="20c8e3"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
							<Frame type="Image" name="CustomTalentTreeIconBorder4">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="a7f2fe"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="20c8e3"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
							<Frame type="Image" name="CustomTalentTreeIconBorder5">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="a7f2fe"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="20c8e3"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
							<Frame type="Image" name="CustomTalentTreeIconBorder6">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="a7f2fe"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="20c8e3"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
							<Frame type="Image" name="CustomTalentTreeIconBorder7">
								<StateGroup name="FCJH_ColourBlind">
									<DefaultState val="Off"/>
									<State name="On">
										<When type="Option" colorblind="True"/>
										<Action type="SetProperty" frame="$this" ColorAdjustMode="Colorize"/>
										<Action type="SetProperty" frame="$this" LightAdjustColor="a7f2fe"/>
										<Action type="SetProperty" frame="$this" DarkAdjustColor="20c8e3"/>
									</State>
									<State name="Off">
										<Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
									</State>
								</StateGroup>
							</Frame>
						</Frame>
					</Frame>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame1">
						<Handle val="FCJH_TalentRow1"/>
						<Frame type="PlayerHeroIconFrame" name="CustomPlayerHeroIconFrame">
							<Anchor side="Left"   relative="$parent" pos="Min" offset="23"/>
							<Anchor side="Top"    relative="$parent" pos="Min" offset="11"/>
							<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
							<Width val="90"/>
							<Height val="33"/>
						</Frame>
						<Frame type="PlayerHeroSelectedTalentTreeFrame" name="TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame">
							<Frame type="Frame" name="FCJH_QuestCell">
								<!-- only a place: the quest icon on it is FCJH_QuestPanel's, below. Blizzard's 68
								     whole, its 40 picture (14 in) on the 40 cell at 134, 8 -->
								<Anchor side="Left"   relative="$parent" pos="Min" offset="120"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="-6"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="68"/>
								<Height val="68"/>
								<Handle val="FCJH_QuestCell1"/>
								<AcceptsMouse val="false"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon1">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="192"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
								<Width val="40"/>
								<Height val="40"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon2">
