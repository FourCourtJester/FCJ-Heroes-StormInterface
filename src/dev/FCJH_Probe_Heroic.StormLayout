					<DefaultState val="Ready"/>
					<State name="OnCooldown">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview4/HeroStatus/FCJH_HeroicAbil/AbilIcon/CooldownLabel" Visible="true"/>
						<Action type="SetProperty" frame="$this/FCJH_Dim" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Cooldown" Alpha="255"/>
					</State>
					<State name="Ready">
						<Action type="SetProperty" frame="$this/FCJH_Dim" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Cooldown" Alpha="0"/>
					</State>
				</StateGroup>
			</Frame>
			<!-- PlayerFrame9 -> its plate -->
			<Frame type="Frame" name="FCJH_Heroic9">
				<Anchor side="Top" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="#FCJH_HERO_RED_HEROIC_T"/>
				<Anchor side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="#FCJH_HERO_RED_HEROIC_L"/>
				<Anchor side="Bottom" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="#FCJH_HERO_RED_HEROIC_B"/>
				<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5" pos="Min" offset="#FCJH_HERO_RED_HEROIC_R"/>
				<RenderPriority val="560"/>
				<AcceptsMouse val="false"/>
				<Frame type="Image" name="FCJH_Back">
					<Anchor relative="$parent"/>
					<Texture val="#FCJH_TOKEN_BACK_RED"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Label" name="FCJH_Mark">
					<Anchor relative="$parent"/>
					<Text val="?"/>
					<Style val="FCJH_HeroicMark"/>
					<Options val="NoWrapping | ScaleToPreventTruncation"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_Icon">
					<Anchor relative="$parent"/>
					<Texture val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame9/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4/IconImage/@Texture}"/>
					<AlphaMaskTexture val="#FCJH_TOKEN_MASK_RED"/>
					<TextureCoords top="0.13" left="0.0" bottom="0.87" right="1.0"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_Dim">
					<Anchor relative="$parent"/>
					<Texture val="#FCJH_TOKEN_DIM_RED"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Label" name="FCJH_Cooldown">
					<Anchor relative="$parent"/>
					<Text val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_HeroicAbil/AbilIcon/CooldownLabel/@Text}"/>
					<Style val="FCJH_HeroicCooldown"/>
					<Options val="NoWrapping | ScaleToPreventTruncation"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<!-- the heroic tier: nothing, "?" (available, not picked), or its icon (picked) -->
				<StateGroup name="FCJH_Tier">
					<DefaultState val="None"/>
					<State name="Picked">
						<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame9/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4" TalentTierState="TierSelected"/>
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="255"/>
					</State>
					<State name="Available">
						<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame9/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4" TalentTierState="TierAvailable"/>
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="0"/>
					</State>
					<State name="None">
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="0"/>
					</State>
				</StateGroup>
				<!-- cooldown: while Blizzard's cooldown label for this heroic is showing -->
				<StateGroup name="FCJH_Cooldown">
					<DefaultState val="Ready"/>
					<State name="OnCooldown">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_HeroicAbil/AbilIcon/CooldownLabel" Visible="true"/>
						<Action type="SetProperty" frame="$this/FCJH_Dim" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Cooldown" Alpha="255"/>
					</State>
					<State name="Ready">
						<Action type="SetProperty" frame="$this/FCJH_Dim" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Cooldown" Alpha="0"/>
					</State>
				</StateGroup>
			</Frame>
		</Frame>
