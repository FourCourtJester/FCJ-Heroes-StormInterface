											<Key type="Curve" time="4" value="255" inout="Linear"/>
											<Key type="Curve" time="4.5" value="0" inout="Linear"/>
											<Key type="Curve" time="5" value="255" inout="Linear"/>
											<Key type="Curve" time="5.01" value="0" inout="Linear"/>
										</Controller>
									</Animation>
								</Frame>
