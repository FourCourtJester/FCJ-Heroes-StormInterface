<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Info pane: Talents (layout.toml element.info_pane, [info_pane]).

	     OUR OWN instance of Blizzard's talent panel: a HeroTalentsPanel from
	     CleanTalentsPanelTemplate, which the engine fills - portraits, picks, tooltips - with
	     none of the bottom panel's clipping. Rows from Blizzard's own row template: blue 0-4
	     stacked over red 5-9, red un-mirrored so every row reads portrait-first.
	     Blizzard's decorations (hex art, borders, buttons, team stats) are hidden; ours are a
	     dark backdrop under the rows, and a title band plus frame line over them.
	     (Promoted from the dev probe of the same design, 2026-09-26.)
	     Shown by its hotkey (layout.toml [info_pane]); starts hidden, and only one info
	     pane shows at a time - the hotkeys for all four live in FCJH_StatPanes. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="FCJH_Pane_Talents">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
			<Frame type="Image" name="FCJH_InfoPaneBack">
				<Anchor side="Top" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<Texture val="@UI/PauseScreenDimImage"/>
				<ColorAdjustMode val="Fill"/>
				<AdjustmentColor val="215,11,12,20"/>
				<RenderPriority val="400"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="HeroTalentsPanel" name="FCJH_TalentPanel" template="TalentsOverviewPanel/CleanTalentsPanelTemplate">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
				<Anchor side="Right"  relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<Width val="#FCJH_INFO_PANE_W"/>
				<Height val="#FCJH_INFO_PANE_H"/>
				<Visible val="true"/>
				<RenderPriority val="500"/>
				<Frame type="Frame"  name="TopHexContainer"><Alpha val="0"/></Frame>
				<Frame type="Image"  name="HexImage"><Alpha val="0"/></Frame>
				<Frame type="Image"  name="HexOverlayImage"><Alpha val="0"/></Frame>
				<Frame type="Frame"  name="BorderContainer"><Alpha val="0"/></Frame>
				<Frame type="Button" name="CloseButton"><Alpha val="0"/><AcceptsMouse val="false"/></Frame>
				<Frame type="Button" name="ClearSortButton"><Alpha val="0"/><AcceptsMouse val="false"/></Frame>
				<Frame type="Frame"  name="BlueTeamStats"><Alpha val="0"/></Frame>
				<Frame type="Frame"  name="RedTeamStats"><Alpha val="0"/></Frame>
				<Frame type="Frame" name="HeroTalentsPanelContainer" template="TalentsOverviewPanel/HeroTalentsPanelContainerTemplate">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Max" offset="-8"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame0">
						<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Right" relative="$this"   pos="Min" offset="0"/>
					</Frame>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame4">
						<Anchor side="Bottom" relative="$parent/PlayerFrame5" pos="Min" offset="0"/>
					</Frame>
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame5">
						<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Right" relative="$this"   pos="Min" offset="0"/>
					</Frame>
					<!-- Red rows un-mirrored: Blizzard's red row template anchors the portrait and the
					     seven tier icons from the right edge. Give them blue's anchors (all four sides,
					     read off the merged tree) so every row reads portrait-first, like blue. -->
					<Frame type="HeroTalentsPanelPlayerFrame" name="PlayerFrame5">
						<Frame type="PlayerHeroIconFrame" name="CustomPlayerHeroIconFrame">
							<Anchor side="Left"   relative="$parent" pos="Min" offset="23"/>
							<Anchor side="Top"    relative="$parent" pos="Min" offset="12"/>
							<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
							<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
						</Frame>
						<Frame type="PlayerHeroSelectedTalentTreeFrame" name="TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame">
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon1">
								<Anchor side="Left"   relative="$parent" pos="Min" offset="133"/>
								<Anchor side="Top"    relative="$parent" pos="Min" offset="7"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon2">
								<Anchor side="Left"   relative="$parent/TalentTreeIcon1" pos="Max" offset="#BottomPanelHorizTalentGapBlue"/>
