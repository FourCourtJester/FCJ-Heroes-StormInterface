				<StateGroup name="FCJH_Abilities">
					<DefaultState val="Other"/>
						<State name="HeroBarbarian">
							<When type="Property" Unit="HeroBarbarian"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilD" AbilityLink="BarbarianShotofFury"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilQ" AbilityLink="BarbarianAncientSpear"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilW" AbilityLink="BarbarianSeismicSlam"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilE" AbilityLink="BarbarianWhirlwind"/>
						</State>
						<State name="HeroCrusader">
							<When type="Property" Unit="HeroCrusader"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilD" AbilityLink="CrusaderIronSkin"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilQ" AbilityLink="CrusaderPunish"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilW" AbilityLink="CrusaderCondemn"/>
							<Action type="SetProperty" frame="$this/FCJH_AbilE" AbilityLink="CrusaderShieldGlare"/>
						</State>
