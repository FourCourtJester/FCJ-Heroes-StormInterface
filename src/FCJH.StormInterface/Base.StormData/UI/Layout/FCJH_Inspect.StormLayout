<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
<!-- GENERATED by tools/gen.py from layout.toml. Do not edit by hand:
     change layout.toml (or tools/gen.py) and rebuild. -->

	<!-- The inspect card (tools/inspect_card.py; layout.toml element.inspect, 300 x 525 px): the
	     selected unit's portrait, name, player and level, fountain, health and resource, buffs
	     and debuffs, abilities, talents and stats. Shown when Blizzard's own small inspector
	     would be. It lives in Blizzard's console container, beside the command card whose buttons
     it borrows (as Ahli's hero card does). -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
	<Frame type="Frame" name="UIContainer">
	<Frame type="Frame" name="ConsoleUIContainer">
		<!-- Round 9 (2026-09-30): the card shows exactly when Blizzard's own small inspector
		     would. Ours alone (a TargetInfoFrame the game doesn't manage) came up on the first
		     plate click of a game; the default UI's doesn't (user). Blizzard's is now parked
		     off screen rather than forced hidden (FCJH_Hidden), so its visibility is still the
		     game's, and this watcher copies it onto the card. -->
		<Frame type="Frame" name="FCJH_InspectGate">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<StateGroup name="FCJH_Gate">
				<DefaultState val="Hide"/>
				<State name="Show">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/TargetInfoFrame" Visible="true"/>
					<Action type="SetProperty" frame="$parent/FCJH_Inspect" Visible="true"/>
					<Action type="SetProperty" frame="$parent/FCJH_TalentTips" Visible="true"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/CommandPanel" side="Top" relative="$GameUI/UIContainer/ConsoleUIContainer/FCJH_Inspect" pos="Min" offset="291"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/CommandPanel" side="Left" relative="$GameUI/UIContainer/ConsoleUIContainer/FCJH_Inspect" pos="Min" offset="15"/>
				</State>
				<State name="Hide">
					<Action type="SetProperty" frame="$parent/FCJH_Inspect" Visible="false"/>
					<Action type="SetProperty" frame="$parent/FCJH_TalentTips" Visible="false"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/CommandPanel" side="Top" relative="$GameUI" pos="Min" offset="9999"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/CommandPanel" side="Left" relative="$GameUI" pos="Min" offset="9999"/>
				</State>
			</StateGroup>
		</Frame>
		<Frame type="Frame" name="FCJH_CommandShown">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<Animation name="FCJH_Assert">
				<Event event="OnShown" action="Play"/>
				<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/CommandPanel">
					<Key type="Bool" time="0" value="true"/>
				</Controller>
			</Animation>
		</Frame>
		<!-- The card: our copy of Blizzard's inspect box -->
		<Frame type="TargetInfoFrame" name="FCJH_Inspect">
			<Visible val="false"/>
			<Anchor side="Top"    relative="$parent" pos="Min" offset="#FCJH_INSPECT_T"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="#FCJH_INSPECT_L"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INSPECT_B"/>
			<Anchor side="Right"  relative="$parent" pos="Min" offset="#FCJH_INSPECT_R"/>
			<AcceptsMouse val="false"/>
			<RenderPriority val="600"/>
			<Frame type="Frame" name="TargetInfoPanel" template="TargetInfoPanel/TargetInfoPanelTemplate">
				<Anchor relative="$parent"/>
				<Visible val="{$this/@Enabled}"/>
				<!-- the on/off switch only: none of Blizzard's own pieces drawn -->
				<Frame type="Image" name="BackgroundFrame"><Alpha val="0"/></Frame>
				<Frame type="Image" name="TopBackground"><Alpha val="0"/></Frame>
				<Frame type="Image" name="BottomBorderImage"><Alpha val="0"/></Frame>
				<Frame type="Image" name="BorderFrame"><Alpha val="0"/></Frame>
				<!-- parked off screen, not just faded: faded, their stat rows still answered the mouse
				     under our portrait (duplicate tooltips, round 7) -->
				<Frame type="Frame" name="TargetPortraitFrame">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="10099"/>
					<Anchor side="Right"  relative="$parent" pos="Min" offset="10099"/>
					<Alpha val="0"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
				</Frame>
				<Frame type="UnitStatusFrame" name="HealthAndManaUnitStatusFrame">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="10099"/>
					<Anchor side="Right"  relative="$parent" pos="Min" offset="10099"/>
					<Alpha val="0"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
				</Frame>
				<Frame type="Image" name="AdditionalInfoIcon">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="10099"/>
					<Anchor side="Right"  relative="$parent" pos="Min" offset="10099"/>
					<Alpha val="0"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
				</Frame>
				<Frame type="UnitTargetFrame" name="TargetHeroUnitFrame">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="9999"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="10099"/>
					<Anchor side="Right"  relative="$parent" pos="Min" offset="10099"/>
					<Alpha val="0"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
				</Frame>


		<!-- The card's contents, numbered 1-6 below: Blizzard's per-unit widgets in a selection
		     panel, following the observer's selection -->
		<Frame type="SelectionUnitStatusPanel" name="FCJH_InspectUnit">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<AcceptsMouseTooltip val="false"/>
			<RenderPriority val="660"/>
			<!-- INSIDE the card (round 5), so it hides with it. Beside the card (rounds 3-4) its
			     parts stayed on screen after click-off, bound to the card's Visible or faded by Alpha -->
			<Frame type="UnitStatusFrame" name="UnitStatusFrame0" template="TargetInfoPanelUnitStatusTemplate/TargetInfoPanelUnitStatusBarTemplate">
				<Anchor relative="$parent"/>
				<AcceptsMouse val="false"/>
				<!-- the card itself, inside the selection panel: shown only with a selection -->
			<Frame type="Image" name="FCJH_Back">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="583"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
				<Texture val="@UI/PauseScreenDimImage"/>
				<ColorAdjustMode val="Fill"/>
				<AdjustmentColor val="255,11,12,20"/>
				<RenderPriority val="200"/>
				<AcceptsMouse val="true"/>
				<Alpha val="0"/>
			</Frame>
				<Frame type="Image" name="FCJH_SkinBack">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
					<Texture val="@UI/Storm_UI_TargetInfoPanel_Background"/>
					<TextureType val="Nineslice"/>
					<Alpha val="230"/>
					<RenderPriority val="205"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_SkinBorder">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="3"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="3"/>
					<Anchor side="Bottom" relative="$parent" pos="Max" offset="-3"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="-3"/>
					<Texture val="@UI/Storm_UI_TargetInfoPanel_BackgroundBorder"/>
					<TextureType val="Nineslice"/>
					<RenderPriority val="207"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_SkinTitle">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="3"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="3"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="30"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="-3"/>
					<Color val="564c6d"/>
					<Alpha val="76"/>
					<RenderPriority val="211"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_SkinTitleLine">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="29"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="30"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
					<Color val="73668d"/>
					<Alpha val="76"/>
					<RenderPriority val="212"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_SkinName">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="155"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="3"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="185"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="-3"/>
					<Color val="564c6d"/>
					<Alpha val="76"/>
					<RenderPriority val="241"/>
					<AcceptsMouse val="false"/>
				</Frame>
			<Frame type="Label" name="FCJH_SectionTalents">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="404"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="15"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="419"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="-15"/>
				<Style val="FCJH_InspectSection"/>
				<Text val="TALENTS"/>
				<Options val="NoWrapping | ScaleToPreventTruncation"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="FCJH_SectionStats">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="482"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="15"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="497"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="-15"/>
				<Style val="FCJH_InspectSection"/>
				<Text val="STATS"/>
				<Options val="NoWrapping | ScaleToPreventTruncation"/>
				<AcceptsMouse val="false"/>
			</Frame>
				<!-- health and resource: Blizzard's inspect-box bars (this frame's template), placed -->
				<Frame type="UnitStatusShieldedHealthBar" name="HealthBar">
					<Anchor side="Top"   relative="$parent" pos="Min" offset="195"/>
					<Anchor side="Left"  relative="$parent" pos="Min" offset="15"/>
					<Anchor side="Right" relative="$parent" pos="Max" offset="-15"/>
					<Height val="24"/>
					<Width val="0"/>
				</Frame>
				<Frame type="UnitStatusEnergyBar" name="NormalEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
				<Frame type="UnitStatusEnergyBar" name="OrangeEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
				<Frame type="UnitStatusEnergyBar" name="PinkEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
				<Frame type="UnitStatusEnergyBar" name="YellowEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
				<Frame type="UnitStatusEnergyBar" name="DeathwingEnergyBar"><Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="0"/><Width val="0"/></Frame>
				<!-- stats: Blizzard's stat rows, from the inspect box's template -->
				<Frame type="Frame" name="FCJH_Stats" template="TargetInfoPanel/TargetInfoPanelTemplate/HealthAndManaUnitStatusFrame/TargetStatsPanel">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="500"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="15"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="572"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="-15"/>
						<Frame type="TargetInfoStatFrame" name="AttackDamageFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="97"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AttackSpeedFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="101"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="97"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AttackRangeFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="202"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="97"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AbilityPowerFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="24"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="97"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="MoveSpeedFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="24"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="101"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="97"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="PhysicalArmorFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="48"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="97"/>
						</Frame>
						<Frame type="TargetInfoStatFrame" name="AbilityArmorFrame">
							<Anchor side="Top" relative="$parent" pos="Min" offset="48"/>
							<Anchor side="Left" relative="$parent" pos="Min" offset="101"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
							<Width val="97"/>
						</Frame>
					<!-- the stat tooltips open off the card's right edge, level with the stats (Blizzard's
					     hung them under the box - the bottom of our tall card, round 7) -->
					<Frame type="Frame" name="TooltipAnchorFrame">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
						<Anchor side="Left"   relative="$parent/$parent" pos="Max" offset="15"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
						<Width val="10"/>
						<TooltipAnchorPosition val="TopToTop | LeftToLeft"/>
					</Frame>
				</Frame>

				<!-- 1. animated model: DROPPED (round 6). The hero cutscene kept the first hero clicked
				     (Chromie) over every later selection; the static portrait underneath updates. -->

				<!-- the selected unit's team (inspect_card.team_sense), and DIAGNOSTIC squares showing it -->
				<Frame type="UnitStatusColor" name="FCJH_TeamSense">
					<Anchor relative="$parent"/>
					<ColorStyle val="MinimapTeams"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
					<StateGroup name="FCJH_Relation">
						<DefaultState val="None"/>
						<State name="TeamOrder"><When type="Property" frame="$this" CurrentRelation="TeamOrder"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamOrder" Alpha="255"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamChaos" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagAlly" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagEnemy" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagOwner" Alpha="40"/></State>
						<State name="TeamChaos"><When type="Property" frame="$this" CurrentRelation="TeamChaos"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamOrder" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamChaos" Alpha="255"/><Action type="SetProperty" frame="$parent/FCJH_DiagAlly" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagEnemy" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagOwner" Alpha="40"/></State>
						<State name="Ally"><When type="Property" frame="$this" CurrentRelation="Ally"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamOrder" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamChaos" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagAlly" Alpha="255"/><Action type="SetProperty" frame="$parent/FCJH_DiagEnemy" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagOwner" Alpha="40"/></State>
						<State name="Enemy"><When type="Property" frame="$this" CurrentRelation="Enemy"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamOrder" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamChaos" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagAlly" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagEnemy" Alpha="255"/><Action type="SetProperty" frame="$parent/FCJH_DiagOwner" Alpha="40"/></State>
						<State name="Owner"><When type="Property" frame="$this" CurrentRelation="Owner"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamOrder" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamChaos" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagAlly" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagEnemy" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagOwner" Alpha="255"/></State>
						<State name="None"><Action type="SetProperty" frame="$parent/FCJH_DiagTeamOrder" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagTeamChaos" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagAlly" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagEnemy" Alpha="40"/><Action type="SetProperty" frame="$parent/FCJH_DiagOwner" Alpha="40"/></State>
					</StateGroup>
				</Frame>
				<Frame type="Image" name="FCJH_DiagTeamOrder">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="15"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="14"/>
					<Height val="14"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="255,92,188,236"/>
					<RenderPriority val="700"/>
					<Alpha val="40"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_DiagTeamChaos">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="8"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="33"/>
					<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
					<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
					<Width val="14"/>
					<Height val="14"/>
					<Texture val="@UI/PauseScreenDimImage"/>
