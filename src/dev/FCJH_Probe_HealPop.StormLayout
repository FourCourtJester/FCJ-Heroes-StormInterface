					     drew 48 px (2026-09-29) -->
					<Frame type="Image" name="FCJH_Border">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="-1"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="-1"/>
						<Anchor side="Bottom" relative="$parent" pos="Max" offset="1"/>
						<Anchor side="Right"  relative="$parent" pos="Max" offset="1"/>
						<Texture val="_Assets\Textures\FCJH_PopBorder_Heal.dds"/>
						<Unclipped val="true"/>
						<AcceptsMouse val="false"/>
					</Frame>
				</Frame>
				<Animation name="Pop">
					<Event event="FCJH_Pop" action="Restart,Play"/>
					<Controller type="Visibility" end="Pause">
						<Key type="Bool" time="0" value="true"/>
						<Key type="Bool" time="5.85" value="false"/>
					</Controller>
					<Controller type="Anchor" end="Pause" side="Top" relative="true">
						<Key type="Curve" time="0" value="38" inout="Slow"/>
						<Key type="Curve" time="0.35" value="0" inout="Slow"/>
					</Controller>
					<Controller type="Fade" end="Pause">
						<Key type="Curve" time="0" value="0"/>
						<Key type="Curve" time="0.25" value="255"/>
						<Key type="Curve" time="5.35" value="255"/>
						<Key type="Curve" time="5.85" value="0"/>
					</Controller>
				</Animation>
			</Frame>
			<Frame type="Frame" name="FCJH_HealWatch9">
				<Anchor relative="$parent"/>
				<AcceptsMouse val="false"/>
				<Frame type="Frame" name="Shown"><Anchor relative="$parent"/><Visible val="false"/></Frame>
				<StateGroup name="Crit">
					<DefaultState val="Fine"/>
					<State name="Fire">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_CritMark" visible="true"/>
						<When type="Property" frame="Shown" visible="false"/>
						<Action type="SetProperty" frame="Shown" visible="true"/>
						<Action type="SetProperty" frame="$parent/FCJH_Heal9/FCJH_Body" visible="true"/>
						<Action type="SendEvent" frame="$parent/FCJH_Heal9" event="FCJH_Pop"/>
					</State>
					<!-- round 2: the latch (Shown) only resets once the hero is above 25% AND the pop-up has
					     finished. Round 1 reset it the moment the flag dropped, and a heal under 25% flickers
					     the flag (the percent changes), which restarted the pop-up on every tick of healing -->
					<State name="Low">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview5/HeroStatus/FCJH_CritMark" visible="true"/>
						<Action type="SetProperty" frame="$parent/FCJH_Heal9/FCJH_Body" visible="true"/>
					</State>
					<State name="Rearm">
						<When type="Property" frame="$parent/FCJH_Heal9" visible="false"/>
						<Action type="SetProperty" frame="Shown" visible="false"/>
					</State>
					<State name="Fine">
						<Action type="SetProperty" frame="$parent/FCJH_Heal9/FCJH_Body" visible="false"/>
					</State>
				</StateGroup>
			</Frame>
		</Frame>
	</Frame>
</Desc>
