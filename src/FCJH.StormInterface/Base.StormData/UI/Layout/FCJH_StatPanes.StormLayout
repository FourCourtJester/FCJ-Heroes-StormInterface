		<!-- The hotkeys, all four panes (talents included) -->
		<Frame type="ToggleControl" name="FCJH_Pane_TalentsToggle">
			<Anchor side="Top"  relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
			<Width val="1"/>
			<Height val="1"/>
			<Shortcut val="#FCJH_INFO_PANE_KEY_TALENTS"/>
			<Visible val="false"/>
			<AcceptsMouse val="false"/>
			<Animation name="FCJH_Show">
				<Event event="OnShown" action="DirectionForward,Play"/>
				<Event event="OnHidden" action="DirectionReverse,Play"/>
				<Controller type="Visibility" end="Pause" frame="$parent/FCJH_Pane_Talents">
					<Key type="Bool" time="0" value="false"/>
					<Key type="Bool" time="0.001" value="true"/>
				</Controller>
				<Controller type="Fade" end="Pause" frame="$parent/FCJH_Pane_Talents">
					<Key type="Curve" time="0" value="0"/>
					<Key type="Curve" time="0.15" value="255"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Only">
				<Event event="OnShown" action="Reset,Play"/>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_KdaToggle">
					<Key type="Bool" time="0" value="false"/>
				</Controller>
				<Controller type="Visibility" end="Stop" frame="$parent/FCJH_Pane_HealingToggle">
