	<Frame type="GameUI" name="GameUI" file="GameUI">
		<!-- Fewer than five heroes a side: pack the rows toward the minimap (tools/gen.py
		     row_packer). UNTESTED: assumes the engine hides the cells it doesn't fill. -->
		<Frame type="Frame" name="FCJH_RowPacker">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<StateGroup name="FCJH_BlueCount">
				<DefaultState val="Heroes5"/>
				<State name="Heroes1">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" Visible="true"/>
