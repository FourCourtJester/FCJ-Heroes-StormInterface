						<Anchor side="Bottom" relative="$parent" pos="Min" offset="568"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="265"/>
						<Style val="FCJH_InspectTier"/>
						<Text val="16"/>
						<Options val="NoWrapping | ScaleToPreventTruncation"/>
						<AcceptsMouse val="false"/>
					</Frame>
					<Frame type="Label" name="FCJH_Tier7">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="554"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="272"/>
						<Anchor side="Bottom" relative="$parent" pos="Min" offset="568"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="308"/>
						<Style val="FCJH_InspectTier"/>
						<Text val="20"/>
						<Options val="NoWrapping | ScaleToPreventTruncation"/>
						<AcceptsMouse val="false"/>
					</Frame>

				<!-- 6. abilities: ability icons with cooldowns. D Q W E from a per-hero table (3 heroes for
				     now); R from the talent strip's heroic, as Blizzard's talent rows do -->
					<Frame type="UnitStatusAbilIcon" name="FCJH_AbilD">
						<Anchor side="Top"    relative="$parent" pos="Min" offset="425"/>
						<Anchor side="Left"   relative="$parent" pos="Min" offset="14"/>
						<Anchor side="Bottom" relative="$parent" pos="Min" offset="469"/>
						<Anchor side="Right"  relative="$parent" pos="Min" offset="58"/>
						<Unclipped val="true"/>
