									</State>
								</StateGroup>
								<!-- cooldown: from Blizzard's observer top bar - its own heroic count, in the talent
								     row for this player (the in-game bar's count never shows for observers) -->
								<Frame type="Label" name="FCJH_UltCooldown">
									<Anchor side="Left"   relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="8"/>
									<Anchor side="Top"    relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="45"/>
									<Anchor side="Right"  relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="78"/>
									<Anchor side="Bottom" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="84"/>
									<Text val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame5/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/UnitStatusAbil/AbilIcon/CooldownLabel/@Text}"/>
									<Style val="PartyFrame_HeroicTalentCooldown"/>
									<Options val="NoWrapping | ScaleToPreventTruncation"/>
									<Alpha val="0"/>
									<Unclipped val="true"/>
									<AcceptsMouse val="false"/>
								</Frame>
								<!-- ...or a kit heroic's own count (KIT_HEROIC_COOLDOWNS) -->
								<Frame type="Label" name="FCJH_Kit_DeathwingCataclysm">
									<Anchor side="Left"   relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="8"/>
									<Anchor side="Top"    relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="45"/>
									<Anchor side="Right"  relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="78"/>
									<Anchor side="Bottom" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" pos="Min" offset="84"/>
									<Text val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame5/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/FCJH_Kit_DeathwingCataclysm/AbilIcon/CooldownLabel/@Text}"/>
									<Style val="PartyFrame_HeroicTalentCooldown"/>
									<Options val="NoWrapping | ScaleToPreventTruncation"/>
									<Alpha val="0"/>
									<Unclipped val="true"/>
									<AcceptsMouse val="false"/>
								</Frame>
								<StateGroup name="FCJH_Cooldown">
									<DefaultState val="Ready"/>
									<!-- Tracer: never "on cooldown" - her charge meter shows instead
									     (talent_row_lifts; it read as permanently greyed out, 2026-09-30) -->
									<State name="Charge">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame5/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/TracerChargeContainer/TracerPulseBombChargeFrame" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>

									<State name="DeathwingCataclysm">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame5/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/FCJH_Kit_DeathwingCataclysm/AbilIcon/CooldownLabel" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="80"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="true"/>
									</State>
									<State name="HeroDeathwingReady">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1/HeroStatus" Unit="HeroDeathwing"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>
									<State name="DeathwingDragonflightUnitReady">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1/HeroStatus" Unit="DeathwingDragonflightUnit"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>
									<State name="Cooldown">
										<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame5/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/UnitStatusAbil/AbilIcon/CooldownLabel" Visible="true"/>
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="80"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="true"/>
									</State>
									<State name="Ready">
										<Action type="SetProperty" frame="$this/FCJH_UltCooldown" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_Kit_DeathwingCataclysm" Alpha="0"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Alpha="255"/>
										<Action type="SetProperty" frame="$this/FCJH_UltIcon" Desaturated="false"/>
									</State>
								</StateGroup>
