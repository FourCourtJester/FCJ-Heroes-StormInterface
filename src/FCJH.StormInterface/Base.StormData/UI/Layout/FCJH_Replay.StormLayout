<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Replay controls, on red's row, its right edge in line with the row's: the inspect
	     card's mirror (layout.toml element.replay; user, 2026-10-16), collapsible. Narrowed to
	     #FCJH_REPLAY_W (native 420) to keep clear of red's map alerts: everything in Blizzard's
	     panel hangs off its BackgroundImage's edges and middle, so it closes up with it.

	     Collapse: Blizzard's own toggle (ToggleControlObserverTools in
	     stormobserverpanel.stormlayout) slides ReplayPanel out to the left and fades it, and
	     back. We keep that and only move and narrow the panel - and give the toggle a key that
	     works: Blizzard's Ctrl+Shift+O is the game's UI editor's Save All, so it never reached
	     the interface (user, 2026-10-16). #FCJH_REPLAY_KEY, layout.toml element.replay hotkey -
	     Ctrl+Shift+O again, with Save All moved off it by our GameHotkeys.txt ([blizzard_hotkeys]).
	     The toggle starts off while the panel shows, so the first press only "showed" it (user,
	     2026-10-16): FCJH_ReplaySeen switches it on when a replay first shows the panel, as
	     Ahli 0.75 does.

	     While it's collapsed, a slim tab shows in the panel's bottom-right corner
	     (element.replay_collapsed) so the operator can see it's there and how to bring it back. The tab watches the panel's
	     visibility; its pieces fade rather than the tab hiding itself, so its watcher keeps
	     running. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverToggleControls">
					<Frame type="ToggleControl" name="ToggleControlObserverTools">
						<Shortcut val="#FCJH_REPLAY_KEY"/>
					</Frame>
				</Frame>
				<Frame type="MovingFrame" name="ObserverPanelMovingContainer">
					<Frame type="ReplayPanel" name="ReplayPanel">
						<Anchor side="Top"   relative="$GameUI" pos="Max" offset="#FCJH_REPLAY_T"/>
						<Anchor side="Left"  relative="$GameUI" pos="Mid" offset="#FCJH_REPLAY_L"/>
						<Anchor side="Right" relative="$this"   pos="Min" offset="0"/>
						<Width val="#FCJH_REPLAY_W"/>
						<Unclipped val="true"/>
						<Frame type="Image" name="BackgroundImage">
							<Width val="#FCJH_REPLAY_W"/>
						</Frame>
						<!-- the bottom row evened out: Slower and Faster chain off Play instead of hugging the
						     middle (gen.py REPLAY_BUTTON_GAP; user, 2026-10-16) -->
						<Frame type="Button" name="DecSpeedButton">
							<Anchor side="Left"  relative="$parent/PlayButton" pos="Max" offset="#FCJH_REPLAY_BUTTON_GAP"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
						</Frame>
						<Frame type="Button" name="IncSpeedButton">
							<Anchor side="Left"  relative="$parent/DecSpeedButton" pos="Max" offset="#FCJH_REPLAY_BUTTON_GAP"/>
							<Anchor side="Right" relative="$this" pos="Min" offset="0"/>
						</Frame>
					</Frame>
				</Frame>
			</Frame>
		</Frame>

		<Frame type="Frame" name="FCJH_ReplayTab">
			<Anchor side="Top"    relative="$parent" pos="Max" offset="#FCJH_REPLAY_COLLAPSED_T"/>
			<Anchor side="Left"   relative="$parent" pos="Mid" offset="#FCJH_REPLAY_COLLAPSED_L"/>
			<Anchor side="Bottom" relative="$parent" pos="Max" offset="#FCJH_REPLAY_COLLAPSED_B"/>
			<Anchor side="Right"  relative="$parent" pos="Mid" offset="#FCJH_REPLAY_COLLAPSED_R"/>
			<AcceptsMouse val="false"/>
			<Frame type="Image" name="FCJH_TabBack">
				<Anchor relative="$parent"/>
				<Texture val="@UI/PauseScreenDimImage"/>
				<ColorAdjustMode val="Fill"/>
				<AdjustmentColor val="220,11,12,20"/>
				<Alpha val="0"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="FCJH_TabLabel">
				<Anchor relative="$parent"/>
				<Style val="ObsBar_MatchTimer"/>
				<Text val="REPLAY  Ctrl+Shift+O"/>
				<Options val="NoWrapping | ScaleToPreventTruncation"/>
				<Alpha val="0"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<!-- Replays only: in a live observed game the replay panel never shows at all, and the
			     tab mustn't either (user, 2026-09-30). The interface has no "is this a replay"
			     flag, so FCJH_Seen latches the first time the panel is seen, and the tab only
			     shows after that. Leaving a state undoes its actions, so the latch's are
			     undo="false" (Ahli 0.75's way; 2026-10-16) - else hiding the panel dropped it. -->
			<Frame type="Frame" name="FCJH_Seen"><Anchor relative="$parent"/><Visible val="false"/></Frame>
			<StateGroup name="FCJH_ReplaySeen">
				<DefaultState val="NotYet"/>
				<State name="Seen">
					<When type="Property" frame="FCJH_Seen" visible="false"/>
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverPanelMovingContainer/ReplayPanel" Visible="true"/>
					<Action type="SetProperty" frame="FCJH_Seen" visible="true" undo="false"/>
					<Action type="SetProperty" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverToggleControls/ToggleControlObserverTools" visible="true" undo="false"/>
				</State>
				<State name="NotYet"/>
			</StateGroup>
			<StateGroup name="FCJH_Collapsed">
				<DefaultState val="Open"/>
				<State name="Collapsed">
					<When type="Property" frame="FCJH_Seen" visible="true"/>
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverPanelMovingContainer/ReplayPanel" Visible="false"/>
					<Action type="SetProperty" frame="FCJH_TabBack" Alpha="255"/>
					<Action type="SetProperty" frame="FCJH_TabLabel" Alpha="255"/>
				</State>
				<State name="Open">
					<Action type="SetProperty" frame="FCJH_TabBack" Alpha="0"/>
					<Action type="SetProperty" frame="FCJH_TabLabel" Alpha="0"/>
				</State>
			</StateGroup>
		</Frame>
	</Frame>
</Desc>
