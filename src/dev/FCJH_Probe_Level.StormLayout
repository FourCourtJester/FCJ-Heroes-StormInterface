					<Action type="SetProperty" frame="BlueTier" Text="6"/>
				</State>
			</StateGroup>
			<StateGroup name="RedTierMap">
				<DefaultState val="L1"/>
				<State name="L1">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2LevelLabel" Text="1"/>
