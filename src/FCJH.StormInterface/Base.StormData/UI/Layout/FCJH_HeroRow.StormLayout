		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="Frame" name="ObserverHeroOverviewPanel">
					<!-- Blizzard's top-bar talent rows are anchored to the cells, so they follow
					     them down here. Hidden with Alpha 0, not parked: the talent pop-ups watch
					     their icons, which must stay alive. -->
					<Frame type="Frame" name="TalentsOverview"><Alpha val="0"/></Frame>
					<Frame type="Frame" name="Team1HeroOverview">
						<Frame type="Frame" name="HeroOverview1" template="FCJH_HeroRow/FCJH_HeroCell">
							<Anchor side="Top"    relative="$GameUI" pos="Min" offset="#FCJH_HERO_1_T"/>
							<Anchor side="Left"   relative="$GameUI" pos="Min" offset="#FCJH_HERO_1_L"/>
							<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="#FCJH_HERO_1_B"/>
							<Anchor side="Right"  relative="$GameUI" pos="Min" offset="#FCJH_HERO_1_R"/>
							<RenderPriority val="505"/>
							<Frame type="Label" name="FCJH_DeathOlaf">
								<Text val="{$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingOlafLabel/@Text}"/>
								<StateGroup name="FCJH_Shown">
									<DefaultState val="No"/>
									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingOlafLabel" Visible="true"/><Action type="SetProperty" frame="$this" Alpha="255"/></State>
									<State name="No"><Action type="SetProperty" frame="$this" Alpha="0"/></State>
								</StateGroup>
							</Frame>
							<Frame type="Label" name="FCJH_DeathBaleog">
								<Text val="{$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingBaleogLabel/@Text}"/>
								<StateGroup name="FCJH_Shown">
									<DefaultState val="No"/>
									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingBaleogLabel" Visible="true"/><Action type="SetProperty" frame="$this" Alpha="255"/></State>
									<State name="No"><Action type="SetProperty" frame="$this" Alpha="0"/></State>
								</StateGroup>
							</Frame>
							<Frame type="Label" name="FCJH_DeathErik">
								<Text val="{$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingErikLabel/@Text}"/>
								<StateGroup name="FCJH_Shown">
									<DefaultState val="No"/>
									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingErikLabel" Visible="true"/><Action type="SetProperty" frame="$this" Alpha="255"/></State>
									<State name="No"><Action type="SetProperty" frame="$this" Alpha="0"/></State>
								</StateGroup>
							</Frame>
							<Frame type="Label" name="FCJH_DeathPet">
								<Text val="{$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimePetLabel/@Text}"/>
								<StateGroup name="FCJH_Shown">
									<DefaultState val="No"/>
									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimePetLabel" Visible="true"/><Action type="SetProperty" frame="$this" Alpha="255"/></State>
									<State name="No"><Action type="SetProperty" frame="$this" Alpha="0"/></State>
								</StateGroup>
							</Frame>
							<Frame type="Frame" name="FCJH_VikingDeathWatch">
								<Anchor relative="$parent"/>
								<AcceptsMouse val="false"/>
								<StateGroup name="FCJH_OneDown">
									<DefaultState val="No"/>
									<State name="OlafDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingOlafLabel" Visible="true"/><Action type="SetProperty" frame="$parent/HeroDeathTimeLabel" Alpha="0"/></State>
									<State name="BaleogDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingBaleogLabel" Visible="true"/><Action type="SetProperty" frame="$parent/HeroDeathTimeLabel" Alpha="0"/></State>
									<State name="ErikDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1/HeroDeathTimeVikingErikLabel" Visible="true"/><Action type="SetProperty" frame="$parent/HeroDeathTimeLabel" Alpha="0"/></State>
									<State name="No"><Action type="SetProperty" frame="$parent/HeroDeathTimeLabel" Alpha="255"/></State>
								</StateGroup>
