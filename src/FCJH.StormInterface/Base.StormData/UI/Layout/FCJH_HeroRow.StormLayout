							<Frame type="Frame" name="FCJH_VikingDeathWatch">
								<Anchor relative="$parent"/>
								<AcceptsMouse val="false"/>
								<StateGroup name="FCJH_OneDown">
									<DefaultState val="No"/>
									<State name="OlafDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5/HeroDeathTimeVikingOlafLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="BaleogDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5/HeroDeathTimeVikingBaleogLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="ErikDead"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview5/HeroDeathTimeVikingErikLabel" Visible="true"/><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="0"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="0"/></State>
									<State name="No"><Action type="SetProperty" frame="$parent/FCJH_DeathTimeHold/FCJH_DeathTime" Alpha="255"/><Action type="SetProperty" frame="$parent/FCJH_DeathSkull" Alpha="255"/></State>
								</StateGroup>
