										<Key type="Curve" time=".01" value="0"/>
									</Controller>
								</Animation>
							</Frame>
							<Frame type="Frame" name="FCJH_DeathSkull">
								<Frame type="Image" name="FCJH_RespawnGlow">
									<Animation name="FCJH_RespawnPulse">
										<Event event="HeroAlmostRespawned" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview3"/>
										<Event event="HeroRespawned" action="Reset,Stop" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team2HeroOverview/HeroOverview3"/>
										<Event event="OnHidden" action="Reset,Stop" frame="$parent/$parent/HeroDeathTimeLabel"/>
