									<Frame type="Image" name="FillImage"><Anchor relative="$parent"/><Unclipped val="true"/><TextureType val="Circular"/><RenderPriority val="536"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_Quest_Progress_Bar"/></Frame>
								</Frame>
							</Frame>
							<Frame type="Image" name="QuestCompleteImage"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/><Unclipped val="true"/><RenderPriority val="537"/><Visible val="False"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_QuestComplete"/></Frame>
							<Frame type="Label" name="QuestProgressStackLabel">
								<Anchor side="Top" relative="$parent/QuestProgressBar" pos="Max" offset="-2"/>
								<Anchor side="Left" relative="$parent/QuestProgressBar" pos="Min" offset="0"/>
								<Height val="20"/><Style val="Storm_LeaderTalentQuestStack"/><Visible val="false"/>
								<RenderPriority val="538"/><Unclipped val="true"/>
								<Text val="{$FCJH_QTestIcon4B/QuestProgressBar/@Value}"/>
							</Frame>
							<StateGroup name="BaselineQuestProgress">
								<DefaultState val="NoQuest"/>
								<State name="HasQuest">
									<When type="Property" frame="$FCJH_QTestIcon4B" QuestProgress="QuestInProgress"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="True"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="HasUntrackedQuest">
									<When type="Property" frame="$FCJH_QTestIcon4B" QuestProgress="ProgressUntracked"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="FinishedQuest">
									<When type="Property" frame="$FCJH_QTestIcon4B" QuestProgress="FinishedQuest"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="True"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="False"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="70"/>
								</State>
								<State name="FinishedUnlimitedQuest">
									<When type="Property" frame="$FCJH_QTestIcon4B" QuestProgress="FinishedUnlimitedQuest"/>
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="True"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="True"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="True"/>
									<Action type="SetAnchor" frame="VitalLabel0" side="Top" relative="$parent" pos="Min" offset="85"/>
								</State>
								<State name="NoQuest">
									<Action type="SetProperty" frame="QuestProgressBar" visible="False"/>
									<Action type="SetProperty" frame="UnfilledProgressImage" visible="False"/>
									<Action type="SetProperty" frame="QuestCompleteImage" visible="False"/>
									<Action type="SetProperty" frame="QuestProgressStackLabel" visible="False"/>
								</State>
							</StateGroup>
						</Frame>
