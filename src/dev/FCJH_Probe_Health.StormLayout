									</State>
									<State name="Crit4pc">
										<When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="4%"/>
										<Action type="SetProperty" frame="$this" Alpha="0"/>
										<Action type="SetProperty" frame="$parent/FCJH_CritMark" visible="true"/>
									</State>
									<State name="Crit4">
										<When type="Property" frame="$parent/FCJH_HPPercent/StatusLabel" Text="4"/>
