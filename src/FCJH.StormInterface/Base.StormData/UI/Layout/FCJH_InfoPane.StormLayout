											<State name="QuestSelected"/>
											<State name="QuestAvailable">
												<Action type="SetProperty" frame="$this/IconImage" texture="@UI/Storm_UI_InGame_Leader_Talent_Unselected"/>
											</State>
											<State name="QuestNotAvailable">
												<Action type="SetProperty" frame="$this/IconImage" visible="false"/>
											</State>
										</StateGroup>
									</Frame>
								</Frame>
							</Frame>
						</Frame>
					</Frame>
				</Frame>
			</Frame>
			<!-- Chrome: the title, over the rows, letting the mouse through to the tooltips (the
			     title band and frame are the skin's, under the rows). -->
			<Frame type="Frame" name="FCJH_InfoPaneChrome">
				<Anchor side="Top" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<RenderPriority val="600"/>
				<AcceptsMouse val="false"/>
				<Frame type="Label" name="FCJH_Title">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
					<Style val="ObsBar_MatchTimer"/>
					<Text val="TALENTS"/>
					<RenderPriority val="610"/>
					<AcceptsMouse val="false"/>
				</Frame>
			</Frame>
			<!-- close: Blizzard's close tab in the corner (tools/gen.py close_button) -->
			<Frame type="Button" name="FCJH_Close" template="StandardTemplates/SmallPanelCloseButtonTemplate">
				<Anchor side="Top"   relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_CLOSE_T"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_CLOSE_R"/>
				<Width val="#FCJH_INFO_PANE_CLOSE_W"/>
				<Height val="#FCJH_INFO_PANE_CLOSE_H"/>
				<RenderPriority val="650"/>
				<AcceptsMouse val="true"/>
				<Animation name="FCJH_Close">
					<Event event="OnClick" action="Reset,Play"/>
					<Controller type="Visibility" end="Stop" frame="$parent/$parent/FCJH_Pane_TalentsToggle">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
				</Animation>
			</Frame>
		</Frame>
	</Frame>
</Desc>
