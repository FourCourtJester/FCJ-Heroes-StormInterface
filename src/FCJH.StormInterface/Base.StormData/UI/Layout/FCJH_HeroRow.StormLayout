									<Anchor side="Bottom" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="84"/>
									<Text val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/FCJH_Kit_DeathwingCataclysm/AbilIcon/CooldownLabel/@Text}"/>
									<Style val="PartyFrame_HeroicTalentCooldown"/>
									<Options val="NoWrapping | ScaleToPreventTruncation"/>
									<Alpha val="0"/>
									<Unclipped val="true"/>
									<AcceptsMouse val="false"/>
