							</Frame>
							<Frame type="Image" name="UnfilledProgressImage"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/><Unclipped val="true"/><RenderPriority val="535"/><Alpha val="42"/><Texture val="@UI/Storm_UI_InGame_Tab_Screen_Progress_Bar_Background"/></Frame>
							<Frame type="ProgressBar" name="QuestProgressBar"><Anchor side="Top" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Left" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Right" relative="$parent/IconImage" pos="Mid" offset="0"/><Anchor side="Bottom" relative="$parent/IconImage" pos="Mid" offset="0"/><Width val="50"/><Height val="50"/>
								<Unclipped val="true"/><RenderPriority val="536"/><Vertical val="False"/><Circular val="true"/>
								<CircularStart val="0"/><CircularEndOffset val="360"/><FillInset val="0.0"/><Visible val="False"/>
								<MaxValue val="{$FCJH_QTestIcon1A/QuestProgressBar/@MaxValue}"/>
