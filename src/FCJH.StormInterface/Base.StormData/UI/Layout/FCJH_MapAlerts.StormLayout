<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Map alerts moved onto the plates ([map_alerts] in layout.toml).

	     How a map's alerts work: each map ships a panel template in its own layout file,
	     loaded only on that map, and the map's script builds it inside GameUI's
	     MapMechanicPanel and finds each alert by NAME to show it and set its text. So an
	     interface may move and restyle a template's alerts here (file="<the map's file>"), but
	     never rename or drop one: the script's lookup would fail.

	     Towers of Doom (FieldofSlaughter/MainFoSPanel): a 600-unit strip on the screen's right
	     edge, which clips what it holds - so whatever we move out of it is Unclipped. Its
	     alerts hang off the right edge in a chain, each stacked off the one before. The ones
	     a broadcast needs sit either side of the map at the
	     rows' inner ends, where the core bars live (user, 2026-10-06): the altar countdown
	     and, above it, the towers upgrading on red's side; the tunnels opening on blue's; and
	     the "cannons are firing" pair, each on its capturing team's side.
	     Each sits on its row's XP bar and steps up onto the core bar while that shows
	     (Blizzard shows a core bar while the core takes damage). An alert's art is a fixed
	     width, so each is placed by its frame's right edge (tools/gen.py MAP_ALERT_REACH):
	     red's start just right of the map's square, blue's end just left of it. -->
	<Frame type="Frame" name="MainFoSPanel" file="FieldofSlaughter">
		<Frame type="Frame" name="AltarSpawnNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B"/>
			<Anchor side="Right"  relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_OverCore">
				<DefaultState val="OnXP"/>
				<State name="OnCore">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus" Visible="true"/>
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B_CORE"/>
				</State>
				<State name="OnXP">
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B"/>
				</State>
			</StateGroup>
		</Frame>
		<!-- above the altar countdown, Blizzard's own step between its alerts (30) -->
		<Frame type="Frame" name="TowersNotificationFrame">
			<Anchor side="Bottom" relative="$parent/AltarSpawnNotificationFrame" pos="Min" offset="30"/>
			<Anchor side="Right"  relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
		</Frame>
		<Frame type="Frame" name="WaygateNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B"/>
			<Anchor side="Right"  relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_OverCore">
				<DefaultState val="OnXP"/>
				<State name="OnCore">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1CoreUnitStatus" Visible="true"/>
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B_CORE"/>
				</State>
				<State name="OnXP">
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B"/>
				</State>
			</StateGroup>
		</Frame>
		<!-- "Cannons are firing!" after an altar capture. The script shows RAVEN's alert when blue
		     captures and NECRO's when red does - only the text is per viewer ("Your" to the
		     capturing team's players, "Enemy" to the others). Sent to each team's players only:
		     a player view (1-8) shows them, the free observer view never does, and nothing an
		     observer's UI receives marks a capture (user, 2026-10-06 - tried: the core bars come
		     up once, at the first hit, and stay; the launch behaviour rides the cannonball). So
		     Blizzard's own, by the map on the capturing team's side (the warnings there come
		     before the altars activate). -->
		<Frame type="Frame" name="RavenNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B"/>
			<Anchor side="Right"  relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_OverCore">
				<DefaultState val="OnXP"/>
				<State name="OnCore">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1CoreUnitStatus" Visible="true"/>
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B_CORE"/>
				</State>
				<State name="OnXP">
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B"/>
				</State>
			</StateGroup>
			<!-- gone 5 s after it shows, whoever the script's own hide reaches: switching from a
			     player view to the everyone view inside those 5 s left it up for good - the hide
			     goes to the team's players only (user, 2026-10-06) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<Frame type="Frame" name="NecroNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B"/>
			<Anchor side="Right"  relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_OverCore">
				<DefaultState val="OnXP"/>
				<State name="OnCore">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus" Visible="true"/>
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B_CORE"/>
				</State>
				<State name="OnXP">
					<Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B"/>
				</State>
			</StateGroup>
			<!-- gone 5 s after it shows, whoever the script's own hide reaches: switching from a
			     player view to the everyone view inside those 5 s left it up for good - the hide
			     goes to the team's players only (user, 2026-10-06) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<!-- Blizzard's town-capture pair ("Allies / The Enemy captured <town>"), viewer-relative and
		     players-only: parked above the screen - ours (below) stand in for them in every view. -->
		<Frame type="Frame" name="EnemyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="-9999"/>
		</Frame>
		<Frame type="Frame" name="AllyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="-9999"/>
		</Frame>
		<!-- ===== Observer town alerts (user, 2026-10-06): Blizzard's town-capture alerts go only to
		     each team's players and name no team, so ours stand in, built from Blizzard's own
		     (same art and animation) with team names, on the capturing team's side, in every
		     view. On every change of hands the script sends the OBSERVER panel (our plates'
		     ObserverHeroOverviewPanel) "BroadcastToD<blue>v<red>", the towns each team holds -
		     Blizzard's own UI never uses it. Blue's count up: blue took a town; down: red did.
		     It comes with the new town's spawn, about a second after the old one falls (the
		     capture's other announcements - pings, sounds - aren't anything a layout can catch).
		     In the stack on its side: the lowest free slot, above whichever of Blizzard's alerts
		     by the map are showing. ===== -->
		<Frame type="Frame" name="FCJH_BlueTown" template="FieldofSlaughter/MainFoSPanel/AllyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B"/>
			<Anchor side="Right"  relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_R"/>
			<Unclipped val="true"/>
			<!-- the stack on this side: the lowest free slot, growing upward - above whichever
			     of Blizzard's alerts by the map are showing (user, 2026-10-06) -->
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OverTunnels"><When type="Property" frame="$parent/WaygateNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B_2"/></State>
				<State name="OverCannons"><When type="Property" frame="$parent/RavenNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B_2"/></State>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_BlueRow" pos="Min" offset="#FCJH_MAP_ALERT_BLUE_B"/></State>
			</StateGroup>
			<Frame type="Label" name="NotificationLabel"><Text val="Blue team captured"/></Frame>
			<Frame type="Label" name="NotificationTargetLabel"><Text val="a town"/></Frame>
			<!-- gone after 5 s, as Blizzard's (its script waits 5 s, then hides it) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<Frame type="Frame" name="FCJH_RedTown" template="FieldofSlaughter/MainFoSPanel/EnemyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B"/>
			<Anchor side="Right"  relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
			<!-- the stack on this side: the lowest free slot, growing upward - above whichever
			     of Blizzard's alerts by the map are showing (user, 2026-10-06) -->
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OverAltarTowers"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B_3"/></State>
				<State name="OverTowers"><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B_3"/></State>
				<State name="OverAltar"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OverCannons"><When type="Property" frame="$parent/NecroNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI/FCJH_RedRow" pos="Min" offset="#FCJH_MAP_ALERT_RED_B"/></State>
			</StateGroup>
			<Frame type="Label" name="NotificationLabel"><Text val="Red team captured"/></Frame>
			<Frame type="Label" name="NotificationTargetLabel"><Text val="a town"/></Frame>
			<!-- gone after 5 s, as Blizzard's (its script waits 5 s, then hides it) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<Frame type="Frame" name="FCJH_TownWatch">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<Frame type="Frame" name="FCJH_New0"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New1"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New2"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New3"><Anchor relative="$parent"/><Visible val="true"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New4"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New5"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New6"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur0"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur1"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur2"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur3"><Anchor relative="$parent"/><Visible val="true"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur4"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur5"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur6"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Animation name="FCJH_Split0">
				<Event event="BroadcastToD0v6" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync0"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync0">
				<Event event="FCJH_Sync0" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split1">
				<Event event="BroadcastToD1v5" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync1"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync1">
				<Event event="FCJH_Sync1" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split2">
				<Event event="BroadcastToD2v4" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync2"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync2">
				<Event event="FCJH_Sync2" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split3">
				<Event event="BroadcastToD3v3" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync3"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync3">
				<Event event="FCJH_Sync3" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split4">
				<Event event="BroadcastToD4v2" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync4"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync4">
				<Event event="FCJH_Sync4" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split5">
				<Event event="BroadcastToD5v1" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync5"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync5">
				<Event event="FCJH_Sync5" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split6">
				<Event event="BroadcastToD6v0" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync6"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync6">
				<Event event="FCJH_Sync6" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="true"/></Controller>
			</Animation>
			<StateGroup name="FCJH_WhoTook">
				<DefaultState val="Same"/>
				<State name="Blue1"><When type="Property" frame="$this/FCJH_Cur0" Visible="true"/><When type="Property" frame="$this/FCJH_New1" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue2"><When type="Property" frame="$this/FCJH_Cur1" Visible="true"/><When type="Property" frame="$this/FCJH_New2" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue3"><When type="Property" frame="$this/FCJH_Cur2" Visible="true"/><When type="Property" frame="$this/FCJH_New3" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue4"><When type="Property" frame="$this/FCJH_Cur3" Visible="true"/><When type="Property" frame="$this/FCJH_New4" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue5"><When type="Property" frame="$this/FCJH_Cur4" Visible="true"/><When type="Property" frame="$this/FCJH_New5" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Blue6"><When type="Property" frame="$this/FCJH_Cur5" Visible="true"/><When type="Property" frame="$this/FCJH_New6" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_BlueTown" event="Show"/></State>
				<State name="Red0"><When type="Property" frame="$this/FCJH_Cur1" Visible="true"/><When type="Property" frame="$this/FCJH_New0" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red1"><When type="Property" frame="$this/FCJH_Cur2" Visible="true"/><When type="Property" frame="$this/FCJH_New1" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red2"><When type="Property" frame="$this/FCJH_Cur3" Visible="true"/><When type="Property" frame="$this/FCJH_New2" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red3"><When type="Property" frame="$this/FCJH_Cur4" Visible="true"/><When type="Property" frame="$this/FCJH_New3" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red4"><When type="Property" frame="$this/FCJH_Cur5" Visible="true"/><When type="Property" frame="$this/FCJH_New4" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Red5"><When type="Property" frame="$this/FCJH_Cur6" Visible="true"/><When type="Property" frame="$this/FCJH_New5" Visible="true"/><Action type="SendEvent" frame="$parent/FCJH_RedTown" event="Show"/></State>
				<State name="Same"/>
			</StateGroup>
		</Frame>
		<!-- ===== end observer town alerts ===== -->
		<!-- The towns' shot counts (each team's towns plus the core shots), flanking the minimap's
		     middle on the screen's bottom edge (MapMechanicPanel TeamCollectionFrameTemplate). Their
		     panel filled the right-edge strip, which held Blizzard's minimap; ours is bottom-centre,
		     so the strip clipped them and they never showed (user, 2026-10-06). The panel now
		     spans the screen, unclipped. -->
		<Frame type="Frame" name="PotentialPointsPanel">
			<Anchor side="Top"    relative="$GameUI" pos="Min" offset="0"/>
			<Anchor side="Left"   relative="$GameUI" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="0"/>
			<Anchor side="Right"  relative="$GameUI" pos="Max" offset="0"/>
			<Unclipped val="true"/>
		</Frame>
	</Frame>
</Desc>
