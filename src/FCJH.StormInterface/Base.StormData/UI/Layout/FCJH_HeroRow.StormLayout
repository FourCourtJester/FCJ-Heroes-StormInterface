									<State name="Yes"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview5/HeroicTalentPanel/HeroicTalentFrame_Ready" Visible="true"/><Action type="SetProperty" frame="$this/FCJH_UltReady" Alpha="255"/></State>
