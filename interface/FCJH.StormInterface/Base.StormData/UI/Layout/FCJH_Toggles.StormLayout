<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- The operator's chat, player-name and HUD toggles (layout.toml [toggles]; user, 2026-10-16;
	     the HUD's 2026-10-25, below).
	     The replay box's is in FCJH_Replay, the inspect card's in FCJH_Inspect. Blizzard has no
	     key for either of these: Ahli and Spazzo both add one (docs/blizzard-fixes.md).

	     Chat: a ToggleControl beside Blizzard's ChatDisplay fades it out and in, as Ahli's does.

	     Names: the player name over every hero's health bar. The toggle is a handle
	     (FCJH_NAMES), and each name's Label binds its Visible to it. Ahli binds the names'
	     VisibleToOwner/Ally/Enemy instead, but some of Blizzard's bars hide their name on purpose
	     that way (the NoName templates, Medivh's raven, Volskaya's robot) and that would show
	     them; the Label only ever hides. Unit status frames are built when a unit appears, so
	     overriding the templates reaches them (unlike frames built at load, memory rule 31).
	     The list: every unit status frame in the JamiePhan extract with a PlayerUnitNameLabel,
	     through its templates (2026-10-16; Ahli's list had 31, without the newer heroes). -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="ToggleControl" name="FCJH_ChatToggle">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<CollapseLayout val="true"/>
					<Shortcut val="#FCJH_CHAT_KEY"/>
					<Animation name="FCJH_ChatShow">
						<Event event="OnShown" action="DirectionForward,Play"/>
						<Event event="OnHidden" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$parent/ChatDisplay">
							<Key type="Curve" time="0.0" value="0"/>
							<Key type="Curve" time="0.2" value="255"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$parent/ChatDisplay">
							<Key type="Bool" time="0.0" value="false"/>
							<Key type="Bool" time="0.001" value="true"/>
							<Key type="Bool" time="0.2" value="true"/>
						</Controller>
					</Animation>
				</Frame>
				<Frame type="ToggleControl" name="FCJH_NamesToggle">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<CollapseLayout val="true"/>
					<Handle val="FCJH_NAMES"/>
					<Shortcut val="#FCJH_NAMES_KEY"/>
				</Frame>
				<!-- The HUD (layout.toml [toggles] hud, hud_lower; user, 2026-10-25). Blizzard's own
				     ToggleHUD / ToggleFullHUD (stormobserverpanel) faded only their own panels, so our
				     pop-ups, panes and inspect card stayed on screen over a hidden HUD (a caster's Ctrl+E,
				     2026-10-24). Theirs lose their keys (FCJH_Replay) and these take them:
				       - hud (Ctrl+E): everything below, plus the top plate - the whole of Blizzard's
				         ObserverHeroOverviewPanel, as their Ctrl+E did, by this toggle's own animation.
				       - hud_lower (Ctrl+Shift+E): all but the top plate.
				     Below the top plate goes when EITHER key is on, so it can't be either toggle's own
				     animation: FCJH_HudWatch's states read both toggles and send one end="Pause"
				     animation forward or back (memory rule 38's pattern). The top plate and the rows
				     share Blizzard's panel, so the rows' pieces are faded one by one: the rows, the core
				     bars (in ObserverTopPanel; the XP bars have watchers of their own, below), the talent rows (Tracer's meter) and heroic
				     tips. Fade alone, never Visibility, on frames whose visibility the game or our own
				     gates own (the core bar, the inspect card, the panes); Fade and Visibility, as
				     Blizzard's, on the rows and the map panels. Nothing inside them may carry
				     IgnoreParentAlpha: it skips the fade and blinks off last on the Visibility key, as
				     the fountain's backdrop did until 2026-10-27. Our containers fade whole, so their watchers keep running. Chat, the kill
				     feed and the replay box keep their own keys, as with Blizzard's.
				     The game's end hides the same (user, 2026-10-25: "after the game, a health
				     notification bleeds thru"): Blizzard hides its plates for the victory splash, and a
				     heal pop-up that fired as the units went played out stretched over them. So
				     Blizzard's GameOverSplash, then its awards panel, count as a key held; a rewind
				     hides them again and the HUD comes back. -->
				<Frame type="ToggleControl" name="FCJH_HudToggle">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<CollapseLayout val="true"/>
					<Shortcut val="#FCJH_HUD_KEY"/>
					<Visible val="false"/>
					<Animation name="FCJH_HideTop">
						<Event event="OnShown" action="DirectionForward,Play"/>
						<Event event="OnHidden" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$parent/ObserverHeroOverviewPanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$parent/ObserverHeroOverviewPanel">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.19" value="true"/>
							<Key type="Bool" time="0.2" value="false"/>
						</Controller>
					</Animation>
				</Frame>
				<Frame type="ToggleControl" name="FCJH_HudLowerToggle">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<CollapseLayout val="true"/>
					<Shortcut val="#FCJH_HUD_LOWER_KEY"/>
					<Visible val="false"/>
				</Frame>
				<Frame type="Frame" name="FCJH_HudWatch">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Animation name="FCJH_HideLower">
						<Event event="FCJH_HudHide" action="DirectionForward,Play"/>
						<Event event="FCJH_HudShow" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.19" value="true"/>
							<Key type="Bool" time="0.2" value="false"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.19" value="true"/>
							<Key type="Bool" time="0.2" value="false"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.19" value="true"/>
							<Key type="Bool" time="0.2" value="false"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.19" value="true"/>
							<Key type="Bool" time="0.2" value="false"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1CoreUnitStatus">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/FCJH_HeroicTips">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/FCJH_HeroicTips2">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/ConsoleUIContainer/FCJH_Inspect">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/ConsoleUIContainer/CommandPanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/ConsoleUIContainer/FCJH_TalentTips">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/FCJH_HealPopups">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/FCJH_TalentPopups">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/FCJH_Pane_Talents">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/FCJH_Pane_Kda">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/FCJH_Pane_Healing">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/FCJH_Pane_Xp">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.2" value="0"/>
						</Controller>
					</Animation>
					<StateGroup name="FCJH_Hud">
						<DefaultState val="Shown"/>
						<State name="Over">
							<When type="Property" frame="$GameUI/UIContainer/GameOverSplash" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_HudHide"/>
						</State>
						<State name="Awards">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/EndOfGameAwardsPanel" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_HudHide"/>
						</State>
						<State name="All">
							<When type="Property" frame="$parent/FCJH_HudToggle" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_HudHide"/>
						</State>
						<State name="Lower">
							<When type="Property" frame="$parent/FCJH_HudLowerToggle" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_HudHide"/>
						</State>
						<State name="Shown">
							<Action type="SendEvent" frame="$this" event="FCJH_HudShow"/>
						</State>
					</StateGroup>
				</Frame>
				<!-- The XP bars hide on FCJH_HudWatch's keys and game end, and ALSO while their team has
				     no hero yet (the loading seconds, the intro), in one animation per team. One owner:
				     a paused Fade holds its frame's alpha, so while the XP frames sat in FCJH_HideLower,
				     its "Shown" state held them at 255 from load and row_packer's Heroes0 Alpha 0 never
				     showed (the bar up before any plate, user 2026-10-26/27). Their alpha is set here
				     only; row_packer still places them and cuts their textures.
				     THEY LOAD HIDDEN (Alpha 0 in FCJH_TopBar) and this fades them IN, so hidden is where
				     the animation starts and nothing has to happen at load. Fading them OUT from 255 left
				     the bar up for a moment at game start, until Empty caught it (user, 2026-10-27: "They
				     still showed, but just for a second"). For the same reason Shown needs the first hero
				     cell up rather than being the catch-all. -->
				<Frame type="Frame" name="FCJH_BlueXpWatch">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Animation name="FCJH_ShowXp">
						<Event event="FCJH_XpShow" action="DirectionForward,Play"/>
						<Event event="FCJH_XpHide" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/FCJH_BlueXPTrack">
							<Key type="Curve" time="0" value="0"/>
							<Key type="Curve" time="0.2" value="255"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1XPUnitStatusFrame">
							<Key type="Curve" time="0" value="0"/>
							<Key type="Curve" time="0.2" value="255"/>
						</Controller>
					</Animation>
					<StateGroup name="FCJH_BlueXp">
						<DefaultState val="Empty"/>
						<State name="Empty">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" Visible="false"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Over">
							<When type="Property" frame="$GameUI/UIContainer/GameOverSplash" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Awards">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/EndOfGameAwardsPanel" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="All">
							<When type="Property" frame="$parent/FCJH_HudToggle" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Lower">
							<When type="Property" frame="$parent/FCJH_HudLowerToggle" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Shown">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpShow"/>
						</State>
					</StateGroup>
				</Frame>
				<Frame type="Frame" name="FCJH_RedXpWatch">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<Animation name="FCJH_ShowXp">
						<Event event="FCJH_XpShow" action="DirectionForward,Play"/>
						<Event event="FCJH_XpHide" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/FCJH_RedXPTrack">
							<Key type="Curve" time="0" value="0"/>
							<Key type="Curve" time="0.2" value="255"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2XPUnitStatusFrame">
							<Key type="Curve" time="0" value="0"/>
							<Key type="Curve" time="0.2" value="255"/>
						</Controller>
					</Animation>
					<StateGroup name="FCJH_RedXp">
						<DefaultState val="Empty"/>
						<State name="Empty">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" Visible="false"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Over">
							<When type="Property" frame="$GameUI/UIContainer/GameOverSplash" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Awards">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/EndOfGameAwardsPanel" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="All">
							<When type="Property" frame="$parent/FCJH_HudToggle" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Lower">
							<When type="Property" frame="$parent/FCJH_HudLowerToggle" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpHide"/>
						</State>
						<State name="Shown">
							<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team2HeroOverview/HeroOverview1" Visible="true"/>
							<Action type="SendEvent" frame="$this" event="FCJH_XpShow"/>
						</State>
					</StateGroup>
				</Frame>
			</Frame>
		</Frame>
	</Frame>

	<Frame type="UnitStatusName" name="HeroUnit1SegmentStatusFrame/HeroUnitStatusParentFrame/PlayerUnitNameLabel" file="UnitStatus">
		<Frame type="Label" name="Label"><Visible val="{$FCJH_NAMES/@Visible}"/></Frame>
	</Frame>
	<Frame type="UnitStatusName" name="HeroUnitStatusFrameAllGreyNoEnergyTemplate/HeroUnitStatusParentFrame/PlayerUnitNameLabel" file="UnitStatus">
		<Frame type="Label" name="Label"><Visible val="{$FCJH_NAMES/@Visible}"/></Frame>
	</Frame>
