			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="69"/>
			<Width val="0"/>
			<Height val="0"/>
			<TextureCoords top="0.1" left="0.543" bottom="0.65" right="1.0"/>
			<ImageMaskTexture val="_Assets\Textures\FCJH_White.dds"/>
			<AlphaMaskTexture val="_Assets\Textures\FCJH_Portrait_blue_409bbae7.dds"/>
			<RenderPriority val="500"/>
		</Frame>
		<Frame type="Image" name="FCJH_Glass">
