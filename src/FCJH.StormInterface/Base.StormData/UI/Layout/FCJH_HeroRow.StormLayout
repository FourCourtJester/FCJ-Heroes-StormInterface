			</Frame>
			<Frame type="UnitStatusUnitTrackingBehavior" name="RexxarTrackingElement">
				<Anchor side="Left"  relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
				<Width val="0"/>
				<Frame type="UnitStatusFrame" name="TrackedUnitStatusFrame0">
					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Frame type="UnitStatusShieldedHealthBar" name="HealthBar"><Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFill_Sm"/><Tiled val="true"/></Frame>
				</Frame>
			</Frame>
			<Frame type="Image" name="FCJH_HealthBacking">
				<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="29"/>
				<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="50"/>
				<Anchor side="Right" relative="$parent/$parent" pos="Min" offset="173"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="73"/>
				<Texture val="@UI/HUD_TopBar_Team_HeroFrame_HealthFrame"/>
				<TextureType val="Nineslice"/>
				<Width val="0"/>
				<Height val="0"/>
				<RenderPriority val="450"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Image" name="FCJH_ManaBacking">
				<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="36"/>
				<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="63"/>
				<Anchor side="Right" relative="$parent/$parent" pos="Min" offset="175"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="73"/>
				<Texture val="@UI/HUD_TopBar_Team_HeroFrame_ManaFrame"/>
				<TextureType val="Nineslice"/>
				<Width val="0"/>
				<Height val="0"/>
				<RenderPriority val="450"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="UnitStatusEnergyBar" name="FCJH_Resource">
				<Anchor side="Left" relative="$parent/$parent" pos="Min" offset="41"/>
				<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="66"/>
				<Anchor side="Right" relative="$parent/$parent" pos="Min" offset="172"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="72"/>
				<Width val="0"/>
				<Height val="0"/>
				<Texture val="@UI/HUD_TopBar_Team_HeroFrame_ManaFill"/>
				<Tiled val="true"/>
				<BarCount val="1"/>
				<ColorStyle val="StandardEnergy" index="0"/>
				<Unclipped val="true"/>
			</Frame>
			<!-- CC: Blizzard's nameplate debuff element as an invisible SENSOR (it ships at
			     Alpha 0 and only fades in on a world-nameplate event observer cells never get).
			     Inside HeroStatus, so it reads this cell's own hero. Its text - "STUNNED",
			     "ROOTED"... - is mirrored into our own label. Recipe from build 50. -->
			<Frame type="UnitStatusBuffDebuffElement" name="FCJH_CC" template="UnitStatus/UnitStatusBuffDebuffDisplayTemplate">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="30"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="50"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Max" offset="0"/>
				<CollapseLayout val="true"/>
				<VisibleToOwner val="true"/>
				<VisibleToAlly val="true"/>
				<VisibleToEnemy val="true"/>
				<Unclipped val="true"/>
			</Frame>
			<!-- The text sits across the health bar (HeroStatus is the bar's rect), centred on it
			     both ways; the box reaches past the bar by the same amount on every side, so the
			     text can be bigger than the bar and stay centred. -->
			<Frame type="Label" name="FCJH_CCText">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="-20"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="-20"/>
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="20"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="20"/>
				<Text val="{$parent/FCJH_CC/DebuffLabel/@Text}"/>
				<Style val="FCJH_CCText"/>
				<Options val="NoWrapping | ScaleToPreventTruncation"/>
				<RenderPriority val="530"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<!-- ...and its icon, mirrored the same way, centred where the death timer is. Shown only while
			     Blizzard's own ICON is (not merely the element): when a CC ends, Blizzard's
			     NoState hides its icon and label but the element stays up for its ~1 s fade, and
			     the icon's default picture is @UI/Editor/BorderImage - a thin black box, seen in
			     game 2026-09-29 (matching the label's text against "" never fired). -->
			<Frame type="Image" name="FCJH_CCIcon">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="30"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Mid" offset="-9"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="54"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Mid" offset="15"/>
				<Texture val="{$parent/FCJH_CC/DebuffIconLeft/@Texture}"/>
				<Alpha val="0"/>
				<RenderPriority val="530"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
				<StateGroup name="FCJH_WhenCC">
					<DefaultState val="None"/>
					<State name="CC">
						<When type="Property" frame="$parent/FCJH_CC" Visible="true"/>
						<When type="Property" frame="$parent/FCJH_CC/DebuffIconLeft" Visible="true"/>
						<Action type="SetProperty" frame="$this" Alpha="255"/>
						<Action type="SetProperty" frame="$parent/FCJH_CCText" Alpha="255"/>
					</State>
					<State name="None">
						<Action type="SetProperty" frame="$this" Alpha="0"/>
						<Action type="SetProperty" frame="$parent/FCJH_CCText" Alpha="0"/>
					</State>
				</StateGroup>
			</Frame>
			<StateGroup name="FCJH_ResourceColour">
				<DefaultState val="Normal"/>
				<State name="Auriel"><When type="Property" Unit="HeroAuriel"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="Chen"><When type="Property" Unit="HeroChen"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="Deathwing"><When type="Property" Unit="HeroDeathwing"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DeathwingEnergy"/></State>
				<State name="DVaPilot"><When type="Property" Unit="HeroDVaPilot"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="DVaMech"><When type="Property" Unit="HeroDVaMech"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="Junkrat"><When type="Property" Unit="HeroJunkrat"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/></State>
				<State name="Morales"><When type="Property" Unit="HeroMedic"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="Sonya"><When type="Property" Unit="HeroBarbarian"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/></State>
				<State name="Tracer"><When type="Property" Unit="HeroTracer"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="StandardEnergy"/></State>
				<State name="Valeera"><When type="Property" Unit="HeroValeera"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="BrewEnergy"/></State>
				<State name="VolskayaGunner"><When type="Property" Unit="VolskayaVehicleGunner"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="Zarya"><When type="Property" Unit="HeroZarya"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="DivaEnergy"/></State>
				<State name="Gazlowe"><When type="Property" Unit="HeroTinker"/><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="FuryEnergy"/></State>
				<State name="Normal"><Action type="SetProperty" frame="FCJH_Resource" ColorStyle="StandardEnergy"/></State>
			</StateGroup>
			<!-- Fountain: Blizzard's fountain behaviour icon (hero console) as an invisible
			     SENSOR - present only while this hero's fountain is on cooldown. Our marker,
			     Blizzard's own "fountain ready" art, shows whenever the sensor is absent. -->
			<Frame type="UnitStatusBehaviorIcon" name="FCJH_FountainSensor">
				<Anchor relative="$parent"/>
				<Behavior val="HealingFountainCooldown"/>
				<Alpha val="0"/>
				<AcceptsMouse val="false"/>
				<AcceptsMouseTooltip val="false"/>
				<Frame type="BehaviorIcon" name="BehaviorIcon" template="BehaviorBar/BehaviorIconTemplate">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
				</Frame>
			</Frame>
			<!-- Blizzard's token art is already slanted, leaning / like the red plates: blue
			     shows it mirrored so it leans the same way as its own plate -->
			<Frame type="Image" name="FCJH_FountainReady">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="3"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Min" offset="11"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="25"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Min" offset="33"/>
				<Texture val="@UI/Storm_UI_Ingame_HealingWell_Active"/>
				<TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
				<RenderPriority val="525"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
				<StateGroup name="FCJH_Fountain">
					<DefaultState val="Ready"/>
					<State name="Cooldown">
						<When type="Property" frame="$parent/FCJH_FountainSensor" Visible="true"/>
						<Action type="SetProperty" frame="$this" Alpha="0"/>
					</State>
					<State name="Ready">
						<Action type="SetProperty" frame="$this" Alpha="255"/>
					</State>
				</StateGroup>
			</Frame>
			<!-- EXPERIMENT (2026-09-27): Abathur's clone (Ultimate Evolution). Blizzard puts
			     AbathurUltimateEvolutionVehicleCasterBehavior on Abathur when the clone spawns
			     (UltimateEvolutionCastSet, WhichUnit Source) and removes it when the clone ends;
			     an interrupted cast doesn't reach it. Same sensor trick as the fountain. While it's
			     on: the portrait mirrors (FCJH_ClonePortrait, in the cell), the Ultimate Evolution
			     icon sits where the death timer does, and "CLONE" runs across the health bar.
			     The bar itself stays Abathur's: nothing links him to the clone unit (his only unit
			     tracker is the Monstrosity's). -->
			<Frame type="UnitStatusBehaviorIcon" name="FCJH_CloneSensor">
				<Anchor relative="$parent"/>
				<Behavior val="AbathurUltimateEvolutionVehicleCasterBehavior"/>
				<Alpha val="0"/>
				<AcceptsMouse val="false"/>
				<AcceptsMouseTooltip val="false"/>
				<Frame type="BehaviorIcon" name="BehaviorIcon" template="BehaviorBar/BehaviorIconTemplate">
					<Anchor relative="$parent"/>
					<AcceptsMouse val="false"/>
					<AcceptsMouseTooltip val="false"/>
				</Frame>
			</Frame>
			<Frame type="Image" name="FCJH_CloneIcon">
				<Anchor side="Top"    relative="$parent/$parent" pos="Min" offset="30"/>
				<Anchor side="Left"   relative="$parent/$parent" pos="Mid" offset="-9"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="54"/>
				<Anchor side="Right"  relative="$parent/$parent" pos="Mid" offset="15"/>
				<Texture val="Assets\Textures\storm_ui_icon_abathur_ultimateevolution.dds"/>
				<Alpha val="0"/>
				<RenderPriority val="531"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Label" name="FCJH_CloneText">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="-20"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="-20"/>
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="20"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="20"/>
				<Text val="CLONE"/>
				<Style val="FCJH_CCText"/>
				<Alpha val="0"/>
				<RenderPriority val="531"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<StateGroup name="FCJH_Clone">
				<DefaultState val="None"/>
				<State name="Clone">
					<When type="Property" frame="$this/FCJH_CloneSensor" Visible="true"/>
					<Action type="SetProperty" frame="$this/FCJH_CloneIcon" Alpha="255"/>
					<Action type="SetProperty" frame="$this/FCJH_CloneText" Alpha="255"/>
					<Action type="SetProperty" frame="$parent/FCJH_ClonePortrait" Alpha="255"/>
				</State>
				<State name="None">
					<Action type="SetProperty" frame="$this/FCJH_CloneIcon" Alpha="0"/>
					<Action type="SetProperty" frame="$this/FCJH_CloneText" Alpha="0"/>
					<Action type="SetProperty" frame="$parent/FCJH_ClonePortrait" Alpha="0"/>
				</State>
			</StateGroup>
			<!-- Vikings: the plate's own click target steps aside so each Viking's (inside this
			     frame, which sits under the plate's target in the cell) gets the click -->
			<StateGroup name="FCJH_VikingClicks">
				<DefaultState val="Plate"/>
				<State name="Vikings">
					<When type="Property" frame="$this/VikingTrackingElement" Visible="true"/>
					<Action type="SetProperty" frame="$parent/TargetHeroUnitFrame" Visible="false"/>
				</State>
				<State name="Plate">
					<Action type="SetProperty" frame="$parent/TargetHeroUnitFrame" Visible="true"/>
				</State>
			</StateGroup>
		</Frame>
	</Frame>

