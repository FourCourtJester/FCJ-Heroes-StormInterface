<Desc>
<!-- GENERATED by tools/gen.py from layout.toml. Do not edit by hand:
     change layout.toml (or tools/gen.py) and rebuild. -->

	<!-- Each battleground's own UI on our screen (tools/maps.py, which says how a map's UI works).

	     Per map: the minimap's place - the map drawn with its bottom on the screen's padding
	     line, as the plates ([minimap] nudge to adjust one); the map's objective panel moved
	     with the minimap, so it sits round ours as it sat round Blizzard's; and the alerts that
	     belong to a team in a stack on that team's side of the map, on its plates' inner end
	     (user, 2026-10-05/06): on the XP bar, or the core bar while that shows (Blizzard shows
	     it while the core takes damage), one slot up for each alert below it that's showing.
	     Neutral alerts stay in their panel, above the map.

	     The older five maps' panels are Blizzard's core ones, here first; then each newer map's
	     own file. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="ConsoleUIContainer">
				<Frame type="MinimapPanel" name="MinimapPanel">
					<!-- The older maps' places. Their panels are all shown while the UI loads (the
					     template's default) until the script hides them: "Loading" holds still through
					     that. "Default" moves nothing - on the other maps their own panels place it,
					     or it stays where FCJH_Minimap puts it ([minimap] bottom). -->
					<StateGroup name="FCJH_MapPlace">
						<DefaultState val="Default"/>
						<State name="Loading"><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/BlackheartsBayPanel" Visible="true"/><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/RavenCourtPanel" Visible="true"/><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/DragonShirePanel" Visible="true"/><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/GardenOfTerrorPanel" Visible="true"/><When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/HauntedMinesPanel" Visible="true"/></State>
						<State name="blackhearts_bay">
							<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/BlackheartsBayPanel" Visible="true"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_BLACKHEARTS_BAY"/>
						</State>
						<State name="cursed_hollow">
							<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/RavenCourtPanel" Visible="true"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_CURSED_HOLLOW"/>
						</State>
						<State name="dragon_shire">
							<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/DragonShirePanel" Visible="true"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_DRAGON_SHIRE"/>
						</State>
						<State name="garden_of_terror">
							<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/GardenOfTerrorPanel" Visible="true"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_GARDEN_OF_TERROR"/>
						</State>
						<State name="haunted_mines">
							<When type="Property" frame="$GameUI/UIContainer/ConsoleUIContainer/MapMechanicPanel/HauntedMinesPanel" Visible="true"/>
