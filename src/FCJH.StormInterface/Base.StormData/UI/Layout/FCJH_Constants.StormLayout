	<!-- Hero cells: Blizzard's in-game cell at native size (tools/gen.py HeroCell) -->
	<Constant name="FCJH_HERO_POPUP_SIZE" val="44"/>
	<Constant name="FCJH_HERO_POPUP_T" val="-22"/>  <!-- the icon straddles the cell's top edge -->
	<Constant name="FCJH_HERO_BLUE_POPUP_L" val="-48"/>
	<Constant name="FCJH_HERO_BLUE_POPUP_R" val="-4"/>
	<Constant name="FCJH_HERO_RED_POPUP_L" val="4"/>
	<Constant name="FCJH_HERO_RED_POPUP_R" val="48"/>

	<!-- the info panes' look: the inspect card's (tools/inspect_card.py pane_skin) -->
	<Frame type="Frame" name="FCJH_PaneSkin">
		<RenderPriority val="400"/>
		<AcceptsMouse val="false"/>
		<Frame type="Image" name="FCJH_SkinBack">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
			<Texture val="@UI/Storm_TutorialReferenceCardBG"/>
			<TextureType val="Nineslice"/>
			<Tiled val="true"/>
			<Alpha val="180"/>
			<RenderPriority val="400"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Frame type="Image" name="FCJH_SkinTitle">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="3"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="3"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="-3"/>
			<Color val="564c6d"/>
			<Alpha val="76"/>
			<RenderPriority val="410"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<Frame type="Image" name="FCJH_SkinTitleLine">
			<Anchor side="Top"    relative="$parent/FCJH_SkinTitle" pos="Max" offset="-1"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Bottom" relative="$parent/FCJH_SkinTitle" pos="Max" offset="0"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
			<Color val="73668d"/>
			<Alpha val="76"/>
			<RenderPriority val="412"/>
			<AcceptsMouse val="false"/>
		</Frame>
		<!-- the outer border: Blizzard's Tab panel's (tools/inspect_card.py tab_border) -->
		<Frame type="Frame" name="FCJH_SkinTabBorder">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="-12"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="-12"/>
			<Anchor side="Bottom" relative="$parent" pos="Max" offset="12"/>
			<Anchor side="Right"  relative="$parent" pos="Max" offset="12"/>
			<RenderPriority val="420"/>
			<Unclipped val="true"/>
			<AcceptsMouse val="false"/>
			<Frame type="Frame" name="UpperHalf">
				<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
				<AcceptsMouse val="false"/>
				<Frame type="Image" name="BorderLeft">
					<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent/$parent" pos="Max" offset="0"/>
					<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
					<Texture val="@UI/Storm_UI_InGame_Leader_Background_VerticalBorder"/>
					<TextureType val="Nineslice"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="BorderRight">
					<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent/$parent" pos="Max" offset="0"/>
					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Texture val="@UI/Storm_UI_InGame_Leader_Background_VerticalBorder"/>
					<TextureType val="Nineslice"/>
					<TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
					<AcceptsMouse val="false"/>
				</Frame>
			</Frame>
			<Frame type="Frame" name="LowerHalf">
				<Anchor side="Top"    relative="$parent" pos="Mid" offset="0"/>
				<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
				<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
				<AcceptsMouse val="false"/>
				<Frame type="Image" name="BorderLeft">
					<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent/$parent" pos="Max" offset="0"/>
					<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
					<Texture val="@UI/Storm_UI_InGame_Leader_Background_VerticalBorder"/>
					<TextureType val="Nineslice"/>
					<TextureCoords top="1.0" left="0.0" bottom="0.0" right="1.0"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="BorderRight">
					<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent/$parent" pos="Max" offset="0"/>
					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Texture val="@UI/Storm_UI_InGame_Leader_Background_VerticalBorder"/>
					<TextureType val="Nineslice"/>
					<TextureCoords top="1.0" left="1.0" bottom="0.0" right="0.0"/>
					<AcceptsMouse val="false"/>
				</Frame>
			</Frame>
			<Frame type="Image" name="BorderTop">
				<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
				<Anchor side="Left" relative="$parent/UpperHalf/BorderLeft" pos="Max" offset="0"/>
				<Anchor side="Right" relative="$parent/UpperHalf/BorderRight" pos="Min" offset="0"/>
				<Texture val="@UI/Storm_UI_InGame_Leader_Background_HorizontalBorder"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Image" name="BorderBottom">
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
				<Anchor side="Left" relative="$parent/LowerHalf/BorderLeft" pos="Max" offset="0"/>
				<Anchor side="Right" relative="$parent/LowerHalf/BorderRight" pos="Min" offset="0"/>
				<Texture val="@UI/Storm_UI_InGame_Leader_Background_HorizontalBorder"/>
				<TextureCoords top="1.0" left="0.0" bottom="0.0" right="1.0"/>
				<Unclipped val="true"/>
				<AcceptsMouse val="false"/>
			</Frame>
		</Frame>
	</Frame>
</Desc>
