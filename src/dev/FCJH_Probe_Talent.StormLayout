<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): talent pop-ups, round 4.

	     Round 2: the TierSelected trigger WORKS when watched from outside the talent tree (by
	     full path), but anything placed INSIDE a talent icon never draws.
	     Round 3: pop-ups outside the tree, icons addressed by added HANDLES - only ONE player
	     (Auriel, PlayerFrame4) ever fired, through level 7.
	     Round 4: identical, but every icon addressed by its FULL PATH, the form that worked.
	       - one pop-up per player, anchored to that player's hero cell by Blizzard's mapping
	         (PlayerFrameN -> Team1 HeroOverview1..5, Team2 HeroOverview1..5); seven images
	         inside, one per tier, each bound to its tier icon's picture
	       - 70 watchers: when a tier fires (once, latched), show that image and pop for 4 s
	     Look for: the picked talent's icon sliding up from the plate's middle to straddle its
	     top edge (0.35 s, fading in), holding there 5 s, then fading out over 0.5 s (gone at
	     5.85 s); framed in the talent pane's team-coloured square. The heal pop-up is to share
	     this exact motion and spot (user, 2026-09-27). -->

	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="FCJH_TalentPopups">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<RenderPriority val="530"/>  <!-- over the heal pop-ups (FCJH_Probe_HealPop, 520) -->
			<Frame type="Frame" name="FCJH_Pop0">
				<Anchor side="Top"   relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="#FCJH_HERO_POPUP_T"/>
				<Anchor side="Left"  relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_L"/>
				<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Mid" offset="#FCJH_HERO_BLUE_POPUP_R"/>
				<Height val="#FCJH_HERO_POPUP_SIZE"/>
				<Visible val="false"/>
				<AcceptsMouse val="false"/>
				<Frame type="Image" name="T1">
					<Anchor relative="$parent"/>
					<Texture val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon1/IconImage/@Texture}"/>
					<Visible val="false"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="T2">
					<Anchor relative="$parent"/>
					<Texture val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon2/IconImage/@Texture}"/>
					<Visible val="false"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="T3">
					<Anchor relative="$parent"/>
					<Texture val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon3/IconImage/@Texture}"/>
					<Visible val="false"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="T4">
					<Anchor relative="$parent"/>
					<Texture val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4/IconImage/@Texture}"/>
					<Visible val="false"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="T5">
					<Anchor relative="$parent"/>
					<Texture val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon5/IconImage/@Texture}"/>
					<Visible val="false"/>
