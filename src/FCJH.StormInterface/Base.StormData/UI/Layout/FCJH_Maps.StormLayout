				<State name="Placed">
					<When type="Property" frame="$parent" Visible="true"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_TOMB_OF_THE_SPIDER_QUEEN"/>
				</State>
				<State name="Waiting"/>
			</StateGroup>
		</Frame>
	</Frame>
	<!-- ===== Towers of Doom ===== -->
	<Frame type="Frame" name="MainFoSPanel" file="FieldofSlaughter">
		<!-- the minimap's place on Towers of Doom, once this panel shows -->
		<Frame type="Frame" name="FCJH_MinimapPlace">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<StateGroup name="FCJH_Place">
				<DefaultState val="Waiting"/>
				<State name="Placed">
					<When type="Property" frame="$parent" Visible="true"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Left"   relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_L"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_TOWERS_OF_DOOM"/>
				</State>
				<State name="Waiting"/>
			</StateGroup>
		</Frame>
		<!-- blue, the bottom slot: the tunnels opening -->
		<Frame type="Frame" name="WaygateNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B"/>
			<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MAP_ALERT_BLUE_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B"/></State>
			</StateGroup>
		</Frame>
		<!-- blue, over 1 before it: Blizzard's, players-only ("Your/Enemy cannons are firing") -->
		<Frame type="Frame" name="RavenNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B"/>
			<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MAP_ALERT_BLUE_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OverWaygate"><When type="Property" frame="$parent/WaygateNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B_2"/></State>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B"/></State>
			</StateGroup>
			<!-- gone 5 s after it shows, whoever the script's own hide reaches: switching from a
			     player view to the everyone view inside those 5 s left it up for good - the hide
			     goes to the team's players only (user, 2026-10-06) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<!-- blue, over 2 before it: ours, which team took a town (towers_extra) -->
		<Frame type="Frame" name="FCJH_BlueTown" template="FieldofSlaughter/MainFoSPanel/AllyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B"/>
			<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MAP_ALERT_BLUE_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OverWaygateRaven"><When type="Property" frame="$parent/WaygateNotificationFrame" Visible="true"/><When type="Property" frame="$parent/RavenNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B_3"/></State>
				<State name="OverWaygate"><When type="Property" frame="$parent/WaygateNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B_2"/></State>
				<State name="OverRaven"><When type="Property" frame="$parent/RavenNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B_2"/></State>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_BLUE_B"/></State>
			</StateGroup>
			<Frame type="Label" name="NotificationLabel"><Text val="Blue team captured"/></Frame>
			<Frame type="Label" name="NotificationTargetLabel"><Text val="a town"/></Frame>
			<!-- gone after 5 s, as Blizzard's (its script waits 5 s, then hides it) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<!-- red, the bottom slot: the altar countdown -->
		<Frame type="Frame" name="AltarSpawnNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/>
			<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/></State>
			</StateGroup>
		</Frame>
		<!-- red, over 1 before it: the towers upgrading -->
		<Frame type="Frame" name="TowersNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/>
			<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OverAltarSpawn"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/></State>
			</StateGroup>
		</Frame>
		<!-- red, over 2 before it: Blizzard's, players-only ("Your/Enemy cannons are firing") -->
		<Frame type="Frame" name="NecroNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/>
			<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OverAltarSpawnTowers"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_3"/></State>
				<State name="OverAltarSpawn"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OverTowers"><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/></State>
			</StateGroup>
			<!-- gone 5 s after it shows, whoever the script's own hide reaches: switching from a
			     player view to the everyone view inside those 5 s left it up for good - the hide
			     goes to the team's players only (user, 2026-10-06) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<!-- red, over 3 before it: ours, which team took a town (towers_extra) -->
		<Frame type="Frame" name="FCJH_RedTown" template="FieldofSlaughter/MainFoSPanel/EnemyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/>
			<Anchor side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MAP_ALERT_RED_R"/>
			<Unclipped val="true"/>
			<StateGroup name="FCJH_Stack">
				<DefaultState val="Bottom"/>
				<State name="OverAltarSpawnTowersNecro"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><When type="Property" frame="$parent/NecroNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_4"/></State>
				<State name="OverAltarSpawnTowers"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_3"/></State>
				<State name="OverAltarSpawnNecro"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><When type="Property" frame="$parent/NecroNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_3"/></State>
				<State name="OverTowersNecro"><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><When type="Property" frame="$parent/NecroNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_3"/></State>
				<State name="OverAltarSpawn"><When type="Property" frame="$parent/AltarSpawnNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OverTowers"><When type="Property" frame="$parent/TowersNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OverNecro"><When type="Property" frame="$parent/NecroNotificationFrame" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_2"/></State>
				<State name="OnCore"><When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team2CoreUnitStatus" Visible="true"/><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B_CORE"/></State>
				<State name="Bottom"><Action type="SetAnchor" frame="$this" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MAP_ALERT_RED_B"/></State>
			</StateGroup>
			<Frame type="Label" name="NotificationLabel"><Text val="Red team captured"/></Frame>
			<Frame type="Label" name="NotificationTargetLabel"><Text val="a town"/></Frame>
			<!-- gone after 5 s, as Blizzard's (its script waits 5 s, then hides it) -->
			<Animation name="FCJH_Timer">
				<Event event="Show" action="Restart,Play"/>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="5" event="Hide"/>
				</Controller>
			</Animation>
		</Frame>
		<!-- Blizzard's town-capture pair ("Allies / The Enemy captured <town>"), viewer-relative and
		     players-only: parked above the screen - ours stand in for them in every view. -->
		<Frame type="Frame" name="EnemyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="-9999"/>
		</Frame>
		<Frame type="Frame" name="AllyCaptureNotificationFrame">
			<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="-9999"/>
		</Frame>
		<!-- Which team took a town (user, 2026-10-06). Blizzard's town-capture alerts go only to
		     each team's players and name no team, so ours stand in (FCJH_BlueTown / FCJH_RedTown,
		     in the stacks above), on the capturing team's side, in every view. On every change
		     of hands the script sends the OBSERVER panel (our plates' ObserverHeroOverviewPanel)
		     "BroadcastToD<blue>v<red>", the towns each team holds - Blizzard's own UI never uses
		     it. New<n>: the split just sent; Cur<n>: the one before, copied 0.1 s later. Blue's
		     count up: blue took a town; down: red did. It comes with the new town's spawn,
		     about a second after the old one falls. -->
		<Frame type="Frame" name="FCJH_TownWatch">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<Frame type="Frame" name="FCJH_New0"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New1"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New2"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New3"><Anchor relative="$parent"/><Visible val="true"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New4"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New5"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_New6"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur0"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur1"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur2"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur3"><Anchor relative="$parent"/><Visible val="true"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur4"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur5"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Frame type="Frame" name="FCJH_Cur6"><Anchor relative="$parent"/><Visible val="false"/><AcceptsMouse val="false"/></Frame>
			<Animation name="FCJH_Split0">
				<Event event="BroadcastToD0v6" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync0"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync0">
				<Event event="FCJH_Sync0" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split1">
				<Event event="BroadcastToD1v5" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync1"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync1">
				<Event event="FCJH_Sync1" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split2">
				<Event event="BroadcastToD2v4" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New6"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Event" end="Stop">
					<Key type="Event" time="0.1" event="FCJH_Sync2"/>
				</Controller>
			</Animation>
			<Animation name="FCJH_Sync2">
				<Event event="FCJH_Sync2" action="Restart,Play"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur2"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur3"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur4"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur5"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_Cur6"><Key type="Bool" time="0" value="false"/></Controller>
			</Animation>
			<Animation name="FCJH_Split3">
				<Event event="BroadcastToD3v3" action="Restart,Play" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel"/>
				<Controller type="Visibility" end="Pause" frame="FCJH_New0"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New1"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New2"><Key type="Bool" time="0" value="false"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New3"><Key type="Bool" time="0" value="true"/></Controller>
				<Controller type="Visibility" end="Pause" frame="FCJH_New4"><Key type="Bool" time="0" value="false"/></Controller>
