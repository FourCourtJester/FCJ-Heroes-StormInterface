<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Blizzard panels we keep hidden.

	     The player HUD (ability bar, hero console, buffs, 3D portrait) and the small
	     draggable inspect box: the engine switches these back on whenever it likes (a
	     camera or follow change brought the HUD back mid-replay), and Visible=false or
	     parking doesn't hold against that. What does - build 50's recipe - is an animation
	     that asserts them hidden every frame (end="Loop"; animations outrank properties).
	     It lives on a SelectionUnitStatusPanel pinned to a hero, so it always has a unit and
	     its OnShown always fires. Parked: nothing here needs to be seen. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="SelectionUnitStatusPanel" name="FCJH_HudHider">
			<Anchor side="Top"    relative="$parent" pos="Min" offset="9999"/>
			<Anchor side="Left"   relative="$parent" pos="Min" offset="9999"/>
			<Anchor side="Bottom" relative="$parent" pos="Min" offset="10099"/>
			<Anchor side="Right"  relative="$parent" pos="Min" offset="10099"/>
			<PlayerId val="1"/>
			<HeroesOnly val="true"/>
			<AlwaysShowHero val="true"/>
			<AcceptsMouse val="false"/>
			<AcceptsMouseTooltip val="false"/>
			<Frame type="UnitStatusFrame" name="UnitStatusFrame0">
				<Anchor relative="$parent"/>
				<AcceptsMouse val="false"/>
				<Animation name="FCJH_KeepHidden">
					<Event event="OnShown" action="Play"/>
					<!-- (the command card - CommandPanel - is shown and hidden with the inspect card
					     instead: FCJH_Inspect, inspect_card.command_switch) -->
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroConsolePanel">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroBuffDebuffPanel">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$ConsolePortraitPanelContainer/PortraitPanel">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<!-- the selected hero's cast / channel bars ("Mounting"...), bottom centre: part
					     of the player HUD, seen stuck on screen (2026-09-29) -->
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroCastChannelBarFrame">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroBehaviorChannelBarSurroundFrame">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroBehaviorChannelBarFrame">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroBehaviorChannelBarFrameRight">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<!-- "choose a talent": the picker, its toggle button and indicators. Observing
					     one player (Blizzard's 1-8 keys) brings them up; never wanted in a replay
					     (user, 2026-09-29) -->
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/FloatingCombatUnitSelectionPanel/UnitStatusFrame0/HeroTalentTreeSelectionPanel">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroTalentTreeSelectionToggleButton">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroTalentTreeSelectionIndicator">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/HeroTalentTreeSelectionIndicatorContainer">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/TalentPauseNotificationContainer">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<!-- Blizzard's inspect box's contents (the box itself is left to the game - our card
					     follows it, below), and the same unused pieces in our card's copy of it: parked,
					     they still drew thin screen-wide lines (their bars' ticks), seen through the
					     card once it went see-through (user, 2026-10-05) -->
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/FullscreenUpperContainer/TargetInfoFrame/TargetInfoPanel">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/FCJH_Inspect/TargetInfoPanel/HealthAndManaUnitStatusFrame">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/FCJH_Inspect/TargetInfoPanel/TargetPortraitFrame">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/FCJH_Inspect/TargetInfoPanel/AdditionalInfoIcon">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
					<Controller type="Visibility" end="Loop" frame="$GameUI/UIContainer/ConsoleUIContainer/FCJH_Inspect/TargetInfoPanel/TargetHeroUnitFrame">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
				</Animation>
			</Frame>
		</Frame>
		<!-- Blizzard's small inspect box: our inspect card replaces it, but it must NOT be forced
		     hidden like the HUD above - its visibility is what our card follows (the default
		     UI's rule: shown for a unit selected in the world, not for a plate click; our card
		     on its own came up on a game's first plate click, 2026-09-30). So it's left to the
		     game to show and hide, and made unseeable instead: parked off screen, see-through,
		     mouse off, not draggable (a drag position could bring it back on screen). -->
		<Frame type="Frame" name="UIContainer">
			<Frame type="Frame" name="FullscreenUpperContainer">
				<Frame type="TargetInfoFrame" name="TargetInfoFrame">
					<Anchor side="Top"    relative="$GameUI" pos="Min" offset="9999"/>
					<Anchor side="Left"   relative="$GameUI" pos="Min" offset="9999"/>
					<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="10116"/>
					<Anchor side="Right"  relative="$GameUI" pos="Min" offset="10225"/>
					<Alpha val="0"/>
					<AcceptsMouse val="false"/>
					<Draggable val="false"/>
					<!-- ...but the box itself didn't stay parked: it's held inside the screen (its
					     DragConstraintFrame), and sat mid-screen unseen, its bars' segment ticks
					     showing as thin lines and its health, resource and stat tooltips answering
					     the mouse (user, 2026-10-05; in screenshots since 2026-10-02). Its contents
					     are parked instead - a child isn't held by its parent's drag constraint. -->
					<Frame type="Frame" name="TargetInfoPanel">
						<Anchor side="Top"    relative="$GameUI" pos="Min" offset="9999"/>
						<Anchor side="Left"   relative="$GameUI" pos="Min" offset="9999"/>
						<Anchor side="Bottom" relative="$GameUI" pos="Min" offset="10116"/>
						<Anchor side="Right"  relative="$GameUI" pos="Min" offset="10225"/>
						<Alpha val="0"/>
						<AcceptsMouse val="false"/>
						<AcceptsMouseTooltip val="false"/>
					</Frame>
				</Frame>
			</Frame>
		</Frame>
	</Frame>
</Desc>
