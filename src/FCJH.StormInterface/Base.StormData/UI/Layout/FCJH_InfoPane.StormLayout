			<!-- Chrome: title band and a frame line, over the rows (they're drawn on top, so they
			     never hide a talent; they let the mouse through to the tooltips). -->
			<Frame type="Frame" name="FCJH_InfoPaneChrome">
				<Anchor side="Top" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<RenderPriority val="600"/>
				<AcceptsMouse val="false"/>
				<Frame type="Image" name="FCJH_TitleBand">
					<Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Texture val="@UI/PauseScreenDimImage"/>
					<ColorAdjustMode val="Fill"/>
					<AdjustmentColor val="235,24,28,48"/>
					<RenderPriority val="600"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Label" name="FCJH_Title">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
					<Style val="ObsBar_MatchTimer"/>
					<Text val="TALENTS"/>
					<RenderPriority val="610"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_BorderTop">
