									<Event event="OnHidden" action="Reset,Play" frame="$parent/HeroDeathTimeLabel"/>
									<Controller type="Style" end="Pause" frame="FCJH_DeathTime" style1="Storm_TopBar_DeathTimer" style2="Storm_TopBar_DeathTimer">
										<Key type="Curve" time="0" value="0"/>
										<Key type="Curve" time=".01" value="0"/>
									</Controller>
								</Animation>
							</Frame>
							<Frame type="Frame" name="FCJH_DeathSkull">
								<Frame type="Image" name="FCJH_RespawnGlow">
									<Animation name="FCJH_RespawnPulse">
										<Event event="HeroAlmostRespawned" action="Reset,Play" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1"/>
										<Event event="HeroRespawned" action="Reset,Stop" frame="$GameUI/UIContainer/ConsoleUIContainer/PartyFramePanel/Team1HeroOverview/HeroOverview1"/>
										<Event event="OnHidden" action="Reset,Stop" frame="$parent/$parent/HeroDeathTimeLabel"/>
										<Controller type="Fade" end="Pause">
											<Key type="Curve" time="0" value="255" inout="Linear"/>
											<Key type="Curve" time="0.5" value="0" inout="Linear"/>
											<Key type="Curve" time="1" value="255" inout="Linear"/>
											<Key type="Curve" time="1.5" value="0" inout="Linear"/>
											<Key type="Curve" time="2" value="255" inout="Linear"/>
