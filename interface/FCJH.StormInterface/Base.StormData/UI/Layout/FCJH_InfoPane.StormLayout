											<Unclipped val="true"/>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon0">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon1">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon2">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon3">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon4">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon5">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon6">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon7">
												<Alpha val="0"/>
												<AcceptsMouse val="false"/>
												<AcceptsMouseTooltip val="false"/>
											</Frame>
											<Frame type="Frame" name="QuestContainerContainerFrame">
												<Unclipped val="true"/>
												<Frame type="ParentCenteredFrame" name="BaseQuestCenterFrame">
													<Unclipped val="true"/>
													<Frame type="UnitStatusBaselineQuestIcon" name="BaseQuestIcon0">
														<Anchor side="Top" relative="$FCJH_QuestCell9" pos="Min" offset="0"/>
														<Anchor side="Left" relative="$FCJH_QuestCell9" pos="Min" offset="0"/>
														<Anchor side="Bottom" relative="$FCJH_QuestCell9" pos="Max" offset="0"/>
														<Anchor side="Right" relative="$FCJH_QuestCell9" pos="Max" offset="0"/>
														<Unclipped val="true"/>
														<RenderPriority val="#RenderPriorityLevel_3"/>
														<Frame type="Image" name="IconBackgroundImage"><Alpha val="0"/></Frame>
														<!-- the border Blizzard's progress ring fills, on heroes with a quest only (user,
														     2026-10-19: without it Murky's fill was a loose bar); none for the rest -->
														<Frame type="Image" name="IconBorderImage"><Alpha val="0"/></Frame>
														<StateGroup name="QuestState">
															<State name="QuestSelected"/>
															<State name="QuestAvailable">
																<Action type="SetProperty" frame="$this/IconImage" texture="@UI/Storm_UI_InGame_Leader_Talent_Unselected"/>
															</State>
															<State name="QuestNotAvailable">
																<Action type="SetProperty" frame="$this/IconImage" visible="false"/>
															</State>
														</StateGroup>
														<StateGroup name="FCJH_QuestBorder">
															<DefaultState val="FCJH_NoQuest"/>
															<State name="FCJH_InProgress">
																<When type="Property" frame="$this" QuestProgress="QuestInProgress"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_Untracked">
																<When type="Property" frame="$this" QuestProgress="ProgressUntracked"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_Finished">
																<When type="Property" frame="$this" QuestProgress="FinishedQuest"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_FinishedUnlimited">
																<When type="Property" frame="$this" QuestProgress="FinishedUnlimitedQuest"/>
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="255"/>
															</State>
															<State name="FCJH_NoQuest">
																<Action type="SetProperty" frame="$this/IconBorderImage" alpha="0"/>
															</State>
														</StateGroup>
													</Frame>
													<Frame type="UnitStatusBaselineQuestIcon" name="BaseQuestIcon1">
														<Alpha val="0"/>
														<AcceptsMouse val="false"/>
														<AcceptsMouseTooltip val="false"/>
													</Frame>
												</Frame>
											</Frame>
										</Frame>
									</Frame>
								</Frame>
							</Frame>
						</Frame>
					</Frame>
				</Frame>
			</Frame>
			<!-- Chrome: the title, over the rows, letting the mouse through to the tooltips (the
			     title band and frame are the skin's, under the rows). -->
			<Frame type="Frame" name="FCJH_InfoPaneChrome">
				<Anchor side="Top" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_T"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_L"/>
				<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_B"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_R"/>
				<RenderPriority val="600"/>
				<AcceptsMouse val="false"/>
				<Frame type="Label" name="FCJH_Title">
					<Anchor side="Top"    relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Left"   relative="$parent" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_TITLE_H"/>
					<Anchor side="Right"  relative="$parent" pos="Max" offset="0"/>
					<Style val="ObsBar_MatchTimer"/>
					<Text val="TALENTS"/>
					<RenderPriority val="610"/>
					<AcceptsMouse val="false"/>
				</Frame>
			</Frame>
			<!-- close: Blizzard's close tab in the corner (tools/gen.py close_button) -->
			<Frame type="Button" name="FCJH_Close" template="StandardTemplates/SmallPanelCloseButtonTemplate">
				<Anchor side="Top"   relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_CLOSE_T"/>
				<Anchor side="Right" relative="$parent" pos="Min" offset="#FCJH_INFO_PANE_CLOSE_R"/>
				<Width val="#FCJH_INFO_PANE_CLOSE_W"/>
				<Height val="#FCJH_INFO_PANE_CLOSE_H"/>
				<RenderPriority val="650"/>
				<AcceptsMouse val="true"/>
				<Animation name="FCJH_Close">
					<Event event="OnClick" action="Reset,Play"/>
					<Controller type="Visibility" end="Stop" frame="$parent/$parent/FCJH_Pane_TalentsToggle">
						<Key type="Bool" time="0" value="false"/>
					</Controller>
				</Animation>
			</Frame>
		</Frame>
	</Frame>
</Desc>
