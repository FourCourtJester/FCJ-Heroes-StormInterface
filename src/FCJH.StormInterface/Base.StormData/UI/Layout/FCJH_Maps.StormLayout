							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Right"  relative="$GameUI" pos="Mid" offset="#FCJH_MINIMAP_PANEL_R"/>
							<Action type="SetAnchor" frame="$GameUI/UIContainer/ConsoleUIContainer/MinimapPanel" side="Bottom" relative="$GameUI" pos="Max" offset="#FCJH_MINIMAP_BOTTOM_HAUNTED_MINES"/>
						</State>
						<State name="Default"/>
					</StateGroup>
				</Frame>
				<Frame type="Frame" name="MapMechanicPanel">
					<Frame type="Frame" name="BlackheartsBayPanel">
