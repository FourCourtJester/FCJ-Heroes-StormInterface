<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- PROBE (dev only): heroic token on each hero plate (2026-09-27).

	     Ahli's recipe (AhliObs _TopPanel.StormLayout): everything comes from Blizzard's own
	     talent row, which the engine fills for observers - the same stock rows our talent
	     pop-ups already read (TalentsOverview/TalentOverview, PlayerFrame0-9):
	       - TalentTreeIcon4 is the heroic tier: its TalentTierState says TierAvailable (level
	         10, not picked yet) or TierSelected (picked); its IconImage is the heroic's icon
	       - UnitStatusAbil is Blizzard's heroic ability element for that row (AbilityLink bound
	         to the hero's HeroicAbilLink); its AbilIcon/CooldownLabel shows only on cooldown,
	         with the seconds left
	     The token: a parallelogram in the plate's corner opposite the fountain (tools/gen.py
	     HeroCell.HEROIC), leaning with the plate. States: nothing / "?" / the icon / the icon
	     dimmed with the cooldown on it. Keyed to the heroic TIER, not to a level: Chromie's
	     heroic tier comes at level 8 and needs nothing special. Not handled yet - Ahli
	     special-cases both: Tracer (heroic from level 1, charge-based), Varian (heroic picked
	     at level 4, tier 2). Deathwing needs nothing (no Cataclysm before 10; user, 2026-09-27).
	     Round 2 (2026-09-29): "?" and the icon showed in game; the cooldown never did. It now
	     comes from our own ability icon inside each plate's HeroStatus (bound to that hero,
	     Ahli's way), given the heroic's link from the stock row.
	     Written by a one-off script (10 copies); edit by regenerating.
	     Look for: "?" on a plate from its heroic tier (10; Chromie 8) until the pick; then the icon; after a cast, a dark
	     overlay with seconds counting down; nothing before that tier. -->
	<Frame type="GameUI" name="GameUI" file="GameUI">
		<Frame type="Frame" name="FCJH_HeroicTokens">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<!-- PlayerFrame0 -> its plate -->
			<Frame type="Frame" name="FCJH_Heroic0">
				<Anchor side="Top" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="#FCJH_HERO_BLUE_HEROIC_T"/>
				<Anchor side="Left" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="#FCJH_HERO_BLUE_HEROIC_L"/>
				<Anchor side="Bottom" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="#FCJH_HERO_BLUE_HEROIC_B"/>
				<Anchor side="Right" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" pos="Min" offset="#FCJH_HERO_BLUE_HEROIC_R"/>
				<RenderPriority val="560"/>
				<AcceptsMouse val="false"/>
				<Frame type="Image" name="FCJH_Back">
					<Anchor relative="$parent"/>
					<Texture val="#FCJH_TOKEN_BACK_BLUE"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Label" name="FCJH_Mark">
					<Anchor relative="$parent"/>
					<Text val="?"/>
					<Style val="FCJH_HeroicMark"/>
					<Options val="NoWrapping | ScaleToPreventTruncation"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_Icon">
					<Anchor relative="$parent"/>
					<Texture val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4/IconImage/@Texture}"/>
					<AlphaMaskTexture val="#FCJH_TOKEN_MASK_BLUE"/>
					<TextureCoords top="0.13" left="0.0" bottom="0.87" right="1.0"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="FCJH_Dim">
					<Anchor relative="$parent"/>
					<Texture val="#FCJH_TOKEN_DIM_BLUE"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Label" name="FCJH_Cooldown">
					<Anchor relative="$parent"/>
					<Text val="{$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1/HeroStatus/FCJH_HeroicAbil/AbilIcon/CooldownLabel/@Text}"/>
					<Style val="FCJH_HeroicCooldown"/>
					<Options val="NoWrapping | ScaleToPreventTruncation"/>
					<Alpha val="0"/>
					<Unclipped val="true"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<!-- the heroic tier: nothing, "?" (available, not picked), or its icon (picked) -->
				<StateGroup name="FCJH_Tier">
					<DefaultState val="None"/>
					<State name="Picked">
						<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4" TalentTierState="TierSelected"/>
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="255"/>
					</State>
					<State name="Available">
						<When type="AnimationState" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/TalentsOverview/TalentOverview/HeroTalentsPanelContainer/PlayerFrame0/TalentsContainerFrame/SelectionUnitStatusPanel/UnitStatusFrame0/HeroSelectedTalentTreeFrame/TalentTreeIcon4" TalentTierState="TierAvailable"/>
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="0"/>
					</State>
					<State name="None">
						<Action type="SetProperty" frame="$this/FCJH_Back" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Mark" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Icon" Alpha="0"/>
					</State>
				</StateGroup>
				<!-- cooldown: while Blizzard's cooldown label for this heroic is showing -->
				<StateGroup name="FCJH_Cooldown">
					<DefaultState val="Ready"/>
					<State name="OnCooldown">
						<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1/HeroStatus/FCJH_HeroicAbil/AbilIcon/CooldownLabel" Visible="true"/>
						<Action type="SetProperty" frame="$this/FCJH_Dim" Alpha="255"/>
						<Action type="SetProperty" frame="$this/FCJH_Cooldown" Alpha="255"/>
					</State>
					<State name="Ready">
						<Action type="SetProperty" frame="$this/FCJH_Dim" Alpha="0"/>
						<Action type="SetProperty" frame="$this/FCJH_Cooldown" Alpha="0"/>
					</State>
				</StateGroup>
			</Frame>
			<!-- PlayerFrame1 -> its plate -->
			<Frame type="Frame" name="FCJH_Heroic1">
				<Anchor side="Top" relative="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2" pos="Min" offset="#FCJH_HERO_BLUE_HEROIC_T"/>
