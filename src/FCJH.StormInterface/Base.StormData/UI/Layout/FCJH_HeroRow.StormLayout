	<Frame type="GameUI" name="GameUI" file="GameUI">
		<!-- Fewer than five heroes a side: pack the rows toward the minimap (tools/gen.py
		     row_packer). UNTESTED: assumes the engine hides the cells it doesn't fill. -->
		<Frame type="Frame" name="FCJH_RowPacker">
			<Anchor relative="$parent"/>
			<AcceptsMouse val="false"/>
			<StateGroup name="FCJH_BlueCount">
				<DefaultState val="Heroes5"/>
				<State name="Heroes1">
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" Visible="true"/>
					<When type="Property" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview2" Visible="false"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" side="Left" relative="$GameUI" pos="Min" offset="660"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/Team1HeroOverview/HeroOverview1" side="Right" relative="$GameUI" pos="Min" offset="836"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/FCJH_BlueXPTrack" side="Left" relative="$GameUI" pos="Min" offset="655"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/FCJH_BlueXPTrack" side="Right" relative="$GameUI" pos="Min" offset="794"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1XPUnitStatusFrame" side="Left" relative="$GameUI" pos="Min" offset="655"/>
					<Action type="SetAnchor" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1XPUnitStatusFrame" side="Right" relative="$GameUI" pos="Min" offset="794"/>
					<Action type="SetProperty" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/FCJH_BlueXPTrack" Texture="_Assets\Textures\FCJH_Bar_xp_track_blue_n1_2d3acd6a.dds"/>
					<Action type="SetProperty" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1XPUnitStatusFrame/FCJH_XPMask" AlphaMaskTexture="_Assets\Textures\FCJH_Bar_xp_mask_blue_n1_5fb89822.dds"/>
					<Action type="SetProperty" frame="$GameUI/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel/ObserverTopPanel/Team1XPUnitStatusFrame/XPBar" AlphaMaskTexture="_Assets\Textures\FCJH_Bar_xp_mask_blue_n1_5fb89822.dds"/>
				</State>
