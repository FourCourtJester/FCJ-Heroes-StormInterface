				<Anchor side="Top" relative="$parent/$parent" pos="Min" offset="60"/>
				<Anchor side="Right" relative="$parent/$parent" pos="Min" offset="156"/>
				<Anchor side="Bottom" relative="$parent/$parent" pos="Min" offset="65"/>
