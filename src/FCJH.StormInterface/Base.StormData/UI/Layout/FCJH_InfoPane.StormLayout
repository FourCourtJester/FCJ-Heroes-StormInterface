							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon4">
								<Anchor side="Left"   relative="$parent/TalentTreeIcon3" pos="Max" offset="22"/>
								<Anchor side="Top"    relative="$parent/TalentTreeIcon1" pos="Min" offset="1"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon5">
								<Anchor side="Left"   relative="$parent/TalentTreeIcon4" pos="Max" offset="#BottomPanelHorizHeroicGapBlue"/>
								<Anchor side="Top"    relative="$parent/TalentTreeIcon1" pos="Min" offset="0"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
							</Frame>
							<Frame type="UnitStatusTalentIcon" name="TalentTreeIcon6">
								<Anchor side="Left"   relative="$parent/TalentTreeIcon5" pos="Max" offset="#BottomPanelHorizTalentGapBlue"/>
								<Anchor side="Top"    relative="$parent/TalentTreeIcon1" pos="Min" offset="0"/>
								<Anchor side="Right"  relative="$this" pos="Min" offset="0"/>
								<Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
							</Frame>
